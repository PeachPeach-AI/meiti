    timeout = TIMEOUT_PRODUCE
    loop = asyncio.get_event_loop()
    result = await loop.run_in_executor(None, run_agent_sync, message, timeout)
    try:
        await asyncio.to_thread(_adopt_workspace_outputs)
    except Exception:
        pass
    return {"response": result}


