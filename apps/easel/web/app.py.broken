class _GatewayHttpProc:
    """HTTP 鐩磋繛妯″紡涓嬬殑銆屼吉杩涚▼銆嶏細缁欎富寰幆 / 鍋滄閫昏緫鎻愪緵 poll/wait/kill 鍏煎闈€?""

    def __init__(self) -> None:
        self._done = False
        self._task = None

    def finish(self) -> None:
        self._done = True

    def poll(self):
        return 0 if self._done else None

    def terminate(self) -> None:
        self._done = True
        if self._task is not None:
            try:
                self._task.cancel()
            except Exception:  # noqa: BLE001
                pass

    def kill(self) -> None:
        self.terminate()

    def wait(self, timeout=None):  # 鍏煎 await asyncio.to_thread(proc.wait, ...)
        # 蹇呴』鐪熺殑绛夛細涓诲惊鐜嬁瀹冩潵鍐冲畾銆岃兘涓嶈兘鏀炬帀浼氳瘽鍙岄攣銆嶃€傛彁鍓嶈繑鍥炰細璁╀笅涓€杞湪
        # 涓婁竴杞彲鑳借繕鍦ㄥ啓鍚屼竴浠?transcript 鏃跺氨鍚姩 鈥斺€?姝ｆ槸鍙岄攣瑕侀槻鐨勫苟鍙戝啓銆?
        deadline = None if timeout is None else time.monotonic() + timeout
        while not self._done:
            if deadline is not None and time.monotonic() >= deadline:
                raise subprocess.TimeoutExpired("gateway-http-turn", timeout)
            time.sleep(0.05)
        return 0


_HTTP_READY_CACHE: dict = {"at": -1e9, "ok": False}
_HTTP_READY_TTL = 60.0          # 鎺㈤拡瑕佹墦涓€娆＄湡绔偣锛屽埆姣忚疆閮戒粯杩欎釜 RTT


def _gateway_http_ready(force: bool = False) -> bool:
    """鎺㈡祴 gateway 鐨?/v1/chat/completions 鍒板簳鎸傛病鎸備笂銆?

    **涓嶈兘鎺?/v1/models**锛氶偅涓矾寰勪細琚?gateway 鎺у埗鍙?SPA 鐨?catch-all 鎺ヨ蛋锛岀鐐规病寮€涔熺収鏍?
    杩斿洖 200锛坆ody 鏄?OpenClaw Control 鐨?HTML 棣栭〉锛夆€斺€?鎺簡绛変簬娌℃帰锛屽彧瑕佺綉鍏虫椿鐫€灏辨亽涓?True銆?
    杩欓噷鐩存帴鎵撶湡绔偣锛歰penclaw 瑕佹眰 gateway.http.endpoints.chatCompletions.enabled === true
    鎵嶆寕杩欐潯璺敱锛堥粯璁?false锛夛紝娌″紑灏辨槸 404锛涘紑浜嗗垯鍥犱负 body 缂?messages 杩斿洖 400銆傜敤 400 褰?
    "绔偣鍦?鐨勮瘉鎹紝鏃㈣蛋瀹屾暣鏉¤矾鐢卞張涓嶆秷鑰椾竴娆℃ā鍨嬭皟鐢ㄣ€?
    """
    now = time.monotonic()
    if not force and now - _HTTP_READY_CACHE["at"] < _HTTP_READY_TTL:
        return bool(_HTTP_READY_CACHE["ok"])
    ok = False
    try:
        import httpx  # noqa: F401  HTTP 璺緞鍏ㄩ潬瀹冨仛 SSE锛涙病瑁呭氨褰撶鐐逛笉鍙敤锛屽洖閫€ CLI
        rq = urllib.request.Request(
            "http://127.0.0.1:18789/v1/chat/completions", data=b"{}",
            headers={"Content-Type": "application/json"}, method="POST")
        try:
            with urllib.request.urlopen(rq, timeout=3):
                ok = False       # 绌?body 杩樼粰 200 璇存槑杩欎笉鏄垜浠鐨勭鐐癸紝涓嶆暍鐢?
        except urllib.error.HTTPError as e:
            ok = e.code == 400   # 400 Missing user message 鈬?绔偣鍦紱404 鈬?娌″紑
    except Exception:  # noqa: BLE001
        ok = False
    _HTTP_READY_CACHE.update(at=now, ok=ok)
    return ok


def _heal_openclaw_session(sk: str) -> None:
    """姣忚疆 spawn openclaw 鍓嶏紝娓呮礂璇ヤ細璇濆巻鍙查噷鐨勬棤绛惧悕 thinking 鍧?+ 绌烘秷鎭紙鑷剤闃插洖鏀惧け鏁堬級銆?

    best-effort锛氫换浣曞紓甯搁兘涓嶉樆鏂璇濓紙娓呮礂澶辫触澶т笉浜嗛€€鍥炲師鏍凤紝浠嶅彲 /new锛夈€?
    """
    try:
        import session_heal  # scripts/session_heal.py锛堝凡鍔犲叆 sys.path锛?
        p = OPENCLAW_SESSIONS_DIR / f"{_openclaw_session_id(sk)}.jsonl"
        if p.is_file():
            st = session_heal.sanitize_history_file(p)
            if st.get("changed"):
                print(f"[session-heal] {p.name}: -{st['thinking_removed']} thinking / "
                      f"-{st['msgs_dropped']} empty", file=sys.stderr, flush=True)
    except Exception as e:
        print(f"[session-heal] 璺宠繃锛坽e}锛?, file=sys.stderr, flush=True)


