# 榛樿 idleHours:24锛夊悗璇ョ粦瀹氳繃鏈燂紝涓嬩竴鏉℃秷鎭細鏂拌捣涓€涓┖ transcript 鈫?鍘嗗彶鍏ㄤ涪锛堢敤鎴枫€屽叧椤典袱澶?
# 鍚庡啀闂氨蹇樹簡銆嶏級銆傚悓涓€澶╁唴娌′簨锛岄殧澶╁氨鏂€傝В娉曪細鎴戜滑鑷繁閽夋 --session-id锛堝鍚屼竴 web 浼氳瘽鎭掑畾锛夛紝
# 璁?OpenClaw 姣忚疆閮界画鍚屼竴涓?transcript 鏂囦欢锛岀粫寮€ key鈫掔粦瀹氱殑杩囨湡/杞崲閫昏緫銆?
_EASEL_SESSION_NS = uuid.UUID("6ba7b810-9dad-11d1-80b4-00c04fd430c8")  # 鍥哄畾鍛藉悕绌洪棿锛坲uid5 纭畾鎬э級


def _openclaw_session_id(sk: str) -> str:
    """web sessionId 鈫?绋冲畾鐨?OpenClaw session-id锛坱ranscript锛夈€傚悓 sk 姘歌繙鍚?id锛屾棤闇€钀界洏鏄犲皠銆?""
    return str(uuid.uuid5(_EASEL_SESSION_NS, sk))


def _session_flock_path(sk: str) -> Path:
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", sk)[:120]
    return sessions_dir() / f"{safe}.lock"


def _transport_pin_file(sk: str) -> Path:
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", sk)[:120]
    return sessions_dir() / f"{safe}.transport"


def _resolve_transport(sk: str) -> str:
    """鍐冲畾杩欎竴杞蛋鍝潯浼犺緭灞傦紝骞朵繚璇佸悓涓€浼氳瘽**姘镐笉涓€旀崲杈?*銆?

    鎹㈣竟鐨勪唬浠锋槸闈欓粯涓㈠厜涓婁笅鏂囷紝涓嶆槸鎱竴鐐癸細CLI 璺緞鐢?`--session-id`锛坲uid5(sk)锛夋妸 transcript
    閽夋锛岃€?/v1/chat/completions **鍘嬫牴涓嶈 x-openclaw-session-id** 鈥斺€?openclaw 2026.6.11 鍏ㄩ噺
    瀹炴祴锛氳 header 鍙湁 MCP 绔偣鍜屽涓婃父渚涘簲鍟嗙殑鍑虹珯璇锋眰浼氱敤锛孫penAI 鍏煎绔偣鍙
    x-openclaw-session-key锛宼ranscript 鏂囦欢鍚嶇敱缃戝叧鑷繁鎸戙€備簬鏄悓涓€涓?web 浼氳瘽鍦ㄤ袱鏉¤矾寰勪笅钀藉湪
    涓や唤涓嶅悓鐨?jsonl 涓娿€傚疄娴嬫嬁 CLI 鍘荤画涓€涓凡鏈変袱杞?HTTP 鍘嗗彶鐨勪細璇濓紝agent 鍥炵瓟"鏃犲巻鍙?銆?

    鎵€浠ュ垽瀹氶『搴忥紙閮戒笉渚濊禆鍐呭瓨鎬侊紝web 閲嶅惎鍚庝緷鐒舵垚绔嬶級锛?
      1) uuid5 閭ｄ唤 transcript 宸茶惤鐩?鈫?杩欎細璇濇槸 CLI 璧风殑锛岀户缁?cli锛?
      2) 鏈?http 閽夊瓙鏂囦欢 鈫?缁х画 http锛?
      3) 涓よ€呴兘娌℃湁 鈫?鏂颁細璇濓紝鎸夋€诲紑鍏?+ 鐪熸帰閽堝喅瀹氥€?
    """
    if (OPENCLAW_SESSIONS_DIR / f"{_openclaw_session_id(_usk(sk))}.jsonl").is_file():
        return "cli"
    try:
        if _transport_pin_file(sk).read_text(encoding="utf-8").strip() == "http":
            return "http"
    except OSError:
        pass
    return "http" if (CHAT_TRANSPORT == "http" and _gateway_http_ready()) else "cli"


def _pin_transport(sk: str, kind: str) -> None:
    """鎶婁細璇濋拤鍦ㄦ煇鏉′紶杈撳眰涓娿€傚彧闇€閽?http 鈥斺€?cli 渚х敱 uuid5 transcript 鏂囦欢鑷瘉銆?""
    if kind != "http":
        return
    try:
        sessions_dir().mkdir(parents=True, exist_ok=True)
        _transport_pin_file(sk).write_text("http", encoding="utf-8")
    except OSError:
        pass


class _CrossProcLock:
    """璺ㄨ繘绋嬩細璇濋攣锛坒cntl.flock锛夛細鍚屼竴浼氳瘽鍚屼竴鏃跺埢鍙厑璁镐竴涓?openclaw 杩涚▼鍦ㄨ窇銆?

    鐜版湁 _session_lock锛坅syncio锛夊彧鍦ㄥ崟涓?web 杩涚▼鍐呬覆琛岋紱鎸′笉浣忎袱涓祻瑙堝櫒鏍囩/甯搁┗ gateway/
    cron 骞跺彂纰板悓涓€浼氳瘽 鈫?openclaw 鎶?EmbeddedAttemptSessionTakeoverError锛坮c=1锛岀瓟涓€鍗婂氨鍋滐級銆?
    flock 鍦ㄦ寔鏈夎繘绋嬮€€鍑烘椂鑷姩閲婃斁锛屾棤 stale 姝婚攣銆傝繑鍥?True=鎷垮埌閿侊紝False=瓒呮椂鏈嬁鍒般€?
    """

    def __init__(self, sk: str):
        self._path = _session_flock_path(sk)
        self._fh = None
        self.acquired = False

    def acquire(self, timeout: float = 300.0, poll: float = 0.5) -> bool:
        try:
            sessions_dir().mkdir(parents=True, exist_ok=True)
            self._fh = open(self._path, "a+b")
            if os.name == "nt":
                self._fh.seek(0, os.SEEK_END)
                if self._fh.tell() == 0:
                    self._fh.write(b"0")
                    self._fh.flush()
        except OSError:
            return False  # 鎷夸笉鍒版枃浠跺彞鏌勫氨涓嶅己姹傦紙閫€鍖栦负浠?asyncio 閿侊級
        deadline = time.time() + timeout
        while True:
            try:
                if os.name == "nt":
                    self._fh.seek(0)
                    msvcrt.locking(self._fh.fileno(), msvcrt.LK_NBLCK, 1)
                else:
                    fcntl.flock(self._fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                self.acquired = True
                return True
            except OSError:
                if time.time() >= deadline:
                    return False
                time.sleep(poll)

    def release(self) -> None:
        if self._fh is not None:
            try:
                if self.acquired:
                    if os.name == "nt":
                        self._fh.seek(0)
                        msvcrt.locking(self._fh.fileno(), msvcrt.LK_UNLCK, 1)
                    else:
                        fcntl.flock(self._fh.fileno(), fcntl.LOCK_UN)
            except OSError:
                pass
            try:
                self._fh.close()
            except OSError:
                pass
            self._fh = None
            self.acquired = False


def _turn_file(sk: str) -> Path:
    """姣忎細璇濇渶杩戜竴杞粨鏋滅殑钀界洏璺緞锛坰k 鍋氭枃浠跺悕瀹夊叏鍖栵級銆?""
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", sk)[:120]
    return sessions_dir() / f"{safe}.json"


def _job_event_file(turn_id: str) -> Path:
    """Per-turn append-only event log used to resume SSE without restarting the agent."""
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", turn_id)[:160]
    return sessions_dir() / "jobs" / f"{safe}.jsonl"


def _read_job_events(turn_id: str, after: int = 0) -> list[dict]:
    path = _job_event_file(turn_id)
    if not path.is_file():
        return []
    events = []
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            event = json.loads(line)
            if int(event.get("id", 0)) > after:
                events.append(event)
    except (OSError, ValueError, json.JSONDecodeError):
        return []
    return events


def _raw_event_for_run(line: str, expected_run_id: str | None) -> dict | None:
    """Parse one OpenClaw raw event and reject events from other runs.

    The gateway multiplexes every run into one shared raw-stream file, and its
    events carry `runId` (not `sessionId`). A turn latches onto its own runId 鈥?
    the first event seen after the turn starts 鈥?and must ignore any event with
    a different runId. `expected_run_id=None` means not-yet-latched 鈫?accept, so
    the caller can latch from `event['runId']`.
    """
    line = line.strip()
    if not line:
        return None
    try:
        event = json.loads(line)
    except (TypeError, ValueError, json.JSONDecodeError):
        return None
    if not isinstance(event, dict):
        return None
    if expected_run_id is not None:
        rid = event.get("runId")
        if rid is not None and rid != expected_run_id:
            return None
    return event


def _save_turn(sk: str, status: str, text: str, extra: dict | None = None) -> None:
    """鎸佷箙鍖栨湰杞粨鏋滐紙running/done锛夛紝渚?SSE 杩炴帴涓柇鍚庡墠绔敤 /api/chat/last 鍙栧洖銆?

    鍚庣璺戝畬鏁磋疆涓嶄緷璧栧鎴风杩炴帴鈥斺€旈暱浠诲姟鏃?webide 浠ｇ悊浼氭帎鏂?SSE锛屼絾 openclaw 浠嶈窇鍒板簳锛?
    缁撴灉鍐欒繖閲岋紝鍓嶇鏂嚎鍚庤疆璇㈠嵆鍙嬁鍒板畬鏁村洖绛旓紙鍚﹀垯"杩愯瀹屼篃涓嶈涓€澹?锛夈€?
    """
    try:
        sessions_dir().mkdir(parents=True, exist_ok=True)
        payload = {"status": status, "text": text, "at": time.strftime("%Y-%m-%dT%H:%M:%S")}
        if extra:
            payload.update(extra)
        tmp = _turn_file(sk).with_suffix(".tmp")
        tmp.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
        os.replace(tmp, _turn_file(sk))
    except Exception:
        pass


# 鍚庡彴 supervisor 浠诲姟闆嗗悎锛氭寔鏈夊己寮曠敤闃茶 GC锛涙瘡涓璇濇祦鐨?openclaw run 璺戝湪杩欓噷锛?
# 涓庡鎴风 SSE 杩炴帴瑙ｈ€︼紙鏂嚎涓嶆潃 run锛夈€?
_BG_TASKS: set = set()

# 姝ｅ湪璺戠殑瀵硅瘽 openclaw 杩涚▼锛坰k鈫抪roc锛夛紝渚涚敤鎴?*鏄惧紡銆屽仠姝€?*缁堟锛涙柇绾?*涓?*缁忔璺緞锛堟柇绾夸笉鏉€锛夈€?
_RUNNING_CHAT: dict = {}
# 琚敤鎴锋樉寮忓仠姝㈢殑浼氳瘽 key锛歴upervisor 鎹鎶婃湰杞綋浣滄甯搞€屽凡鍋滄銆嶆敹灏撅紙涓嶆姤銆岃涓柇銆嶃€侀噴鏀句細璇濋攣锛夈€?
_STOPPED_CHAT: set = set()


@app.get("/api/chat/last/{session_id}")
async def api_chat_last(session_id: str, turn_id: str | None = None):
    """鍙栨煇浼氳瘽鏈€杩戜竴杞殑瀹屾暣缁撴灉锛圫SE 鏂嚎鍚庡墠绔嵁姝ゅ彇鍥烇紝閬垮厤涓㈢粨鏋滐級銆?""
    f = _turn_file(f"web:{session_id}")
    if not f.is_file():
        return {"status": "none", "text": ""}
    try:
        payload = json.loads(f.read_text(encoding="utf-8"))
        if turn_id and payload.get("turn_id") != turn_id:
            return {"status": "stale", "text": "", "turn_id": payload.get("turn_id")}
        return payload
    except Exception:
        return {"status": "none", "text": ""}


@app.get("/api/chat/jobs/{turn_id}/stream")
async def api_chat_job_stream(turn_id: str, after: int = 0):
    """Replay missed events, then tail this turn until its terminal event arrives."""
    # A stale browser-side pendingTurnId must fail promptly instead of receiving
    # heartbeats forever. The frontend can then recover from the final snapshot.
    if not _job_event_file(turn_id).is_file():
        raise HTTPException(404, "瀵硅瘽浠诲姟璁板綍涓嶅瓨鍦ㄦ垨宸插け鏁?)

    async def events():
        cursor = max(0, after)
        idle_since = time.monotonic()
        while True:
            batch = _read_job_events(turn_id, cursor)
            if batch:
                idle_since = time.monotonic()
                for event in batch:
                    cursor = int(event["id"])
                    yield {
                        "id": str(cursor),
                        "event": event["event"],
                        "data": json.dumps(event.get("data"), ensure_ascii=False),
                    }
                    if event["event"] in ("done", "error"):
                        return
            else:
                # Keep proxy connections active; reconnecting remains safe if it still drops.
                if time.monotonic() - idle_since >= 15:
                    yield {"event": "ping", "data": "{}"}
                    idle_since = time.monotonic()
                await asyncio.sleep(0.25)

    return EventSourceResponse(events(), headers={
        "Cache-Control": "no-cache, no-transform",
        "X-Accel-Buffering": "no",
        "Content-Encoding": "identity",
    })


@app.post("/api/chat/stream")
async def api_chat_stream(req: ChatRequest):
    if not CURRENT_UID.get():
        raise HTTPException(401, '请先登录')
    """SSE 鐪熸祦寮忓璇濄€?

    `openclaw agent` CLI 浼氭妸鏁存妯″瀷杈撳嚭缂撳啿鍒扮粨鏉熸墠鎵撳嵃锛坰tdout 鏃犲閲忥級銆傜湡姝ｈ窇妯″瀷鐨勬槸
    甯搁┗ gateway锛屽畠鎸夎嚜宸辩殑 OPENCLAW_RAW_STREAM/OPENCLAW_RAW_STREAM_PATH 鎶娿€屾ā鍨嬪師濮嬫祦銆嶉€?
    token 鍐欏埌**鍗曚釜鍏变韩 jsonl**锛圫HARED_RAW_STREAM锛岃 scripts/gateway.sh锛夈€傚悗绔湪鏈疆寮€濮嬫椂
    璁颁笅璇ユ枃浠跺熬鍋忕Щ銆佸疄鏃?tail 涔嬪悗杩藉姞鐨勮锛岀敤 runId 闂╅攣闅旂鏈疆锛屾妸 assistant_text_stream 鐨?
    token delta 杞垚 SSE `token`銆乼hinking delta 杞垚 `thinking`銆俿tdout 浠呯暀浣滈敊璇?鍏滃簳銆?
    """
    # 姣忚疆鏈熬杩藉姞銆屽厛鏌ユ妧鑳藉簱銆嶆彁閱掞紝鎶楅暱瀵硅瘽鎸囦护琛板噺锛堝鐢ㄦ埛涓嶅彲瑙侊級
    message = _chat_message(req)

    # supervisor锛堣窇 openclaw run锛変笌 forward锛堣浆鍙?SSE 缁欐祻瑙堝櫒锛変箣闂寸殑浜嬩欢閫氶亾銆?
    # 鍏抽敭锛歳un 璺戝湪鐙珛鍚庡彴浠诲姟閲岋紝瀹㈡埛绔柇寮€鍙粨鏉?forward锛屼笉鍙栨秷 supervisor 鈫?
    # openclaw 鐓у父璺戝埌搴曘€佺粨鏋滆惤鐩橈紝鍓嶇鏂嚎鍚?/api/chat/last 鍙栧洖銆?
    loop = asyncio.get_event_loop()
    client_q: asyncio.Queue = asyncio.Queue()
    CLIENT_DONE = object()

    async def supervisor():
        sk = req.sessionId or f"web-{int(time.time() * 1000)}"
        ock = _usk(sk)
        pk = f"web:{sk}"                 # 钀界洏 key锛堜笌 /api/chat/last 涓€鑷达級
        turn_id = req.turnId or uuid.uuid4().hex
        event_seq = 0
        full_text: list[str] = []        # 绱Н瀹屾暣鍥炵瓟锛屼緵鏂嚎鍙栧洖
        timed_out = False                # 鍙湁鐪熉疯秴鏃舵墠 terminate 杩涚▼锛涙柇绾跨粷涓嶆潃

        # Claim this turn before waiting for locks, so recovery cannot return the previous turn.
        _save_turn(pk, "running", "", {"turn_id": turn_id})

        event_path = _job_event_file(turn_id)
        try:
            event_path.parent.mkdir(parents=True, exist_ok=True)
            event_path.write_text("", encoding="utf-8")
        except OSError:
            pass

        def to_client(kind, text=None, **extra):
            nonlocal event_seq
            event_seq += 1
            data = ({"sessionKey": extra.get("sessionKey")} if kind == "done" else text)
            event = {"id": event_seq, "event": kind, "data": data}
            try:
                with event_path.open("a", encoding="utf-8") as ef:
                    ef.write(json.dumps(event, ensure_ascii=False) + "\n")
                    ef.flush()
            except OSError:
                pass
            client_q.put_nowait({"t": kind, "text": text, "id": event_seq, **extra})

        # 绉掔骇鍙嶉锛氬彂鍑哄嵆浜€屽凡鏀跺埌銆嶏紝涓嶇瓑 agent 鍐峰惎鍔紙棣栦釜 SSE 浜嬩欢锛岄殢娴佸洖鏀惧繀杈撅級
        to_client("activity", "鈴?宸叉敹鍒帮紝姝ｅ湪鍞ら啋 agent鈥?)

        async def _run_gateway_turn(hproc):
            """HTTP 鐩磋繛甯搁┗缃戝叧璺戜竴杞紙OpenAI 鍏煎绔偣 /v1/chat/completions锛屽師鐢?SSE锛夈€?

            涓?CLI 璺緞鐨勫樊寮傦細agent 鍦ㄥ父椹?gateway 杩涚▼閲岀洿鎺ヨ窇锛屾棤姣忚疆杩涚▼鍐峰惎鍔紱
            姝ｆ枃 token 缁?SSE 鐩存帴杩?q锛堜笌 CLI 璺緞鍏变韩鍚屼竴娑堣垂鍑哄彛锛夛紱
            鏀跺熬鐢变富寰幆缁熶竴璐熻矗锛坧roc.poll() 鍏煎闈級銆?
            """
            body = {
                "model": "openclaw/default",
                "stream": True,
                "messages": [{"role": "user", "content": message}],
            }
            # session-id 蹇呴』璺?CLI 璺緞閽夋鍚屼竴涓紙瑙?_openclaw_session_id锛夛細鍙甫 session-key
            # 鐨勮瘽缃戝叧浼氳嚜宸卞彟璧蜂竴涓?transcript 鈥斺€?璺ㄥぉ绌洪棽鍚庝涪鍘嗗彶锛屼笖涓囦竴鏈疆鍥為€€ CLI锛?
            # 涓ゆ潯璺緞浼氬啓杩涗笉鍚岀殑浼氳瘽鏂囦欢锛屽璇濆巻鍙茬洿鎺ュ妶鍙夈€?
            headers = {"x-openclaw-session-key": f"agent:main:{ock}",
                       "x-openclaw-session-id": _openclaw_session_id(ock)}
            tool_noted = False
            saw_done = False
            got_text = False
            try:
                import httpx as _httpx
                timeout = _httpx.Timeout(TIMEOUT_CHAT + 60, connect=10)
                async with _httpx.AsyncClient(timeout=timeout) as client:
                    async with client.stream(
                            "POST", "http://127.0.0.1:18789/v1/chat/completions",
                            json=body, headers=headers) as resp:
                        if resp.status_code != 200:
                            raw = (await resp.aread())[:200].decode("utf-8", "replace")
                            to_client("error", f"鉂?瀵硅瘽澶辫触锛圚TTP {resp.status_code}锛夛細{raw[:160]}")
                            return
                        async for line in resp.aiter_lines():
                            if not line.startswith("data:"):
                                continue
                            payload = line[5:].lstrip()   # SSE 鍏佽 `data:{鈥`锛堝啋鍙峰悗鏃犵┖鏍硷級
                            if payload == "[DONE]":
                                saw_done = True
                                break
                            try:
                                d = json.loads(payload)
                            except ValueError:
                                continue
                            if isinstance(d.get("error"), dict):   # 200 閲屽す閿欒瀵硅薄锛氫笉鑳藉綋姝ｅ父娴佸悶鎺?
                                to_client("error", f"鉂?缃戝叧杩斿洖閿欒锛歿str(d['error'])[:160]}")
                                return
                            delta = (d.get("choices") or [{}])[0].get("delta") or {}
                            # 鎬濊€冩祦鐨勪袱涓彲鑳芥潵婧愶紝鍏堝埌鍏堝緱锛坄sse_thinking` 闂╅攣锛岄槻涓よ矾閮芥潵鏃堕噸澶嶏級锛?
                            # 鈶?杩欓噷鐨?reasoning 澧為噺 鈥斺€?openclaw 2026.6.11 鐨?chat/completions
                            #    瀹炵幇閲?reasoning/thinking 鍑虹幇 0 娆★紝**涓嶄細**缁欙紱鐣欑潃鏄粰鍒殑缃戝叧/
                            #    浠ュ悗鐨勭増鏈敤銆傗憽 甯搁┗ gateway 鍐欑殑鍏变韩 raw 娴侊紙瑙佷笅闈?_tail锛夛紝
                            #    瀹冩寜鑷繁鐨?env 鍐欙紝璺熻繖涓€杞槸璋佽Е鍙戠殑鏃犲叧锛屾墍浠?HTTP 妯″紡鐓ф牱鑳借鍒般€?
                            rc = delta.get("reasoning_content") or delta.get("reasoning")
                            if rc:
                                run_info["sse_thinking"] = True
                                run_info["thinking_chars"] += len(rc)
                                _emit("thinking", rc)
                            c = delta.get("content")
                            if c:
                                got_text = True
                                _emit("token", c)
                            if delta.get("tool_calls") and not tool_noted:
                                tool_noted = True
                                to_client("activity", "馃敡 姝ｅ湪鎵ц鎿嶄綔鈥?)
                # 娴佹甯哥粨鏉熷嵈鏃㈡病姝ｆ枃涔熸病 [DONE]锛氬鍗婃槸绔偣娌＄湡寮€鎴栦腑閫旀柇浜嗐€?
                # 涓嶆姤閿欑殑璇濊繖涓€杞細闈欓粯钀戒竴鏉＄┖鍥炵瓟锛岃繕浼氳 /api/chat/last 鍘熸牱鍙栧洖銆?
                if not got_text and not saw_done:
                    to_client("error", "鉂?缃戝叧娴佸紓甯哥粨鏉燂細娌℃湁鏀跺埌浠讳綍鍐呭锛堟鏌?"
                                       "gateway.http.endpoints.chatCompletions 鏄惁寮€鍚紝"
                                       "鎴栬 EASEL_CHAT_TRANSPORT=cli 鍥為€€锛?)
            except asyncio.CancelledError:
                raise
            except Exception as e:  # noqa: BLE001
                to_client("error", f"鉂?缃戝叧杩炴帴澶辫触锛歿str(e)[:140]}")
            finally:
                # 鍏堟妸 SENTINEL 鎺掕繘 q锛團IFO 淇濊瘉瀹冩帓鍦ㄦ湰杞墍鏈?token 涔嬪悗锛夛紝鍐嶆爣璁板畬鎴愶細
                # 涓诲惊鐜鍒板畠鏃讹紝鍓嶉潰鐨?token 蹇呯劧宸插叏閮ㄦ秷璐硅繃銆?
                q.put_nowait(SENTINEL)
                hproc.finish()

        _heal_openclaw_session(ock)       # 娓呮礂鍘嗗彶閲屾棤绛惧悕 thinking 鍧楋紝闃插洖鏀惧け鏁?
        # 鍘熷浜嬩欢娴佺敱甯搁┗ gateway 鍐欏埌鍏变韩鏂囦欢锛堣 SHARED_RAW_STREAM / scripts/gateway.sh锛夛紝
        # 涓嶆槸 agent 瀹㈡埛绔啓鐨勩€傛湰杞紑濮嬫椂璁颁笅鏂囦欢褰撳墠灏惧亸绉伙細鍙姝ゅ亸绉讳箣鍚庤拷鍔犵殑琛岋紝
        # 鍐嶇敤棣栦釜鏂颁簨浠剁殑 runId 闂╅攣鏈疆锛岄殧绂诲叾瀹冨苟鍙戜細璇濈殑浜嬩欢銆?
        try:
            raw_start_offset = SHARED_RAW_STREAM.stat().st_size
        except OSError:
            raw_start_offset = 0

        cmd = openclaw_base_cmd() + [
            "--profile", OPENCLAW_PROFILE, "agent", "--agent", "main",
            "--session-key", f"agent:main:{ock}", "--session-id", _openclaw_session_id(ock),
            "--thinking", THINKING_LEVEL,
            "--timeout", str(TIMEOUT_CHAT), "--message", message,
        ]
        env = _proxy_env()
        # 娉ㄦ剰锛氫笉瑕佸湪瀹㈡埛绔?env 涓婅 OPENCLAW_RAW_STREAM*鈥斺€擿agent` 瀹㈡埛绔笉鍐?raw 娴侊紝
        # 璁句簡涔熸病鐢紱raw 娴佸紑鍏冲湪 gateway 渚э紙scripts/gateway.sh锛夈€?
        # 鍛婅瘔 skill锛氭湰閮ㄧ讲鐨?ask_user 閫夐」鍗＄墖鏄惁鍙敤銆傚崱鐗囦緷璧?gateway 鐨?
        # question.* RPC锛堜粎 2026.9.x 鏈夛級锛?026.6.11 涓婃ˉ鎺ヤ笉鍙敤 鈫?skill 鏀圭敤
        # 銆屾枃瀛楅棶绛旇法杞瓑寰呫€嶆嬁鐭俊楠岃瘉鐮侊紝鑰屼笉鏄┖绛夊崱鐗囪秴鏃躲€?
        _cards_ok = question_bridge_supported is not None and question_bridge_supported()
        env["EASEL_ASKUSER_CARDS"] = "1" if _cards_ok else "0"

        # 浼氳瘽绾т覆琛岋細鍚屼竴浼氳瘽鑻ュ凡鏈夎姹傚湪璺戯紝鍏堟彁绀烘帓闃燂紝绛夊畠缁撴潫鍐嶅紑
        # 锛堝惁鍒欎袱涓?openclaw 杩涚▼骞跺彂鍐欏悓涓€ session 鏂囦欢 鈫?宕╂簝 rc=1 / 浼氳瘽涓插懗锛夈€?
        # 鍙屽眰閿侊細asyncio 閿佺鍚?web 杩涚▼鍐呭苟鍙戯紱flock 璺ㄨ繘绋嬮攣绠′袱涓爣绛?gateway/cron 鎾炲悓涓€浼氳瘽銆?
        lock = _session_lock(ock)
        xlock = _CrossProcLock(ock)
        if lock.locked():
            to_client("activity", "鈴?杩欎釜浼氳瘽涓婁竴鏉¤繕鍦ㄨ窇锛屾帓闃熺瓑瀹冪粨鏉熷啀寮€濮嬧€?)
        await lock.acquire()
        # flock 鍙兘闃诲锛堢瓑鍙︿竴杩涚▼/鏍囩璺戝畬锛夛紝鏀剧嚎绋嬫睜閬垮厤鍗′綇浜嬩欢寰幆
        got = await loop.run_in_executor(None, xlock.acquire, min(TIMEOUT_CHAT, 300))
        if not got:
            lock.release()
            _save_turn(pk, "done", "杩欎釜浼氳瘽姝ｅ湪鍙︿竴涓獥鍙ｈ繍琛岋紝璇风◢鍊欏啀璇曘€?, {
                "turn_id": turn_id, "clean_end": False, "stop_reason": "session_lock_timeout",
            })
            to_client("activity", "鈴?杩欎釜浼氳瘽姝ｅ湪鍙︿竴涓獥鍙ｈ繍琛岋紝璇风◢鍊欏啀璇?)
            to_client("done", sessionKey=sk)
            client_q.put_nowait(CLIENT_DONE)
            return

        # _resolve_transport 閲屾棦鏈?stat 鍙堟湁闃诲 urllib 鎺㈤拡锛堟渶澶?3s锛夛紝蹇呴』涓㈢嚎绋嬶細
        # 鐩存帴鍦ㄥ崗绋嬮噷璋冧細鎶婃暣涓簨浠跺惊鐜€斺€旇繛鍚屽叾瀹冧細璇濇鍦ㄦ帹鐨?SSE鈥斺€斾竴璧峰崱浣忋€?
        is_http = (await asyncio.to_thread(_resolve_transport, sk)) == "http"
        if is_http:
            # HTTP 鐩磋繛甯搁┗缃戝叧锛氭棤杩涚▼鍐峰惎鍔紙agent 鍦?gateway 杩涚▼閲岃窇锛?
            proc = _GatewayHttpProc()
        else:
            try:
                proc = subprocess.Popen(
                    cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                    cwd=str(_agent_cwd()), text=True, bufsize=1, env=env,
                )
            except BaseException:
                lock.release()
                xlock.release()
                _save_turn(pk, "done", "鉂?鍚姩澶辫触锛岃閲嶈瘯", {
                    "turn_id": turn_id, "clean_end": False, "stop_reason": "spawn_failed",
                })
                to_client("error", "鉂?鍚姩澶辫触锛岃閲嶈瘯")
                to_client("done", sessionKey=sk)
                client_q.put_nowait(CLIENT_DONE)
                return
        _RUNNING_CHAT[sk] = proc         # 娉ㄥ唽杩愯涓繘绋嬶紙HTTP 妯″紡涓轰吉杩涚▼锛夛紝渚?/api/chat/stop
        # 缁?gateway 鍚庡鎴风 stdout 娌℃湁 model-fetch 鏍囪锛堥偅鏄嫭绔嬭窇 agent 鎵嶆湁锛夛紝鍏堢珛鍒?
        # 缁欎竴涓€屾鍦ㄦ€濊€冦€嶆椿鍔ㄦ寚绀猴紝闅忓悗 token 浠庡叡浜?raw stream 娴佽繘鏉ユ帴绠℃樉绀恒€?
        to_client("activity", "馃 姝ｅ湪鎬濊€冣€?)

        q = asyncio.Queue()
        SENTINEL = object()
        stdout_lines = []
        run_info: dict = {"stop_reason": None, "last_ev": None, "saw_message_end": False,
                          "run_id": None,
                          "fetch_count": 0, "token_chars": 0, "thinking_chars": 0,
                          "delegated": False, "ignored_foreign_events": 0}

        def _drain_stdout():
            try:
                for line in proc.stdout:
                    stdout_lines.append(line)
                    c = re.sub(r"\x1b\[[0-9;]*m", "", line)
                    if "model-fetch] start" in c:
                        run_info["fetch_count"] += 1
                        fc = run_info["fetch_count"]
                        _emit("activity", "馃 姝ｅ湪鎬濊€冣€? if fc == 1 else f"馃敡 璋冪敤宸ュ叿鍚庣户缁帹鐞嗭紙绗?{fc} 姝ワ級鈥?)
                    elif "[agent]" in c and "delegat" in c.lower():
                        run_info["delegated"] = True
                        _emit("activity", "馃洜锔?鍒朵綔涓€?)
                    m = re.search(r"ended with stopReason=(\S+)", c)
                    if m:
                        run_info["stop_reason"] = m.group(1)
            except Exception:
                pass

        def _emit(kind: str, text: str):
            loop.call_soon_threadsafe(q.put_nowait, {"t": kind, "text": text})

        # 蹇呴』绛?q / run_info / _emit 閮藉氨浣嶅悗鍐嶈捣杩欎竴杞細_run_gateway_turn 闂寘寮曠敤瀹冧滑锛?
        # 鏃╀竴姝?create_task 灏卞彧鑳介潬銆屼腑闂存病鏈?await銆嶆潵渚ュ垢锛屾敼涓€琛屽悓姝ヤ唬鐮佸氨浼氬穿銆?
        if is_http:
            proc._task = loop.create_task(_run_gateway_turn(proc))

        # ---- ask_user 闂瓟棰樻ˉ鎺ワ細杞 gateway 鐨?pending question锛屾帹缁欏墠绔覆鏌?----
        # 鑳屾櫙锛歄penClaw 鐨?ask_user 娉ㄥ唽鍒?gateway 杩涚▼鍐咃紝Easel 鍓嶇涓嶆秷璐?question RPC 鈫?閫夐」涓嶅彲瑙併€?
        # 杩欓噷鍦?agent 杩愯鏈熼棿姣?2s 杞涓€娆★紝鎶婃柊鍑虹幇鐨?pending question 浠?SSE `question` 浜嬩欢鎺ㄩ€侊紝
        # 鍓嶇娓叉煋閫夐」鍗＄墖锛涚敤鎴风偣鍑诲悗缁?/api/chat/question/answer 璋?question.resolve 瀹屾垚鍥炵瓟銆?
        if GatewayClient is not None and not _QBRIDGE_DISABLED:
            def _question_poll():
                global _QBRIDGE_DISABLED
                if _QBRIDGE_DISABLED:
                    return
                # 鐗堟湰鑳藉姏闂細鏃х増鏈?OpenClaw锛?2026.9.x锛夋病鏈?question.* RPC锛岃繛閮戒笉杩炩€斺€?
                # 鍚﹀垯姣忚疆 connect 閮藉湪缃戝叧涓婅Е鍙戞柊鐨?scope-upgrade 閰嶅鐢宠銆傚彧鎻愮ず涓€娆★紝璧版枃瀛楅棶绛斻€?
                if question_bridge_supported is not None and not question_bridge_supported():
                    _QBRIDGE_DISABLED = True
                    _qbridge_warn_once(
                        "unsupported",
                        "[question-bridge] 褰撳墠 OpenClaw 鐗堟湰鏃?question RPC锛堥渶 2026.9.x+锛夛紝"
                        "宸茶烦杩?ask_user 閫夐」鍗＄墖妗ユ帴锛屾敼鐢ㄦ枃瀛楅棶绛斻€?)
                    return
                client = None
                pushed: set[str] = set()
                try:
                    client = GatewayClient()
                    client.connect()
                except Exception as e:
                    # connect 澶辫触锛堝 NOT_PAIRED/scope-upgrade锛屾垨缃戝叧涓嶅彲杈撅級锛氱啍鏂暣涓ˉ鎺ワ紝
                    # 涓嶅啀姣忚疆閲嶈瘯鈥斺€斿惁鍒欐瘡杞兘浼氬湪缃戝叧涓婂爢涓€涓柊鐨勯厤瀵?鏉冮檺鐢宠銆傛瘡杩涚▼鍙憡璀︿竴娆°€?
                    _QBRIDGE_DISABLED = True
                    _qbridge_warn_once(
                        "connect",
                        f"[question-bridge] connect gateway failed锛屽凡鍋滅敤妗ユ帴锛堟湰杩涚▼锛夛紝"
                        f"ask_user 鏀圭敤鏂囧瓧闂瓟: {e}")
                    return
                try:
                    while proc.poll() is None:
                        try:
                            items = client.list_questions(
                                session_key=f"agent:main:{ock}", status="pending")
                        except GatewayUnsupportedError as e:
                            # 杩炰笂浜嗕絾娌℃湁 question RPC锛堢増鏈垽鏂紡缃戞椂鐨勫厹搴曪級锛氱啍鏂紝瀹夐潤閫€鍑恒€?
                            _QBRIDGE_DISABLED = True
                            _qbridge_warn_once(
                                "unsupported",
                                f"[question-bridge] 褰撳墠 OpenClaw 鐗堟湰鏃?question RPC锛?
                                f"宸插仠鐢?ask_user 閫夐」鍗＄墖妗ユ帴锛堥渶 2026.9.x+锛? {e}")
                            return
                        except Exception:
                            time.sleep(2)
                            continue
                        for it in items:
                            qid = it.get("id")
                            if qid and qid not in pushed:
                                pushed.add(qid)
                                _emit("question", json.dumps({
                                    "id": qid,
                                    "questions": it.get("questions", []),
                                    "expiresAtMs": it.get("expiresAtMs"),
                                }, ensure_ascii=False))
                        time.sleep(2)
                finally:
                    try:
                        if client is not None:
                            client.close()
                    except Exception:
                        pass
            loop.run_in_executor(None, _question_poll)

        def _handle(line: str):
            o = _raw_event_for_run(line, run_info["run_id"])
            if o is None:
                # 灞炲叾瀹冨苟鍙?run 鐨勪簨浠讹紙鎴栨棤娉曡В鏋愶級锛氱粷涓嶆贩鍏ユ湰杞彲瑙佹祦/鏀跺熬璇婃柇锛屼粎璁℃暟銆?
                try:
                    parsed = json.loads(line)
                    rid = parsed.get("runId") if isinstance(parsed, dict) else None
                    if rid is not None and run_info["run_id"] is not None and rid != run_info["run_id"]:
                        run_info["ignored_foreign_events"] += 1
                except Exception:
                    pass
                return
            # 棣栦釜甯?runId 鐨勪簨浠堕棭閿佹湰杞?run锛堜箣鍚?_raw_event_for_run 鍙斁琛岃繖涓?run锛夈€?
            if run_info["run_id"] is None:
                rid = o.get("runId")
                if rid is None:
                    return          # 杩樻病鎷垮埌 runId锛岀瓑涓嬩竴鏉″甫 runId 鐨勪簨浠跺啀闂╅攣
                run_info["run_id"] = rid
            ev, et, delta = o.get("event"), o.get("evtType"), o.get("delta") or ""
            # 璁板綍鏈€鍚庝竴涓?raw 浜嬩欢锛氭甯告敹灏?last_ev == assistant_message_end锛?
            # 鑻ュ仠鍦?text_delta/thinking_delta 璇存槑杈撳嚭鎴栨€濊€冩祦琚腑鏂€佹病姝ｅ父鏀跺熬锛堟湰娆℃帓鏌ュ叧閿俊鍙凤級銆?
            if ev:
                run_info["last_ev"] = ev
            if ev == "assistant_message_end":
                run_info["saw_message_end"] = True
            if not delta:
                return
            if ev == "assistant_text_stream" and et == "text_delta":
                if is_http:
                    # HTTP 妯″紡姝ｆ枃浠?SSE 涓哄噯锛堥偅鏉℃墠鏄湰璇锋眰鑷繁鐨勫搷搴旀祦锛夈€傝繖閲屽啀鍙戜竴閬?
                    # 灏辨槸鍚屼竴娈靛唴瀹硅繘涓ゆ闃熷垪 鈥斺€?鍓嶇浼氱湅鍒版瘡涓瓧閲嶅銆?
                    return
                run_info["token_chars"] += len(delta)
                run_info["text_tail"] = (run_info.get("text_tail", "") + delta)[-160:]
                _emit("token", delta)
                return
            if ev == "assistant_thinking_stream" and et == "thinking_delta":
                if run_info.get("sse_thinking"):
                    return      # SSE 宸茬粡鍦ㄤ緵鎬濊€冩祦浜嗭紝鍒彔绗簩浠?
                run_info["thinking_chars"] += len(delta)
                _emit("thinking", delta)
                return

        def _tail():
            try:
                f = None
                # gateway 鍒氳捣鎴栨湰杞繕娌′骇鐢熶簨浠舵椂鏂囦欢鍙兘鏆備笉瀛樺湪锛氳疆璇㈢瓑瀹冨嚭鐜帮紙杩涚▼鍏堥€€鍑哄垯鏀跺熬锛夈€?
                while f is None:
                    try:
                        f = open(SHARED_RAW_STREAM, "r", encoding="utf-8")
                    except OSError:
                        if proc.poll() is not None:
                            return
                        time.sleep(0.04)
                with f:
                    f.seek(raw_start_offset)   # 鍙鏈疆寮€濮嬪悗杩藉姞鐨勮锛岃烦杩囧巻鍙茶疆娆?
                    buf = ""
                    while True:
                        chunk = f.readline()
                        if chunk == "":
                            if proc.poll() is not None:
                                buf += f.read()
                                for ln in buf.split("\n"):
                                    _handle(ln)
                                break
                            time.sleep(0.04)
                            continue
                        buf += chunk
                        while "\n" in buf:
                            ln, buf = buf.split("\n", 1)
                            _handle(ln)
            except Exception:
                pass
            finally:
                loop.call_soon_threadsafe(q.put_nowait, SENTINEL)

        stdout_fut = None
        if is_http:
            # 姝ｆ枃璧?SSE锛屼絾鎬濊€冩祦**涓嶈蛋**锛歰penclaw 2026.6.11 鐨?chat/completions 瀹炵幇閲?
            # reasoning/thinking 涓€娆￠兘娌″嚭鐜帮紝涓嶅洖浼犱换浣曟€濊€冨閲忋€傛€濊€冨彧瀛樺湪浜庡父椹?gateway
            # 鍐欑殑閭ｄ唤鍏变韩 raw 娴侀噷锛堝畠鎸?gateway 鑷繁鐨?env 鍐欙紝涓庤皝瑙﹀彂鏃犲叧锛夈€傛墍浠ヨ繖鏉¤矾寰?
            # 鐓ф牱 tail 瀹冣€斺€擾handle 閲?text_delta 鍦?is_http 涓嬬洿鎺ヤ涪寮冿紝鍙彇 thinking_delta锛?
            # 姝ｆ枃涓嶄細杩涗袱娆°€備笉 tail 鐨勮瘽銆岎煉?鎬濊€冭繃绋嬨€嶅湪 HTTP 妯″紡涓嬫案杩滄槸绌虹殑銆?
            loop.run_in_executor(None, _tail)
        else:
            stdout_fut = loop.run_in_executor(None, _drain_stdout)
            loop.run_in_executor(None, _tail)

        deadline = time.monotonic() + TIMEOUT_CHAT + 30
        emitted = False
        # 涓ゆ潯璺緞閮介潬銆岄槦鍒楅噷璇诲埌 SENTINEL銆嶆敹灏俱€侶TTP 妯″紡鑻ユ敼鐢ㄥ甫澶栨爣蹇楋紙涓€寮€濮嬪氨缃?True锛夛紝
        # 鏈€鍚庝竴鎵硅繕鎺掑湪 q 閲屾病琚秷璐圭殑 token 浼氶殢 poll() 杞负宸插畬鎴愯€岃鐩存帴涓㈡帀鈥斺€旂瓟妗堝熬宸磋鎴€?
        tail_finished = False
        try:
            while True:
                # A raw-stream reader failure must not be mistaken for model
                # completion. Keep the session lock until the process exits.
                if tail_finished and proc.poll() is not None:
                    break
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    timed_out = True
                    to_client("error", "鈴憋笍 璇锋眰瓒呮椂")
                    break
                try:
                    item = await asyncio.wait_for(q.get(), timeout=min(10, remaining))
                except asyncio.TimeoutError:
                    continue
                if item is SENTINEL:
                    tail_finished = True
                    if proc.poll() is not None:
                        break
                    continue
                if item["t"] == "token":
                    emitted = True
                    full_text.append(item["text"])
                    to_client("token", item["text"])
                elif item["t"] == "thinking":
                    to_client("thinking", item["text"])
                elif item["t"] == "activity":
                    to_client("activity", item["text"])
                elif item["t"] == "question":
                    to_client("question", item["text"])
            rc = proc.poll()
            # 绛?stdout 璇诲畬锛坰topReason 琛屽湪杩涚▼鏀跺熬鏃舵墠鎵撳嵃锛岄伩鍏?_tail 鍏堝彂 SENTINEL 鏃舵紡璇伙級
            if stdout_fut is not None:
                try:
                    await asyncio.wait_for(stdout_fut, timeout=2)
                except Exception:
                    pass
            sr = run_info.get("stop_reason")
            if not emitted:
                clean = clean_agent_output("".join(stdout_lines))
                if clean:
                    emitted = True
                    full_text.append(clean)
                    to_client("token", clean)
                elif rc not in (0, None):
                    err = clean_agent_output("".join(stdout_lines))[:200]
                    to_client("error", f"鉂?鎵ц澶辫触锛堥€€鍑虹爜 {rc}锛墈' 鈥?' + err if err else ''}")
            # 鏀跺熬妫€娴嬶細鍗充娇宸插悙浜嗗唴瀹癸紝鍙涓嶆槸銆屾甯告敹灏俱€嶅氨鏄惧紡鍛婄煡鈥斺€?
            # 鍚﹀垯琚埅鏂紙瑙﹂《锛?琚潃锛堣礋杞斤級/娴佽涓柇锛岄兘浼氳褰撴垚銆屾竻鏅板湴绛斿畬浜嗐€嶏紝
            # 鐢ㄦ埛鐪嬪埌鐨勫氨鏄€岀瓟涓€鍗婄獊鐒跺仠銆佷篃涓嶈鍋氬畬銆嶏紙鏈?bug 鏍瑰洜锛夈€?
            # 姝ｅ父鏀跺熬鐨勫敮涓€鏍囧織锛歳aw 娴佹渶鍚庝竴涓簨浠舵槸 assistant_message_end銆?
            # 鐢ㄦ埛鏄惧紡銆屽仠姝€嶄笉鏄紓甯镐腑鏂?鈫?涓嶆姤銆岃涓柇銆嶅憡璀︼紙鍓嶇宸插氨鍦版爣娉ㄣ€屽凡鍋滄銆嶏級銆?
            if (emitted or run_info["thinking_chars"]) and sk not in _STOPPED_CHAT:
                note = None
                if sr and sr in ("max_tokens", "length", "model_length"):
                    note = (f"\n\n---\n鈿狅笍 涓婇潰杩欐潯**琚埅鏂?*浜嗭紙stopReason={sr}锛屽崟鏉″洖澶嶈Е椤讹級銆?
                            f"鍥炴垜銆岀户缁€嶆垜鎺ョ潃鍐欏畬锛屾垨璁╂垜鎶婁换鍔℃媶灏忎竴鐐广€?)
                elif rc not in (0, None):
                    note = (f"\n\n---\n鈿狅笍 鐢熸垚**琚腑鏂?*锛堥€€鍑虹爜 {rc}锛屽鍗婃槸瓒呮椂鎴栫郴缁熻礋杞借繃楂樻妸杩涚▼鏉€浜嗭級锛?
                            f"涓嶆槸姝ｅ父鏀跺熬銆傚彲浠ヨ鎴戦噸璇曘€?)
                elif sr == "tool_use":
                    note = ("\n\n---\n鈿狅笍 鎴戝垰鍋氬畬杩欎竴姝ャ€?*姝ｈ鎵ц涓嬩竴姝ユ搷浣滄椂涓柇浜?*"
                            "锛堟湰杞互宸ュ叿璋冪敤缁撳熬鍗存病鑳界户缁紝鍓嶇鎶婂畠褰撴垚绛斿畬浜嗭級銆傚洖鎴戙€岀户缁€嶆垜鎺ョ潃鍋氥€?)
                elif run_info.get("last_ev") not in (None, "assistant_message_end"):
                    note = ("\n\n---\n鈿狅笍 杩欐潯**鍙兘娌″啓瀹?*鈥斺€旀ā鍨嬬殑杈撳嚭/鎬濊€冩祦琚腑鏂€佹病鏈夋甯告敹灏?
                            "锛堝涓虹綉缁滄垨妯″瀷浠ｇ悊鎶婇暱鍥炲鐨勬祦鎺愭柇浜嗭級銆傚洖鎴戙€岀户缁€嶏紝鎴栭噸璇曘€?)
                elif run_info.get("text_tail", "").rstrip()[-1:] in ("锛?, ":"):
                    # 姝ｅ父鏀跺熬浣嗘鏂囧仠鍦ㄥ啋鍙?= 妯″瀷"鎴戣鍋歑锛?鍚庢病鎺ョ潃鍋氾紙澶氫负瑕佹帴宸ュ叿/涓嬩竴姝ュ嵈鏂簡锛夈€?
                    # 鐢ㄦ埛瀹炴祴銆屾墍鏈夎帿鍚嶅仠姝㈤兘鍋滃湪鍐掑彿銆嶁€斺€旇繖涓€鏉″厹浣忚繖涓ā寮忋€?
                    note = ("\n\n---\n鈿狅笍 鎴戜技涔庡仠鍦ㄤ簡鍐掑彿澶勩€佹病鎺ョ潃鎶婂悗闈㈢殑鍐呭/鎿嶄綔鍋氬嚭鏉ャ€?
                            "鍥炴垜銆岀户缁€嶆垜琛ヤ笂銆?)
                if note:
                    full_text.append(note)
                    to_client("token", note)
        finally:
            # 鍙湁鐪熺殑鍦?HTTP 涓婅窇鍑轰簡鍐呭锛屾墠鎶婅繖涓細璇濋拤鍒?http 涓娿€傞拤鏃╀簡锛堟瘮濡傞€夎矾鏃跺氨閽夛級
            # 浼氭妸涓€涓叾瀹炴病璺戞垚鐨勪細璇濋攣姝诲湪 http锛屼箣鍚庢瘡杞兘寰€涓€鏉′笉閫氱殑璺笂鎾烇紱鑰岄拤浣忎箣鍚?
            # 灏辩粷涓嶈兘鍐嶆崲鍥?cli 鈥斺€?缃戝叧閭ｄ唤 transcript 鎴戜滑鎸夊悕瀛楁壘涓嶅洖鏉ワ紝鎹㈣竟鍗充涪鍘嗗彶銆?
            if is_http and emitted:
                _pin_transport(sk, "http")
            user_stopped = sk in _STOPPED_CHAT
            _STOPPED_CHAT.discard(sk)
            # Reaching finally while the child is alive means timeout, explicit
            # stop, cancellation, or an internal stream failure. Never release
            # the session locks while such a process can still write history.
            if proc.poll() is None:
                try:
                    proc.terminate()
                except OSError:
                    pass
                try:
                    await asyncio.to_thread(proc.wait, timeout=5)
                except subprocess.TimeoutExpired:
                    try:
                        proc.kill()
                        await asyncio.to_thread(proc.wait, timeout=2)
                    except (OSError, subprocess.TimeoutExpired):
                        pass
            # 璇婃柇鏃ュ織锛氭瘡娆″璇濇祦鏀跺熬閮借涓€琛岋紝渚涗簨鍚庡畾浣嶃€岃帿鍚嶅仠涓嬨€嶅埌搴曟槸鍝鎯呭喌銆?
            try:
                debug_dir().mkdir(parents=True, exist_ok=True)
                tail = clean_agent_output("".join(stdout_lines))[-800:]
                with (debug_dir() / "chat-stream.jsonl").open("a", encoding="utf-8") as lf:
                    lf.write(json.dumps({
                        "at": time.strftime("%Y-%m-%dT%H:%M:%S"),
                        "session": sk,
                        "rc": proc.poll(),
                        "stop_reason": run_info["stop_reason"],
                        "last_ev": run_info["last_ev"],
                        "clean_end": run_info["last_ev"] == "assistant_message_end",
                        "saw_message_end": run_info["saw_message_end"],
                        "fetch_count": run_info["fetch_count"],
                        "token_chars": run_info["token_chars"],
                        "thinking_chars": run_info["thinking_chars"],
                        "delegated": run_info["delegated"],
                        "ignored_foreign_events": run_info["ignored_foreign_events"],
                        "text_tail": run_info.get("text_tail", ""),
                        "stdout_tail": tail,
                    }, ensure_ascii=False) + "\n")
            except Exception:
                pass
            # 钀界洏瀹屾暣缁撴灉锛氬悗绔窇瀹屾暣杞笉渚濊禆瀹㈡埛绔繛鎺ワ紝鏂嚎鍚庡墠绔敤 /api/chat/last 鍙栧洖
            _save_turn(pk, "done", "".join(full_text), {
                "turn_id": turn_id,
                "clean_end": run_info.get("last_ev") == "assistant_message_end",
                "stop_reason": "user_stopped" if user_stopped else run_info.get("stop_reason"),
            })
            try:
                await asyncio.to_thread(_adopt_workspace_outputs, sk)
            except Exception:
                pass
            xlock.release()
            lock.release()
            _RUNNING_CHAT.pop(sk, None)
            to_client("done", sessionKey=sk)
            client_q.put_nowait(CLIENT_DONE)

    # 鎶?run 璺戝湪鐙珛鍚庡彴浠诲姟閲岋紙鎸佸己寮曠敤闃?GC锛夆€斺€斿鎴风鏂紑涓嶅彇娑堝畠銆?
    task = asyncio.create_task(supervisor())
    _BG_TASKS.add(task)

    def _bg_done(t):
        _BG_TASKS.discard(t)
        try:
            exc = t.exception()   # 鍙栧嚭寮傚父閬垮厤銆宯ever retrieved銆嶅憡璀?
        except Exception:
            exc = None
        if exc is not None:
            # supervisor 鎰忓宕╂簝锛氳В閿?forward锛屽埆璁╁畠绌虹瓑
            try:
                client_q.put_nowait(CLIENT_DONE)
            except Exception:
                pass
    task.add_done_callback(_bg_done)

    async def forward():
        """绾浆鍙戯細浠?client_q 鍙栦簨浠?yield 缁欐祻瑙堝櫒銆?

        瀹㈡埛绔柇寮€锛堝叧鏍囩/浠ｇ悊鎺愭柇锛夊彧浼氱粨鏉熸湰鐢熸垚鍣紝supervisor 浠诲姟涓嶅彈褰卞搷锛?
        缁х画鎶?openclaw run 璺戝畬骞惰惤鐩?鈫?鍓嶇鏂嚎鍚?/api/chat/last 鍙栧洖瀹屾暣缁撴灉銆?
        """
        idle_since = time.monotonic()
        while True:
            try:
                item = await asyncio.wait_for(client_q.get(), timeout=10)
            except asyncio.TimeoutError:
                # 闀挎椂闂存棤杈撳嚭锛堢瓑妯″瀷闀垮洖澶?/ 鍒朵綔绫婚暱浠诲姟锛夆啋 鍙戝績璺筹紝璁╃敤鎴风煡閬撴病鍗℃銆?
                # 鐢ㄧ嫭绔嬬殑 `heartbeat` 浜嬩欢锛屼笉璧?`activity`锛氬惁鍒欎細瑕嗙洊鎺夌湡瀹炵殑
                # 銆岎煣?姝ｅ湪鎬濊€冣€?馃洜锔?鍒朵綔涓€︺€嶇姸鎬佷笌鎬濊€冩祦锛堥槻鍛嗘秷鎭妸鎬濊€冭璁￠《鎺夌殑鏍瑰洜锛夈€?
                # 鍙戝嚭鍚庨噸缃?idle_since 鈫?蹇冭烦鎸?30s 涓€娆＄殑鑺傚锛屼笉鍐嶆瘡 10s 閲嶅鍒峰睆銆?
                if time.monotonic() - idle_since >= 30:
                    idle_since = time.monotonic()
                    yield {"event": "heartbeat", "data": json.dumps(
                        "浠嶅湪澶勭悊涓紝鏈崱浣忊€︼紙澶嶆潅鎴栧埗浣滅被浠诲姟浼氳姳鐐规椂闂达級", ensure_ascii=False)}
                continue
            if item is CLIENT_DONE:
                break
            idle_since = time.monotonic()
            t = item["t"]
            if t == "token":
                yield {"id": str(item["id"]), "event": "token", "data": json.dumps(item["text"], ensure_ascii=False)}
            elif t == "thinking":
                yield {"id": str(item["id"]), "event": "thinking", "data": json.dumps(item["text"], ensure_ascii=False)}
            elif t == "activity":
                yield {"id": str(item["id"]), "event": "activity", "data": json.dumps(item["text"], ensure_ascii=False)}
            elif t == "question":
                yield {"id": str(item["id"]), "event": "question", "data": item["text"]}
            elif t == "error":
                yield {"id": str(item["id"]), "event": "error", "data": json.dumps(item["text"], ensure_ascii=False)}
            elif t == "done":
                yield {"id": str(item["id"]), "event": "done", "data": json.dumps({"sessionKey": item.get("sessionKey")}, ensure_ascii=False)}

    return EventSourceResponse(forward(), headers={"Cache-Control": "no-cache, no-transform", "X-Accel-Buffering": "no", "Content-Encoding": "identity"})


class QuestionAnswerRequest(BaseModel):
    sessionId: str | None = None
    questionId: str
    answers: dict  # {questionId: [optionValues]}
    resolvedBy: str | None = None


@app.post("/api/chat/question/answer")
async def api_question_answer(req: QuestionAnswerRequest):
    """鍓嶇鐐瑰嚮 ask_user 閫夐」鍚庤皟鐢細杞彂 gateway question.resolve锛岃绛夊緟鐨?agent 鎷垮埌绛旀銆?""
    if GatewayClient is None:
        return {"ok": False, "error": "gateway question bridge unavailable"}
    client = GatewayClient()
    try:
        client.connect()
        result = client.resolve(req.questionId, req.answers or {}, req.resolvedBy)
        return {"ok": True, "result": result}
    except Exception as e:
        return {"ok": False, "error": str(e)}
    finally:
        client.close()


class QuestionStatusRequest(BaseModel):
    questionIds: list[str]


@app.post("/api/chat/question/status")
async def api_question_status(req: QuestionStatusRequest):
    """鎵归噺鏌?question 鐘舵€侊紙閲嶆斁鏃т簨浠舵椂杩囨护宸茶В鍐崇殑棰橈級銆?""
    if GatewayClient is None:
        return {"ok": False, "questions": {}}
    client = GatewayClient()
    try:
        client.connect()
        out = {}
        for qid in req.questionIds:
            try:
                q = client.get_question(qid)
                # QUESTION_NOT_FOUND 鎶涘紓甯告崟鑾峰悗鎶?not_found锛涙甯歌繑鍥炲垯鎸?status
                out[qid] = {"status": q.get("status") if q else "not_found"}
            except GatewayQuestionError as e:
                # gateway 鏄庣‘閿欙細闂宸叉竻鐞?涓嶅瓨鍦?= 宸茬瓟鎴栧凡杩囨湡锛屼竴寰?not_found
                out[qid] = {"status": "not_found"}
            except Exception:
                out[qid] = {"status": "unknown"}   # 缃戠粶/杩炴帴寮傚父锛氫繚鎸?unknown锛堝墠绔繚鐣欐樉绀猴紝瀹佷笉缂洪锛?
        return {"ok": True, "questions": out}
    except Exception as e:
        return {"ok": False, "error": str(e), "questions": {}}
    finally:
        client.close()


class StopRequest(BaseModel):
    sessionId: str | None = None


@app.post("/api/chat/stop")
async def api_chat_stop(req: StopRequest):
    """鐢ㄦ埛鏄惧紡鍋滄褰撳墠浼氳瘽姝ｅ湪璺戠殑瀵硅瘽 agent锛氱粓姝㈣繘绋?鈫?supervisor 鏀跺熬閲婃斁浼氳瘽閿?鈫?
    涓嬩竴鍙ョ珛鍒昏兘鍙戯紙涓嶅啀鍗°€屼笂涓€鏉¤繕鍦ㄨ窇銆嶏級銆備粎姝ゆ樉寮忓叆鍙ｄ細鏉€杩涚▼锛涘鎴风鏂嚎涓嶇粡姝よ矾寰勩€?""
    sk = (req.sessionId or "").strip()
    proc = _RUNNING_CHAT.get(sk) if sk else None
    if proc is not None and proc.poll() is None:
        _STOPPED_CHAT.add(sk)          # 鏍囪涓虹敤鎴峰仠姝紝渚?supervisor 姝ｅ父鏀跺熬锛堜笉鎶ャ€岃涓柇銆嶏級
        try:
            proc.terminate()
        except OSError:
            pass
        try:
            await asyncio.to_thread(proc.wait, timeout=3)
        except subprocess.TimeoutExpired:
            try:
                proc.kill()
            except OSError:
                pass
        # supervisor removes the running marker only after persisting the final
        # snapshot and releasing both session locks.
        deadline = time.monotonic() + 5
        while _RUNNING_CHAT.get(sk) is proc and time.monotonic() < deadline:
            await asyncio.sleep(0.05)
        return {"stopped": True}
    return {"stopped": False}          # 娌℃湁鍦ㄨ窇锛堝彲鑳藉凡缁撴潫锛夆啋 鍓嶇鐓у父娓呯悊鍗冲彲


@app.post("/api/chat")
async def api_chat(req: ChatRequest):
    if not CURRENT_UID.get():
        raise HTTPException(401, '请先登录')
    """闈炴祦寮忓璇濓紙澶囬€夛級銆?""
    # 姣忚疆鏈熬杩藉姞銆屽厛鏌ユ妧鑳藉簱銆嶆彁閱掞紝鎶楅暱瀵硅瘽鎸囦护琛板噺锛堝鐢ㄦ埛涓嶅彲瑙侊級
    message = _chat_message(req)
    loop = asyncio.get_event_loop()
    # chat 鍙兘涓€旇Е鍙戝埗浣滃眰闀夸换鍔?鈫?鐢?TIMEOUT_CHAT锛屼笌娴佸紡 /api/chat/stream 涓€鑷达紙鍕跨敤 300s锛?
    result = await loop.run_in_executor(None, run_agent_sync, message, TIMEOUT_CHAT, req.sessionId)
    try:
        await asyncio.to_thread(_adopt_workspace_outputs, req.sessionId)
    except Exception:
        pass
    return {"response": result}


