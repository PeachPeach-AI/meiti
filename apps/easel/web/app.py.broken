        _ENV_ALLOWLIST.add(_key["env"])
        _ENV_ALLOWLIST.update(_key.get("aliases", []))
    for _prov in _spec["providers"]:
        for _key in _prov["keys"]:
            _ENV_ALLOWLIST.add(_key["env"])
            _ENV_ALLOWLIST.update(_key.get("aliases", []))

ENV_FILE = PROJECT_ROOT / ".env"
_PLACEHOLDER_RE = re.compile(r"replace_me|your[-_]?api[-_]?key|xxx|^\.{3}$|^<.*>$", re.I)

TEXT_EXTS = {".txt", ".md", ".json", ".csv", ".log", ".py", ".js", ".ts", ".html", ".htm", ".css", ".xml", ".yaml", ".yml", ".srt", ".vtt"}
IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".svg"}
VIDEO_EXTS = {".mp4", ".mov", ".webm", ".m4v"}
AUDIO_EXTS = {".mp3", ".wav", ".m4a", ".aac", ".ogg", ".flac"}

@asynccontextmanager
async def _lifespan(_app: FastAPI):
    """搴旂敤鐢熷懡鍛ㄦ湡锛氬惎鍔ㄨ嚜寤虹珯姣忔棩鍙戝竷瀹氭椂鍣紱鍏虫満鍥炴敹鍏紬鍙锋壂鐮佽繘绋嬨€?""
    task = asyncio.create_task(_cms_scheduler())
    try:
        yield
    finally:
        task.cancel()
        _stop_mp_login_on_shutdown()


app = FastAPI(title="Easel", docs_url=None, redoc_url=None, lifespan=_lifespan)
app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_methods=["*"], allow_headers=["*"])


# ---------------- 璐﹀彿 / 鐧诲綍鎺ュ彛 ----------------
class RegisterReq(BaseModel):
    username: str = ""
    password: str = ""
    displayName: str = ""


class LoginReq(BaseModel):
    username: str = ""
    password: str = ""


@app.middleware("http")
async def _auth_middleware(request: Request, call_next):
    tok = ""
    auth = request.headers.get("authorization") or ""
    if auth.lower().startswith("bearer "):
        tok = auth[7:].strip()
    if not tok:
        tok = (request.headers.get("x-easel-token") or "").strip()
    if not tok:
        tok = (request.cookies.get("easel_token") or "").strip()
    if not tok:
        # <img>/<video> 绛夋爣绛炬棤娉曡嚜瀹氫箟璇锋眰澶达紝鐧诲綍浜岀淮鐮?绱犳潗鍥剧粺涓€鐢??token= 鍏滃簳
        tok = (request.query_params.get("token") or "").strip()
    CURRENT_UID.set(_TOKENS.get(tok) if tok else None)
    return await call_next(request)


def _issue_token(uid: str) -> str:
    token = secrets.token_urlsafe(32)
    _TOKENS[token] = uid
    return token


@app.post("/api/auth/register")
async def api_register(req: RegisterReq):
    username = (req.username or "").strip()
    password = req.password or ""
    if len(username) < 2 or len(password) < 4:
        raise HTTPException(400, "鐢ㄦ埛鍚嶈嚦灏?2 浣嶏紝瀵嗙爜鑷冲皯 4 浣?)
    users = _load_accounts()
    if any((u.get("username") or "").lower() == username.lower() for u in users):
        raise HTTPException(400, "鐢ㄦ埛鍚嶅凡瀛樺湪")
    uid = uuid.uuid4().hex[:12]
    salt = secrets.token_hex(16)
    first = len(users) == 0
    user = {"id": uid, "username": username, "displayName": (req.displayName or "").strip() or username,
            "salt": salt, "passwordHash": _hash_password(password, salt), "createdAt": int(time.time())}
    users.append(user)
    _save_accounts(users)
    if first:
        _migrate_legacy(uid)
    return {"token": _issue_token(uid), "user": _public_user(user)}


@app.post("/api/auth/login")
async def api_login(req: LoginReq):
    username = (req.username or "").strip().lower()
    users = _load_accounts()
    u = next((x for x in users if (x.get("username") or "").lower() == username), None)
    if not u or _hash_password(req.password or "", u.get("salt", "")) != u.get("passwordHash"):
        raise HTTPException(401, "鐢ㄦ埛鍚嶆垨瀵嗙爜閿欒")
    return {"token": _issue_token(u["id"]), "user": _public_user(u)}


@app.post("/api/auth/logout")
async def api_logout(request: Request):
    auth = request.headers.get("authorization") or ""
    tok = auth[7:].strip() if auth.lower().startswith("bearer ") else (request.headers.get("x-easel-token") or "").strip()
    if tok:
        _TOKENS.pop(tok, None)
    return {"ok": True}


@app.get("/api/auth/me")
async def api_auth_me():
    uid = CURRENT_UID.get()
    if not uid:
        raise HTTPException(401, "鏈櫥褰?)
    u = next((x for x in _load_accounts() if x.get("id") == uid), None)
    if not u:
        raise HTTPException(401, "璐﹀彿涓嶅瓨鍦?)
    return _public_user(u)


@app.get("/api/auth/accounts")
async def api_auth_accounts():
    return [_public_user(u) for u in _load_accounts()]



def _persona_cover_path(name: str) -> "Path | None":
    d = profiles_dir() / name
    if not d.is_dir():
        return None
    for ext in (".png", ".jpg", ".jpeg", ".webp", ".gif"):
        p = d / f"cover{ext}"
        if p.is_file():
            return p
    return None


def list_personas() -> list[dict]:
    if not profiles_dir().is_dir():
        return []
    result = []
    for d in sorted(profiles_dir().iterdir()):
        if d.is_dir() and d.name.startswith('_'):
            continue
        desc = ''
        identity = d / 'identity.md'
        if identity.is_file():
            for line in identity.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if line and not line.startswith('#') and not line.startswith('<!--'):
                    desc = line[:80]
                    break
        cover = any((d / f"cover{ext}").is_file() for ext in (".png", ".jpg", ".jpeg", ".webp", ".gif"))
        result.append({'name': d.name, 'description': desc, 'cover': cover})
    return result


def find_skill(name: str) -> str | None:
    """鏌ユ壘 SKILL锛岃繑鍥炲畬鏁村悕鎴?None銆備笌 CLI skill.py 涓€鑷淬€?""
    cands = [name, f'skill-{name}'] if not name.startswith('skill-') else [name]
    for cand in cands:
        if (SKILLS_DIR / 'openclaw' / cand / 'SKILL.md').is_file():
            return cand
    return None


def _parse_skill_md(path: Path) -> tuple[str, str, str]:
    """瑙ｆ瀽 SKILL.md 鈫?(description, layer, body)銆俠ody 涓哄幓鎺?frontmatter 鐨勬鏂囥€?
    姝ｇ‘澶勭悊 YAML 鍧楁爣閲?description锛坄>-` / `>` / `|` 鍚庤窡缂╄繘澶氳锛夈€?""
    text = path.read_text(encoding='utf-8')
    desc, layer, body = '', '', text
    lines = text.splitlines()
    if not (lines and lines[0].strip() == '---'):
        return desc, layer, body
    end = None
    for i in range(1, len(lines)):
        if lines[i].strip() == '---':
            end = i
            break
    if end is None:
        return desc, layer, body
    body = '\n'.join(lines[end + 1:]).strip()
    fm = lines[1:end]
    i = 0
    while i < len(fm):
        st = fm[i].strip()
        if st.startswith('layer:'):
            layer = st.split(':', 1)[1].strip().strip('"').strip("'")
            i += 1
        elif st.startswith('description:'):
            val = st.split(':', 1)[1].strip()
            if val and val[0] in '|>':
                block = []
                j = i + 1
                while j < len(fm):
                    if fm[j].strip() == '':
                        block.append('')
                        j += 1
                        continue
                    indent = len(fm[j]) - len(fm[j].lstrip())
                    if indent == 0:
                        break
                    block.append(fm[j].strip())
                    j += 1
                desc = ' '.join(x for x in block if x).strip()
                i = j
            else:
                desc = val.strip('"').strip("'")
                i += 1
        else:
            i += 1
    return desc, layer, body


def get_skills() -> list[dict]:
    env = _read_env()
    result = []
    sd = SKILLS_DIR / 'openclaw'
    if sd.is_dir():
        for d in sorted(sd.iterdir()):
            if d.is_dir() and (d / 'SKILL.md').is_file():
                desc, layer, _ = _parse_skill_md(d / 'SKILL.md')
                needs_api = d.name in SKILL_API_REQUIREMENTS
                result.append({
                    'name': d.name,
                    'description': desc,
                    'layer': layer,
                    'needsApi': needs_api,
                    'apiConfigured': _skill_api_configured(d.name, env) if needs_api else True,
                })
    return result


def clean_agent_output(raw: str) -> str:
    lines = []
    for line in raw.splitlines():
        c = re.sub(r'\x1b\[[0-9;]*m', '', line)
        if c.startswith('[') and any(t in c[:40] for t in ('[provider-', '[agents/', '[agent/', '[plugins]', '[tools]', '[diagnostic]', '[fetch-', '[heartbeat]', '[health-', '[gateway]')):
            continue
        if c.strip():
            lines.append(c)
    return '\n'.join(lines).strip()


def _proxy_env() -> dict[str, str]:
    """杩斿洖甯﹀缃戜唬鐞嗙殑鐜鍙橀噺锛堜繚鎶ゅ唴缃戠洿杩烇級銆?""
    env = os.environ.copy()
    env.setdefault('EASEL_ROOT', str(PROJECT_ROOT))
    env.setdefault('http_proxy', os.environ.get('EASEL_PROXY', ''))
    env.setdefault('https_proxy', os.environ.get('EASEL_PROXY', ''))
    env.setdefault('no_proxy', 'localhost,127.0.0.1,10.*,*.xiaohongshu.com,*.devops.xiaohongshu.com,*.douyin.com,*.kuaishou.com,*.zhihu.com,*.bilibili.com,*.weixin.qq.com,*.qq.com')
    return env


def _publish_env() -> dict[str, str]:
    """鍙戝竷瀛愯繘绋?env锛氬湪 _proxy_env 鍩虹涓婄鐢ㄨ剼鏈晶鏃ュ巻鑷姩璁板綍鈥斺€?
    鍙戝竷椤电敱 web 鑷繁鍥炴祦 _schedule.json锛岃剼鏈啀璁颁竴娆′細閲嶅銆傚璇濋〉 Agent 鐩磋窇
    鑴氭湰鏃朵笉缁忚繃杩欓噷锛宖lag 鏈 鈫?鑴氭湰鑷姩璁板綍锛堣 calendar_ops.record_publish锛夈€?""
    env = _proxy_env()
    env['EASEL_CALENDAR_AUTORECORD'] = '0'
    return env


def _wechat_env() -> dict[str, str]:
    """鍏紬鍙?API 瀛愯繘绋?env锛屽喅瀹氬井淇?API 浠庡摢涓?IP 鍑虹綉锛堝叕浼楀彿鐧藉悕鍗曡姹傚浐瀹氬嚭鍙?IP锛夈€?

    涓ょ妯″紡锛?
    - 璁句簡 WECHAT_EGRESS_PROXY锛堝鍙嶅悜闅ч亾鍒颁綘鏈満/鍥哄畾 IP 涓浆锛夆啋 璁╁井淇?API **璧拌繖涓唬鐞?*鍑虹綉锛?
      寰俊鐪嬪埌鐨勬槸璇ヤ唬鐞嗙殑鍏綉 IP锛岀櫧鍚嶅崟鍔犲畠鍗冲彲銆傚叾瀹冨缃戜粛璧板叕鍙镐唬鐞嗐€?
    - 鏈 鈫?寰俊 API 璧?*鐩磋繛**锛坅pi.weixin.qq.com 杩?no_proxy锛夈€傛敞鎰忔湰鏈虹洿杩炲嚭鍙ｄ篃鏄叡浜?NAT
      杞姹狅紙瑙?WECHAT_OA_INTEGRATION.md 搂4锛夛紝鐩磋繛浠呭湪鍑哄彛 IP 鎭板ソ鍥哄畾鐨勬満鍣ㄤ笂鍙潬銆?""
    env = _publish_env()
    wx_hosts = ("api.weixin.qq.com", "mp.weixin.qq.com")
    egress = os.environ.get("WECHAT_EGRESS_PROXY", "").strip()
    if egress:
        # 寰俊 API 璧版寚瀹氬浐瀹氬嚭鍙ｄ唬鐞嗭紱浠?no_proxy 閲屽幓鎺夊井淇″煙鍚嶏紝纭繚涓嶈鏃佽矾鎴愮洿杩炪€?
        env["http_proxy"] = env["https_proxy"] = egress
        env["HTTP_PROXY"] = env["HTTPS_PROXY"] = egress
        kept = [h for h in env.get("no_proxy", "").split(",") if h and not any(w in h for w in wx_hosts)]
        env["no_proxy"] = ",".join(kept)
        env["NO_PROXY"] = env["no_proxy"]
    else:
        existing = env.get("no_proxy", "")
        env["no_proxy"] = (existing + "," + ",".join(wx_hosts)) if existing else ",".join(wx_hosts)
        env["NO_PROXY"] = env["no_proxy"]
    return env


def _persona_prefix(persona: str | None) -> str:
    """鎶婄敾鍍忎綔涓烘秷鎭墠缂€鍐呰仈锛堝鐢?easel.persona锛屼笌 CLI/skill 鍚屾簮锛夈€?""
    return persona_prefix(persona)


def _read_env() -> dict[str, str]:
    """瀹芥澗瑙ｆ瀽椤圭洰鏍?.env 鈫?{KEY: value}銆傝烦杩囨敞閲婁笌闈?KEY=value 琛岋紙瀹瑰繊澶氳鍊兼畫琛岋級銆?""
    result = {}
    if not ENV_FILE.is_file():
        return result
    for line in ENV_FILE.read_text(encoding='utf-8').splitlines():
        s = line.strip()
        if not s or s.startswith('#') or '=' not in s:
            continue
        key, val = s.split('=', 1)
        key = key.strip()
        if key.isidentifier() or key.replace('-', '_').isidentifier():
            result[key] = val.strip()
    return result


def _is_set(val: str | None) -> bool:
    """闈炵┖涓旈潪鍗犱綅绗︽墠绠楃湡姝ｉ厤缃簡銆?""
    if not val or not val.strip():
        return False
    return not _PLACEHOLDER_RE.search(val.strip())


def _mask(val: str) -> str:
    """鑴辨晱锛氬彧鐣欏熬 4 浣嶏紙鐭€煎叏閬級銆?""
    v = val.strip()
    if len(v) <= 4:
        return '鈥⑩€⑩€⑩€?
    return '鈥⑩€⑩€⑩€? + v[-4:]


def _key_configured(key: dict, env: dict[str, str]) -> bool:
    '鏌愪釜 key锛堝惈鍒悕锛夋槸鍚﹀凡閰嶇疆銆?
    if _is_set(env.get(key['env'])):
        return True
    return any(_is_set(env.get(a)) for a in key.get('aliases', []))


def _skill_api_configured(skill: str, env: dict[str, str] | None = None) -> bool:
    'SKILL 鏄惁宸插叿澶囧彲鐢ㄩ厤缃細浠讳竴 provider 鐨勫叏閮?required key 榻愬叏銆?
    spec = SKILL_API_REQUIREMENTS.get(skill)
    if not spec:
        return True
    env = _read_env() if env is None else env
    for prov in spec['providers']:
        if all(_key_configured(k, env) for k in prov['keys'] if k['required']):
            return True
    return False


# .env 鐨勫€兼槸瑁稿啓 `KEY=value` 鐨勶紝鑰?setup.sh:310/450 浼?`source .env`銆俠ash 鍦ㄨ祴鍊煎彸渚?
# 涓嶅仛鍒嗚瘝鍜岄€氶厤锛屼絾**鐓у仛**鍛戒护鏇挎崲锛屼笖鍏冨瓧绗︿細鎴柇璧嬪€煎彟璧蜂竴鏉″懡浠?鈥斺€?鎵€浠?`$(鈥?`銆佸弽寮曞彿銆?
# `;`/`&`/`|`/`(`/`)`/`<`/`>`/绌虹櫧 閮界瓑浜庝换鎰忓懡浠ゆ墽琛屻€傚姞寮曞彿鍐欏叆涓嶈锛歴cripts/gateway.sh:63
# 鐢?`sed -n 's/^KEY=//p'` 瑁稿彇鍊硷紝寮曞彿浼氳窡鐫€婕忚繘绔彛鍙枫€傚彧鑳藉湪鍏ュ彛鎶婂€肩殑瀛楃闆嗘敹姝汇€?
# 杩欓噷鑳藉啓鐨勫叏鏄?API Key / Base URL / 妯″瀷 id / 绔彛锛屾病鏈変竴涓渶瑕佺┖鏍兼垨涓婇潰閭ｄ簺瀛楃銆?
_ENV_VALUE_OK = re.compile(r'[A-Za-z0-9_.:/@+\-=~,%?#\[\]]*')


def _guard_env_values(updates: dict[str, str]) -> None:
    """闆嗕腑鎷︽埅 .env 鍊兼敞鍏ワ細鍊奸噷甯︽崲琛岃兘寰€ .env 杩藉姞浠绘剰琛岋紝甯?`$(鈥?` 鑳界洿鎺ユ墽琛屽懡浠?
    鈥斺€?涓よ€呴兘绛変簬浠讳綍鑳借皟鍒板啓 .env 鎺ュ彛鐨勪汉閮借兘鎷垮埌鍛戒护鎵ц銆傞敭鍚嶅悓鐞嗐€備袱涓啓鍏ュ彛閮藉繀椤诲厛杩囪繖閬撱€?""
    for k, v in updates.items():
        if any(c in (k or '') for c in '\r\n=') or not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', k or ''):
            raise HTTPException(400, f'闈炴硶鐨勯厤缃敭鍚嶏細{(k or "")[:40]!r}')
        v = v or ''
        if any(c in v for c in '\r\n\x00'):
            raise HTTPException(400, f'閰嶇疆鍊间笉鑳藉寘鍚崲琛岀锛歿k}')
        if not _ENV_VALUE_OK.fullmatch(v):
            bad = ''.join(sorted({c for c in v if not _ENV_VALUE_OK.fullmatch(c)}))
            raise HTTPException(400, f'閰嶇疆鍊煎惈涓嶅厑璁哥殑瀛楃锛坽bad!r}锛夛細{k}')


def _is_local_gateway_base(url: str) -> bool:
    """杩欎釜渚涘簲鍟嗗綋鍓嶆槸涓嶆槸鎸傚湪鏈湴妯″瀷缃戝叧涓娿€?

    缃戝叧妯″紡涓?openclaw.json 閲屽瓨鐨?baseUrl 鏄?127.0.0.1:8890锛岀湡瀹炰笂娓稿湪 easel-models.yaml锛?
    闈㈡澘鏄剧ず/鍥炰紶鐨勬槸涓婃父鍦板潃 鈥斺€?涓よ竟澶╃敓涓嶇浉绛夈€傚嚒鏄嬁銆宐aseUrl 鍙樹簡銆嶅綋鍒ゆ嵁鐨勯€昏緫閮藉緱鍏堥棶杩囪繖閲岋紝
    鍚﹀垯缃戝叧鐢ㄦ埛姣忔淇濆瓨閮借鍒ゆ垚銆屾崲浜嗗湴鍧€銆嶃€?
    """
    return str(url or '').startswith('http://127.0.0.1:8890')


# 璁剧疆闈㈡澘閲屻€屾敼浜?Base URL 灏卞繀椤婚噸濉?Key銆嶈姣斿鐨?.env 閿綅锛堟Ы浣?鈫?(base 閿? key 閿?锛夈€?
_SLOT_ENV_KEYS = {
    'openai': ('OPENAI_BASE_URL', 'OPENAI_API_KEY'),
    'relay': ('EASEL_LLM_BASE_URL', 'EASEL_LLM_API_KEY'),
    'anthropic': ('ANTHROPIC_BASE_URL', 'ANTHROPIC_API_KEY'),
    'siliconflow': ('SILICONFLOW_BASE_URL', 'SILICONFLOW_API_KEY'),
}


def _valid_base_url(u: str) -> bool:
    '鏁翠覆鏍￠獙锛堜笉鏄彧鐪嬪紑澶达級锛氬繀椤绘槸 http(s)://host锛屼笖涓嶅甫鎺у埗瀛楃涓?URL 鍐呭祵鍑嵁銆?
    if any(c in u for c in '\r\n\t\x00') or '@' in u:
        return False
    try:
        p = urllib.parse.urlparse(u)
    except ValueError:
        return False
    return p.scheme in ('http', 'https') and bool(p.hostname)


def _ssrf_safe(u: str) -> bool:
    """鑷祴浼氬甫鐫€鐪?Key 鍘绘墦杩欎釜鍦板潃锛屾墍浠ヤ笉璁告寚鍚戞湰鏈?鍐呯綉/浜戝厓鏁版嵁鈥斺€?
    杩欎簺鍦板潃涓婄殑鏈嶅姟閫氬父鏃犻壌鏉冿紝涓€鏃﹁褰撴垚銆屾ā鍨嬬鐐广€嶅氨鎴愪簡鎵撳唴缃戠殑璺虫澘銆?""
    try:
        host = urllib.parse.urlparse(u).hostname or ''
        infos = socket.getaddrinfo(host, None)
    except Exception:  # noqa: BLE001  瑙ｆ瀽涓嶄簡灏卞綋涓嶅畨鍏?
        return False
    for info in infos:
        try:
            ip = ipaddress.ip_address(info[4][0])
        except ValueError:
            return False
        if ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_reserved or ip.is_multicast:
            return False
    return True


def _write_env(updates: dict[str, str]) -> None:
    '灏卞湴鏇存柊鍛戒腑鐨?KEY銆佸叾浣欒鍘熸牱淇濈暀锛屾湭鍛戒腑鐨勮拷鍔犳湯灏撅紱绌轰覆鍒欏垹闄よ琛屻€傚師瀛愬啓銆?
    updates = {k: v for k, v in updates.items() if k in _ENV_ALLOWLIST}
    _guard_env_values(updates)
    if not updates:
        return
    lines = ENV_FILE.read_text(encoding='utf-8').splitlines() if ENV_FILE.is_file() else []
    seen = set()
    out = []
    for line in lines:
        s = line.strip()
        matched = None
        if s and not s.startswith('#') and '=' in s:
            k = s.split('=', 1)[0].strip()
            if k in updates:
                matched = k
        if matched is not None:
            seen.add(matched)
            val = updates[matched]
            if val.strip() == '':
                continue
            out.append(f'{matched}={val}')
            continue
        out.append(line)
    appended = [f'{k}={v}' for k, v in updates.items() if k not in seen and v.strip() != '']
    if appended:
        if out and out[-1].strip() != '':
            out.append('')
        out.append('# ---- Easel API keys (added via Web) ----')
        out.extend(appended)
    tmp = ENV_FILE.with_suffix('.env.tmp')
    tmp.write_text('\n'.join(out) + '\n', encoding='utf-8')
    tmp.replace(ENV_FILE)


def _api_spec_status(skill: str, env: dict[str, str]) -> dict:
    '杩斿洖娉ㄥ唽琛ㄩ」 + 姣忎釜 key 褰撳墠閰嶇疆鐘舵€佷笌鑴辨晱鍊硷紙涓嶅洖浼犳槑鏂囷級銆?
    spec = SKILL_API_REQUIREMENTS[skill]

    def key_status(k: dict) -> dict:
        raw = env.get(k['env'], '')
        return {
            'env': k['env'],
            'label': k['label'],
            'required': k['required'],
            'secret': k['secret'],
            'choices': list(k.get('choices', [])),
            'configured': _key_configured(k, env),
            'masked': _mask(raw) if k['secret'] and _is_set(raw) else (raw if not k['secret'] else ''),
        }

    providers = []
    for prov in spec['providers']:
        keys = [key_status(k) for k in prov['keys']]
        providers.append({'id': prov['id'], 'name': prov['name'], 'keys': keys})
    return {
        'label': spec['label'],
        'settings': [key_status(k) for k in spec.get('settings', [])],
        'providers': providers,
    }


def _agent_cwd() -> Path:
    """Agent ????????? OpenClaw workspace???????????"""
    try:
        from easel.openclaw_workspace import workspace_dir
        w = Path(workspace_dir())
        if w.is_dir():
            return w
    except Exception:
        pass
    return PROJECT_ROOT


def run_agent_sync(msg: str, timeout: int = TIMEOUT_DIRECT, session_id: str | None = None) -> str:
    sk = session_id or f'web-{int(time.time() * 1000)}'
    ock = _usk(sk)
    _heal_openclaw_session(ock)   # 娓呮礂鍘嗗彶閲屾棤绛惧悕 thinking 鍧楋紝闃插洖鏀惧け鏁?
    # 閽夋 --session-id 璁?OpenClaw 姣忚疆缁悓涓€ transcript锛堥槻璺ㄥぉ绌洪棽鍚庢柊璧风┖浼氳瘽涓㈠巻鍙诧紝瑙?_openclaw_session_id锛?
    cmd = openclaw_base_cmd() + ['--profile', OPENCLAW_PROFILE, 'agent', '--agent', 'main',
           '--session-key', f'agent:main:{ock}', '--session-id', _openclaw_session_id(ock),
           '--thinking', THINKING_LEVEL,
           '--timeout', str(timeout), '--message', msg]
    # 璺ㄨ繘绋嬮攣锛氬悓涓€浼氳瘽鍚屾椂鍒诲彧璺戜竴涓?openclaw锛岄槻骞跺彂 takeover 宕╂簝锛坮c=1锛?
    xlock = _CrossProcLock(ock)
    if not xlock.acquire(timeout=min(timeout, 300)):
        return '鈴?杩欎釜浼氳瘽姝ｅ湪鍙︿竴涓獥鍙ｈ繍琛岋紝璇风◢鍊欏啀璇?
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, cwd=str(_agent_cwd()), timeout=timeout + 30, env=_proxy_env())
        return clean_agent_output(r.stdout or '') or '锛堟棤杈撳嚭锛?
    except subprocess.TimeoutExpired:
        return '鈴憋笍 璇锋眰瓒呮椂'
    except Exception as e:
        return f'鉂?{e}'
    finally:
        xlock.release()


def check_gateway() -> bool:
    try:
        with urllib.request.urlopen('http://127.0.0.1:18789/healthz', timeout=3) as response:
            return response.status == 200
    except (OSError, urllib.error.URLError):
        return False


def _file_kind(name: str) -> str:
    ext = Path(name).suffix.lower()
    if ext in IMAGE_EXTS:
        return 'image'
    if ext in VIDEO_EXTS:
        return 'video'
    if ext in AUDIO_EXTS:
        return 'audio'
    if ext in TEXT_EXTS:
        return 'text'
    return 'binary'


def _file_meta(f: Path, rel: str) -> dict:
    try:
        st = f.stat()
        mtime, size = int(st.st_mtime), st.st_size
    except OSError:
        mtime, size = 0, 0
    return {'name': f.name, 'path': rel, 'kind': _file_kind(f.name), 'mtime': mtime, 'size': size}


def _read_folder_settings(folder: Path) -> tuple[str, str]:
    """鐩綍鐨?.easel.json 閲屽彧鍙栥€屽睍绀烘爣棰樸€嶅拰銆屾潈闄愩€嶄袱涓瓧娈点€?""
    mf = folder / ".easel.json"
    if not mf.is_file():
        return "", ""
    try:
        data = json.loads(mf.read_text(encoding="utf-8"))
    except Exception:
        return "", ""
    if not isinstance(data, dict):
        return "", ""
    title = data.get("title") if isinstance(data.get("title"), str) else ""
    perm = data.get("perm") if data.get("perm") in ("rw", "ro") else ""
    return title.strip(), perm


def _effective_perm(full: Path) -> str:
    """鐩綍/鏂囦欢鐨勬湁鏁堟潈闄愶細鑷韩鎴栦换涓€涓婄骇涓?ro 鈫?ro锛涘惁鍒?rw銆?""
    root = outputs_dir().resolve()
    try:
        rel = full.resolve().relative_to(root)
    except ValueError:
        return "ro"
    cur = root
    for part in rel.parts:
        cur = cur / part
        if cur.is_dir():
            _, own = _read_folder_settings(cur)
            if own == "ro":
                return "ro"
    return "rw"


def _build_output_node(path: Path, rel: str, inherited_perm: str = "rw") -> dict:
    """閫掑綊鏋勫缓浜х墿鏍戣妭鐐癸細鏂囦欢鈫抐ile 鑺傜偣锛涚洰褰曗啋dir 鑺傜偣锛坈hildren + 閫掑綊 fileCount锛夛拷?"""
    if path.is_dir():
        title, own_perm = _read_folder_settings(path)
        effective = "ro" if inherited_perm == "ro" or own_perm == "ro" else "rw"
        children = []
        for c in sorted(path.iterdir()):
            if c.name.startswith('.'):   # 宓屽灞傚彧璺抽殣钘忔枃浠讹紱_base.mp4 绛変互 _ 寮€澶寸殑浜х墿瑕佷繚锟?
                continue
            children.append(_build_output_node(c, f'{rel}/{c.name}', effective))
        mtime = max((x['mtime'] for x in children), default=int(path.stat().st_mtime))
        file_count = sum(x.get('fileCount', 1) if x['type'] == 'dir' else 1 for x in children)
        return {'name': path.name, 'type': 'dir', 'path': rel, 'mtime': mtime,
                'children': children, 'fileCount': file_count,
                'title': title, 'perm': own_perm or 'rw', 'effectivePerm': effective}
    m = _file_meta(path, rel)
    m['type'] = 'file'
    return m


def _read_project_meta(proj: Path) -> dict:
    """璇婚」鐩洰褰曠殑 .easel.json 灞曠ず澶达紝闄勫皝闈?鎴愬搧鐨勮В鏋愯矾寰勪緵鍓嶇瀵屽睍绀恒€?

    鍙彇灞曠ず鐩稿叧瀛楁锛堜笉鍚紪鎺?steps锛夈€俢over 瑙ｆ瀽浼樺厛绾э細
    灞曠ず澶村０鏄庣殑 cover 鈫?棣栦釜鎴愬搧濯掍綋 鈫?鐩綍鍐呴寮犲浘/瑙嗛锛堝厹搴曪級銆?
    """
    mf = proj / ".easel.json"
    if not mf.is_file():
        return {}
    try:
        data = json.loads(mf.read_text(encoding="utf-8"))
    except Exception:
        return {}
    meta = {k: data.get(k) for k in
            ("title", "summary", "platform", "kind", "status", "tags", "deliverables")
            if data.get(k) not in (None, "", [])}
    if not meta:
        return {}

    def _rel_if_exists(name: str) -> str:
        return f"{proj.name}/{name}" if name and (proj / name).is_file() else ""

    # 灏侀潰瑙ｆ瀽
    cover_rel = ""
    declared = data.get("cover")
    if declared and (proj / declared).is_file():
        cover_rel = f"{proj.name}/{declared}"
    if not cover_rel:
        for d in (data.get("deliverables") or []):
            if _file_kind(d) in ("image", "video") and (proj / d).is_file():
                cover_rel = f"{proj.name}/{d}"
                break
    if cover_rel:
        meta["cover"] = cover_rel
    # 鎴愬搧璺緞锛堝墠绔€屾垚鍝佸尯銆嶉珮浜敤锛夛細瑙ｆ瀽涓?outputs 鐩稿璺緞锛屽彧鐣欑湡瀹炲瓨鍦ㄧ殑
    meta["deliverablePaths"] = [f"{proj.name}/{d}" for d in (data.get("deliverables") or [])
                                if (proj / d).is_file()]
    return meta


def get_output_tree() -> list[dict]:
    if not outputs_dir().is_dir():
        return []
    items = []
    for e in sorted(outputs_dir().iterdir()):
        # 鍐呭搴撳彧灞曠ず銆岄」鐩洰褰曘€嶏細璺宠繃绯荤粺鐩綍(_login/_publish/...)銆侀殣钘忛」銆?
        # 浠ュ強鏍圭洰褰曟暎鏂囦欢锛堟寜鏂拌绾︿骇鐗╁繀鍦ㄩ」鐩洰褰曞唴锛屾牴鏁ｆ枃浠?绯荤粺鐘舵€?娈嬫福锛夈€?
        if e.name.startswith('.') or e.name.startswith('_'):
            continue
        if not e.is_dir() or e.name in SYSTEM_TOPLEVEL_DIRS:
            continue
        node = _build_output_node(e, e.name)
        meta = _read_project_meta(e)
        if meta:
            node['meta'] = meta
        items.append(node)
    # 鎸夋渶鍚庝慨鏀规椂闂村€掑簭锛氭渶杩戜骇鐗╂帓鏈€鍓嶏紙渚涘伐浣滃彴銆屾渶杩戜骇鐗┿€嶄笌鍐呭搴撴椂闂存帓搴忥級
    return sorted(items, key=lambda x: x.get('mtime', 0), reverse=True)


def _safe_output_path(rel: str) -> Path:
    '鎶婄浉瀵硅矾寰勮В鏋愬埌 outputs/ 鍐咃紝闃茶矾寰勭┛瓒娿€?
    full = (outputs_dir() / rel).resolve()
    root = outputs_dir().resolve()
    if root != full and root not in full.parents:
        raise HTTPException(403, '闈炴硶璺緞')
    if not full.is_file():
        raise HTTPException(404, '鏂囦欢涓嶅瓨鍦?)
    return full


@app.get("/")
async def index():
    no_cache = {"Cache-Control": "no-cache, no-store, must-revalidate", "Pragma": "no-cache"}
    react_index = REACT_DIR / "index.html"
    if react_index.is_file():
        return FileResponse(react_index, media_type="text/html", headers=no_cache)
    return FileResponse(STATIC_DIR / "index.html", media_type="text/html", headers=no_cache)


@app.get("/onepage")
async def onepage():
    return FileResponse(STATIC_DIR / "onepage.html", media_type="text/html")


@app.get("/assets/{path:path}")
async def react_assets(path: str):
    base = (REACT_DIR / "assets").resolve()
    fp = (REACT_DIR / "assets" / path).resolve()
    if base != fp and base not in fp.parents:
        raise HTTPException(403, "闈炴硶璺緞")
    if not fp.is_file():
        raise HTTPException(404)
    return FileResponse(fp, headers={"Cache-Control": "public, max-age=31536000, immutable"})


@app.get("/static/{path:path}")
async def static_file(path: str):
    base = STATIC_DIR.resolve()
    fp = (STATIC_DIR / path).resolve()
    if base != fp and base not in fp.parents:
        raise HTTPException(403, "闈炴硶璺緞")
    if not fp.is_file():
        raise HTTPException(404)
    # HTML entrypoints must not be cached: the intro page is edited in-place during local development.
    headers = {"Cache-Control": "no-cache, no-store, must-revalidate", "Pragma": "no-cache"} if fp.suffix.lower() in {".html", ".htm"} else {}
    return FileResponse(fp, headers=headers)


@app.get("/api/status")
