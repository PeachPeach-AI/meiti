@app.get("/api/persona/{name}")
async def api_persona(name: str):
    text = load_profile_text(name)
    if not text:
        raise HTTPException(404, "鐢诲儚涓嶅瓨鍦?)
    return {"name": name, "content": text}


def _valid_persona_name(name: str) -> bool:
    return bool(name) and "/" not in name and "\\" not in name and not name.startswith((".", "_"))


def _persona_file_path(name: str, filename: str) -> Path:
    """鏍￠獙鐢诲儚鍚?鏂囦欢鍚嶏紝杩斿洖 profiles/<name>/<filename> 鐨勫畨鍏ㄨ矾寰勩€?""
    if not _valid_persona_name(name):
        raise HTTPException(400, "鐢诲儚鍚嶉潪娉?)
    if not filename.endswith(".md") or "/" in filename or "\\" in filename or filename.startswith("."):
        raise HTTPException(400, "鏂囦欢鍚嶉潪娉?)
    pd = (profiles_dir() / name).resolve()
    fp = (pd / filename).resolve()
    if pd != fp.parent or profiles_dir().resolve() not in pd.parents:
        raise HTTPException(403, "闈炴硶璺緞")
    return fp


@app.get("/api/persona/{name}/files")
async def api_persona_files(name: str):
    """杩斿洖鐢诲儚鍏淮鏂囦欢鍘熸枃锛堟寜鍥哄畾椤哄簭 + 鍏朵綑 .md锛夛紝渚涘湪绾跨紪杈戙€?""
    if not profile_exists(name):
        raise HTTPException(404, "鐢诲儚涓嶅瓨鍦?)
    pd = profiles_dir() / name
    ordered = list(_FILE_ORDER) + sorted(f.name for f in pd.glob("*.md") if f.name not in _FILE_ORDER)
    files = []
    for fn in ordered:
        fp = pd / fn
        files.append({"filename": fn, "content": fp.read_text(encoding="utf-8") if fp.is_file() else ""})
    return {"name": name, "files": files}


class PersonaFileRequest(BaseModel):
    filename: str
    content: str


@app.put("/api/persona/{name}/file")
async def api_persona_file_save(name: str, req: PersonaFileRequest):
    """淇濆瓨鐢诲儚鍗曚釜缁村害鏂囦欢锛堝師瀛愬啓锛夈€?""
    if not profile_exists(name):
        raise HTTPException(404, "鐢诲儚涓嶅瓨鍦?)
    fp = _persona_file_path(name, req.filename)
    tmp = fp.with_suffix(".md.tmp")
    tmp.write_text(req.content, encoding="utf-8")
    tmp.replace(fp)
    return {"ok": True, "filename": req.filename}


@app.get("/api/persona/{name}/cover")
async def api_persona_cover(name: str):
    """鐢诲儚灏侀潰鍥撅紙瀛樹簬 profiles/<name>/cover.<ext>锛夈€?""
    if not _valid_persona_name(name):
        raise HTTPException(400, "鐢诲儚鍚嶉潪娉?)
    p = _persona_cover_path(name)
    if not p:
        raise HTTPException(404, "鏈缃皝闈?)
    return FileResponse(p, headers={"Cache-Control": "no-cache, no-store, must-revalidate"})


@app.post("/api/persona/{name}/cover")
async def api_persona_cover_upload(name: str, file: UploadFile = File(...)):
    """涓婁紶/鏇挎崲鐢诲儚灏侀潰锛堜粎鍥剧墖锛夈€?""
    if not _valid_persona_name(name):
        raise HTTPException(400, "鐢诲儚鍚嶉潪娉?)
    d = profiles_dir() / name
    if not d.is_dir():
        raise HTTPException(404, "鐢诲儚涓嶅瓨鍦?)
    ext = Path(file.filename or "").suffix.lower()
    if ext not in IMAGE_EXTS:
        raise HTTPException(400, "浠呮敮鎸佸浘鐗囨枃浠讹紙png/jpg/webp/gif鈥︼級")
    data = await file.read()
    if len(data) > 8 * 1024 * 1024:
        raise HTTPException(413, "灏侀潰瓒呰繃 8MB 涓婇檺")
    for old in d.glob("cover.*"):
        try:
            old.unlink()
        except OSError:
            pass
    (d / f"cover{ext}").write_bytes(data)
    return {"ok": True}


@app.delete("/api/persona/{name}/cover")
async def api_persona_cover_delete(name: str):
    """鍒犻櫎鐢诲儚灏侀潰锛堝洖閫€鍒伴粯璁ゆ笎鍙樺皝闈級銆?""
    if not _valid_persona_name(name):
        raise HTTPException(400, "鐢诲儚鍚嶉潪娉?)
    d = profiles_dir() / name
    for old in d.glob("cover.*"):
        try:
            old.unlink()
        except OSError:
            pass
    return {"ok": True}


@app.delete("/api/persona/{name}")
async def api_persona_delete(name: str):
    """鍒犻櫎鏁翠釜鐢诲儚鐩綍銆?""
    if not _valid_persona_name(name):
        raise HTTPException(400, "鐢诲儚鍚嶉潪娉?)
    pd = (profiles_dir() / name).resolve()
    if profiles_dir().resolve() not in pd.parents or not pd.is_dir():
        raise HTTPException(404, "鐢诲儚涓嶅瓨鍦?)
    import shutil
    shutil.rmtree(pd)
    return {"ok": True, "deleted": name}


@app.get("/api/skills")
async def api_skills():
    return get_skills()


@app.post("/api/skills/upload")
async def api_skills_upload(file: UploadFile = File(...)):
    """涓婁紶 zip 鎶€鑳藉寘锛氳В鍘嬪埌 skills/openclaw/<name>/锛屾牎楠?SKILL.md锛屽苟鍚屾鍒?OpenClaw workspace銆?""
    if not (file.filename or "").lower().endswith(".zip"):
        raise HTTPException(400, "鍙敮鎸?.zip 鎶€鑳藉寘")
    data = await file.read()
    try:
        zf = zipfile.ZipFile(io.BytesIO(data))
    except Exception:
        raise HTTPException(400, "鏃犳硶璇诲彇 zip 鏂囦欢锛堟崯鍧忥紵锛?)
    names = [n for n in zf.namelist() if n and not n.endswith("/") and "__MACOSX" not in n]
    if not names:
        raise HTTPException(400, "zip 鍐呭涓虹┖")
    has_root = any(n == "SKILL.md" for n in names)
    tops = {n.split("/", 1)[0] for n in names if "/" in n}
    if has_root:
        skill_name = re.sub(r"[^a-z0-9\-]+", "-", Path(file.filename).stem.lower()).strip("-") or "uploaded-skill"
        prefix = ""
    elif len(tops) == 1 and any(n == f"{next(iter(tops))}/SKILL.md" for n in names):
        skill_name = next(iter(tops))
        prefix = skill_name + "/"
    else:
        raise HTTPException(400, "鎶€鑳藉寘闇€鍖呭惈 <鎶€鑳藉悕>/SKILL.md锛堟垨鍦ㄦ牴鐩綍鏀?SKILL.md锛?)
    skill_name = re.sub(r"[^a-zA-Z0-9\-_]+", "-", skill_name).strip("-") or "uploaded-skill"
    dest = SKILLS_DIR / "openclaw" / skill_name
    if dest.exists():
        shutil.rmtree(dest)
    dest.mkdir(parents=True, exist_ok=True)
    root = dest.resolve()
    for n in names:
        if prefix and not n.startswith(prefix):
            continue
        rel = n[len(prefix):] if prefix else n
        if not rel:
            continue
        target = (dest / rel).resolve()
        if root not in target.parents and target != root:
            shutil.rmtree(dest, ignore_errors=True)
            raise HTTPException(400, "zip 鍚潪娉曡矾寰?)
        target.parent.mkdir(parents=True, exist_ok=True)
        with zf.open(n) as src, open(target, "wb") as out:
            shutil.copyfileobj(src, out)
    if not (dest / "SKILL.md").is_file():
        shutil.rmtree(dest, ignore_errors=True)
        raise HTTPException(400, "鏈壘鍒?SKILL.md")
    synced = False
    try:
        from easel.openclaw_workspace import workspace_dir
        ws = Path(workspace_dir()) / "skills"
        ws.mkdir(parents=True, exist_ok=True)
        shutil.copytree(dest, ws / skill_name, dirs_exist_ok=True)
        synced = True
    except Exception:
        pass
    desc, layer, _ = _parse_skill_md(dest / "SKILL.md")
    return {"ok": True, "name": skill_name, "description": desc, "layer": layer, "synced": synced}


@app.get("/api/skill/{name}")
async def api_skill_detail(name: str):
    """鍗曚釜 SKILL 璇︽儏锛氭弿杩?+ 姝ｆ枃 + API 闇€姹備笌褰撳墠閰嶇疆鐘舵€侊紙鑴辨晱锛夈€?""
    full = find_skill(name)
    if full is None:
        raise HTTPException(404, f"SKILL '{name}' 涓嶅瓨鍦?)
    desc, layer, body = _parse_skill_md(SKILLS_DIR / "openclaw" / full / "SKILL.md")
    needs_api = full in SKILL_API_REQUIREMENTS
    env = _read_env()
    return {
        "name": full,
        "layer": layer,
        "description": desc,
        "body": body,
        "needsApi": needs_api,
        "apiConfigured": _skill_api_configured(full, env) if needs_api else True,
        "apiSpec": _api_spec_status(full, env) if needs_api else None,
    }


class EnvUpdateRequest(BaseModel):
    updates: dict[str, str]


@app.post("/api/env")
async def api_env_save(req: EnvUpdateRequest):
    """鍐?API key 鍒伴」鐩牴 .env锛堜粎鍏佽娉ㄥ唽琛ㄥ唴 env 鍚嶏級銆傝繑鍥炴洿鏂板悗鍚?skill 鐨勯厤缃姸鎬併€?""
    bad = [k for k in (req.updates or {}) if k not in _ENV_ALLOWLIST]
    if bad:
        raise HTTPException(400, f"涓嶅厑璁稿啓鍏ョ殑鍙橀噺锛歿', '.join(bad)}")
    _write_env(req.updates or {})
    env = _read_env()
    return {
        "ok": True,
        "skills": {s: _skill_api_configured(s, env) for s in SKILL_API_REQUIREMENTS},
    }


