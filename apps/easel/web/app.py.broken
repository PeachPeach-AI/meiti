# ---- 寰俊鍏紬鍙凤紙wechat-oa锛夊嚟璇佸紡鎺ュ叆 ----
# 澶嶇敤 skill-wechat-publisher 鐨勫彂甯冨紩鎿庝笌閰嶇疆锛氬嚟璇佸瓨鍦ㄥ叾 wechat-publisher.yaml锛?
# 鍙戝竷/鍙栨暟鑴氭湰閮戒粠杩欓噷璇昏处鍙枫€倃eb 渚х粺涓€鐢ㄨ处鍙?key "web"銆?
WECHAT_SKILL_DIR = PROJECT_ROOT / "skills" / "openclaw" / "skill-wechat-publisher"
WECHAT_SKILL_SCRIPTS = WECHAT_SKILL_DIR / "scripts"
WECHAT_PUBLISH_SCRIPT = WECHAT_SKILL_SCRIPTS / "publish.py"
WECHAT_CONFIG_YAML = WECHAT_SKILL_DIR / "wechat-publisher.yaml"
WECHAT_WEB_ACCOUNT = "web"   # web 绔厤缃啓鍏?璇诲彇鐨勮处鍙?key

# ---- 鑷缓绔欙紙Typecho / WordPress锛夎处鍙峰瘑鐮佸紡鎺ュ叆 ----
# 鍑瘉锛氱珯鐐瑰湴鍧€ + 鐢ㄦ埛鍚?+ 瀵嗙爜锛圵ordPress 鐢ㄣ€屽簲鐢ㄥ瘑鐮併€嶏級銆?
# WordPress 璧?REST /wp-json/wp/v2/posts锛汿ypecho 璧?XML-RPC /action/xmlrpc锛坢etaWeblog锛夈€?
CMS_PLATFORMS = ("wordpress", "typecho")


def _cms_load() -> dict:
    if not cms_config().is_file():
        return {}
    try:
        d = json.loads(cms_config().read_text(encoding="utf-8"))
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def _cms_get(platform: str) -> dict:
    return _cms_load().get(platform) or {}


def _cms_save(platform: str, cfg: dict) -> None:
    d = _cms_load()
    d[platform] = cfg
    tmp = cms_config().with_suffix(".json.tmp")
    tmp.write_text(json.dumps(d, ensure_ascii=False, indent=2), encoding="utf-8")
    tmp.replace(cms_config())


def _cms_has(platform: str) -> bool:
    a = _cms_get(platform)
    return bool(a.get("siteUrl") and a.get("username") and a.get("secret"))


def _cms_norm_url(site: str) -> str:
    """瑙勮寖鍖栫珯鐐瑰湴鍧€锛氱己鍗忚琛?https://锛屽幓灏鹃儴鏂滄潬銆?""
    s = (site or "").strip()
    if not s:
        return ""
    if not re.match(r"^https?://", s, re.I):
        s = "https://" + s
    return s.rstrip("/")


def _cms_verify(platform: str, acc: dict) -> tuple[bool, str]:
    site = _cms_norm_url(acc.get("siteUrl"))
    user = acc.get("username") or ""
    secret = acc.get("secret") or ""
    if not site or not user or not secret:
        return False, "绔欑偣鍦板潃 / 鐢ㄦ埛鍚?/ 瀵嗙爜閮借濉啓"
    try:
        if platform == "wordpress":
            auth = base64.b64encode(f"{user}:{secret}".encode()).decode()
            req = urllib.request.Request(site + "/wp-json/wp/v2/users/me",
                                         headers={"Authorization": "Basic " + auth})
            with urllib.request.urlopen(req, timeout=20) as r:
                d = json.loads(r.read().decode("utf-8"))
            return True, "楠岃瘉閫氳繃锛? + (d.get("name") or user) + "锛?
        if platform == "typecho":
            import xmlrpc.client
            endpoints = [site + "/action/xmlrpc", site + "/index.php/action/xmlrpc"]
            err = None
            for ep in endpoints:
                try:
                    proxy = xmlrpc.client.ServerProxy(ep, allow_none=True)
                    proxy.metaWeblog.getRecentPosts("1", user, secret, 1)
                    return True, "楠岃瘉閫氳繃锛? + ep + "锛?
                except Exception as e:  # noqa: BLE001
                    err = e
            return False, f"{err}锛堣纭绔欑偣鍦板潃姝ｇ‘銆佸悗鍙板凡寮€鍚?XML-RPC锛涘湴鍧€闇€鍚?http(s)://锛?
    except urllib.error.HTTPError as e:
        return False, f"HTTP {e.code}锛堣妫€鏌ヨ处鍙峰瘑鐮?/ 搴旂敤瀵嗙爜涓庣珯鐐瑰湴鍧€锛?
    except Exception as e:  # noqa: BLE001
        return False, str(e)
    return False, "鏈煡骞冲彴"


def _cms_publish(platform: str, title: str, body: str, tags: str = "") -> dict:
    acc = _cms_get(platform)
    if not _cms_has(platform):
        return {"ok": False, "message": "鏈厤缃绔欑偣璐﹀彿"}
    site = _cms_norm_url(acc.get("siteUrl"))
    user = acc.get("username") or ""
    secret = acc.get("secret") or ""
    try:
        if platform == "wordpress":
            payload: dict = {"title": title, "content": body, "status": "publish"}
            if tags:
                payload["tags_input"] = [t.strip().lstrip("#") for t in re.split("[,锛?]", tags) if t.strip()]
            req = urllib.request.Request(
                site + "/wp-json/wp/v2/posts", data=json.dumps(payload).encode("utf-8"), method="POST",
                headers={"Content-Type": "application/json",
                         "Authorization": "Basic " + base64.b64encode(f"{user}:{secret}".encode()).decode()})
            with urllib.request.urlopen(req, timeout=40) as r:
                d = json.loads(r.read().decode("utf-8"))
            return {"ok": True, "message": "宸插彂甯冨埌 WordPress", "url": d.get("link", "")}
        if platform == "typecho":
            import xmlrpc.client
            err = None
            for ep in (site + "/action/xmlrpc", site + "/index.php/action/xmlrpc"):
                try:
                    proxy = xmlrpc.client.ServerProxy(ep, allow_none=True)
                    pid = proxy.metaWeblog.newPost(
                        "1", user, secret,
                        {"title": title, "description": body, "mt_keywords": tags or ""}, True)
                    return {"ok": True, "message": f"宸插彂甯冨埌 Typecho锛坕d {pid}锛?, "url": ""}
                except Exception as e:  # noqa: BLE001
                    err = e
            return {"ok": False, "message": str(err)}
    except urllib.error.HTTPError as e:
        try:
            msg = e.read().decode("utf-8")[:300]
        except Exception:  # noqa: BLE001
            msg = str(e)
        return {"ok": False, "message": f"HTTP {e.code}: {msg}"}
    except Exception as e:  # noqa: BLE001
        return {"ok": False, "message": str(e)}
    return {"ok": False, "message": "鏈煡骞冲彴"}


_ws_sync_lock = threading.Lock()
_ws_sync_at: dict[str, float] = {}


def _workspace_outputs_dir() -> Path | None:
    """OpenClaw 宸ヤ綔鍖虹殑 outputs/锛圓gent 瀹為檯鍐欎骇鐗╃殑鍦版柟锛夈€?""
    try:
        from easel.openclaw_workspace import workspace_dir
        p = Path(workspace_dir()) / "outputs"
        return p if p.is_dir() else None
    except Exception:  # noqa: BLE001
        return None


def _copy_tree_newer(src: Path, dest: Path) -> None:
    dest.mkdir(parents=True, exist_ok=True)
    for e in src.iterdir():
        if e.name.startswith("."):
            continue
        t = dest / e.name
        try:
            if e.is_dir():
                _copy_tree_newer(e, t)
            elif e.is_file() and (not t.exists() or e.stat().st_mtime > t.stat().st_mtime):
                shutil.copy2(e, t)
        except OSError:
            continue


def _sync_workspace_outputs() -> None:
    """鎶?Agent 宸ヤ綔鍖?outputs/ 鐨勪骇鐗╁閲忓悓姝ヨ繘褰撳墠璐﹀彿鍐呭搴擄紙闄愰 3s锛夈€?""
    src = _workspace_outputs_dir()
    if src is None:
        return
    dest = outputs_dir()
    try:
        if src.resolve() == dest.resolve():
            return
    except OSError:
        return
    key = str(dest)
    now = time.time()
    with _ws_sync_lock:
        if now - _ws_sync_at.get(key, 0.0) < 3:
            return
        _ws_sync_at[key] = now
        try:
            for e in src.iterdir():
                if e.name.startswith(".") or e.name.startswith("_") or e.name in SYSTEM_TOPLEVEL_DIRS:
                    continue
                if e.is_dir():
                    _copy_tree_newer(e, dest / e.name)
                elif e.is_file() and (not (dest / e.name).exists()
                                      or e.stat().st_mtime > (dest / e.name).stat().st_mtime):
                    shutil.copy2(e, dest / e.name)
        except OSError:
            pass


_CHAT_OUTPUT_DIRS: dict[str, Path] = {}
_CHAT_OUTPUT_LOCK = threading.Lock()


def _adopt_workspace_outputs(session_id: str | None = None) -> None:
    src = _workspace_outputs_dir()
    if src is None:
        return
    items = [e for e in src.iterdir()
             if not (e.name.startswith(".") or e.name.startswith("_") or e.name in SYSTEM_TOPLEVEL_DIRS)]
    if not items:
        return
    dest = outputs_dir()
    try:
        if src.resolve() == dest.resolve():
            return
    except OSError:
        return
    if session_id:
        key = f"{dest}|{session_id}"
        with _CHAT_OUTPUT_LOCK:
            target = _CHAT_OUTPUT_DIRS.get(key)
            if target is None or not target.is_dir():
                base = f"浼氳瘽-{time.strftime('%Y%m%d-%H%M%S')}"
                target = dest / base
                n = 2
                while target.exists():
                    target = dest / f"{base}-{n}"
                    n += 1
                target.mkdir(parents=True, exist_ok=True)
                _CHAT_OUTPUT_DIRS[key] = target
    else:
        base = f"浼氳瘽-{time.strftime('%Y%m%d-%H%M%S')}"
        target = dest / base
        n = 2
        while target.exists():
            target = dest / f"{base}-{n}"
            n += 1
        target.mkdir(parents=True, exist_ok=True)
    for e in items:
        dst = target / e.name
        try:
            if dst.exists() and _effective_perm(dst) == 'ro':
                continue
            if not dst.exists() and _effective_perm(target) == 'ro':
                continue
            if e.is_dir():
                _copy_tree_newer(e, dst)
                shutil.rmtree(e, ignore_errors=True)
            elif e.is_file():
                if dst.exists() and dst.stat().st_mtime >= e.stat().st_mtime:
                    e.unlink()
                else:
                    shutil.copy2(e, dst)
                    e.unlink()
        except OSError:
            continue


def _latest_content_text() -> str:
    """娌″湪鏃ュ巻閲屽～姝ｆ枃鏃讹紝鍙栧唴瀹瑰簱锛坥utputs锛夐噷鏈€鏂扮殑 .md 浣滀负姝ｆ枃銆?""
    try:
        files = [p for p in outputs_dir().rglob("*.md") if p.is_file() and "_login" not in p.parts]
        if not files:
            return ""
        p = max(files, key=lambda x: x.stat().st_mtime)
        return p.read_text(encoding="utf-8", errors="ignore")
    except Exception:  # noqa: BLE001
        return ""


def _run_due_cms() -> None:
    """鎵弿鏃ュ巻锛氬埌鏈熺殑 Typecho/WordPress 鏉＄洰鑷姩鍙戝竷锛沝aily 鏉＄洰鍙戝竷鍚庨『寤跺埌鏄庡ぉ銆?""
    items = _read_schedule()
    if not items:
        return
    now = datetime.now()
    today = now.strftime("%Y-%m-%d")
    hhmm = now.strftime("%H:%M")
    changed = False
    label2key = {"WordPress": "wordpress", "Typecho": "typecho"}
    for it in items:
        pf = label2key.get(it.get("platform") or "", it.get("platform") or "")
        if it.get("status") != "scheduled" or pf not in CMS_PLATFORMS:
            continue
        date = it.get("date") or ""
        if not date or date > today:
            continue
        if date == today and (it.get("time") or "00:00") > hhmm:
            continue
        if it.get("last_published_at", "").startswith(today) and it.get("repeat") != "daily":
            continue
        title = it.get("title") or "鏈懡鍚?
        body = it.get("body") or ""
        if not body:
            body = _latest_content_text()
        r = _cms_publish(pf, title, body, "")
        stamp = now.strftime("%Y-%m-%d %H:%M")
        if r.get("ok"):
            it["url"] = r.get("url", "") or it.get("url", "")
            it["note"] = ((it.get("note") or "") + f"\n[鑷姩鍙戝竷 {stamp}] " + (r.get("message") or "")).strip()
            it["last_published_at"] = now.isoformat(timespec="seconds")
            if it.get("repeat") == "daily":
                it["date"] = (now + timedelta(days=1)).strftime("%Y-%m-%d")
                it["status"] = "scheduled"
            else:
                it["status"] = "published"
        else:
            it["note"] = ((it.get("note") or "") + f"\n[鑷姩鍙戝竷澶辫触 {stamp}] " + (r.get("message") or "")).strip()
            it["last_published_at"] = now.isoformat(timespec="seconds")
        changed = True
    if changed:
        _write_schedule(items)


async def _cms_scheduler() -> None:
    while True:
        try:
            await asyncio.to_thread(_run_due_cms)
        except Exception:  # noqa: BLE001
            pass
        await asyncio.sleep(60)



def _wechat_load_yaml() -> dict:
    """璇?wechat-publisher.yaml锛堜笉瀛樺湪鎴栨崯鍧忓垯杩斿洖绌?dict锛夈€?""
    if not WECHAT_CONFIG_YAML.is_file():
        return {}
    try:
        import yaml
        data = yaml.safe_load(WECHAT_CONFIG_YAML.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _wechat_web_account() -> dict:
    """杩斿洖 web 绔厤缃殑鍏紬鍙疯处鍙凤紙accounts.web锛夛紝鏃犲垯绌?dict銆?""
    cfg = _wechat_load_yaml()
    accts = cfg.get("accounts") if isinstance(cfg.get("accounts"), dict) else {}
    acc = accts.get(WECHAT_WEB_ACCOUNT)
    return acc if isinstance(acc, dict) else {}


def _wechat_has_credentials() -> bool:
    acc = _wechat_web_account()
    return bool(acc.get("app_id") and acc.get("app_secret"))


def _wechat_save_credentials(app_id: str, app_secret: str, name: str = "", author: str = "") -> None:
    """鎶?AppID/AppSecret 鍐欏叆 wechat-publisher.yaml 鐨?accounts.web锛堝師瀛愬啓锛屼繚鐣欏叾瀹冭处鍙凤級銆?""
    import yaml
    cfg = _wechat_load_yaml()
    if not isinstance(cfg.get("accounts"), dict):
        cfg["accounts"] = {}
    acc = cfg["accounts"].get(WECHAT_WEB_ACCOUNT)
    if not isinstance(acc, dict):
        acc = {}
    acc["name"] = name or acc.get("name") or "寰俊鍏紬鍙?
    acc["app_id"] = app_id
    acc["app_secret"] = app_secret
    if author:
        acc["author"] = author
    acc.setdefault("author", "")
    cfg["accounts"][WECHAT_WEB_ACCOUNT] = acc
    # web 璐﹀彿瀛樺湪鍗宠涓洪粯璁わ紝鏂逛究 CLI 鐩存帴鐢?
    cfg.setdefault("default", WECHAT_WEB_ACCOUNT)
    WECHAT_CONFIG_YAML.parent.mkdir(parents=True, exist_ok=True)
    tmp = WECHAT_CONFIG_YAML.with_suffix(".yaml.tmp")
    tmp.write_text(yaml.safe_dump(cfg, allow_unicode=True, sort_keys=False), encoding="utf-8")
    os.replace(tmp, WECHAT_CONFIG_YAML)


def _wechat_clear_credentials() -> None:
    """鍒犻櫎 accounts.web 鍙婂叾 token 缂撳瓨銆?""
    import yaml
    cfg = _wechat_load_yaml()
    accts = cfg.get("accounts")
    if isinstance(accts, dict) and WECHAT_WEB_ACCOUNT in accts:
        accts.pop(WECHAT_WEB_ACCOUNT, None)
        if cfg.get("default") == WECHAT_WEB_ACCOUNT:
            cfg["default"] = next(iter(accts), "") if accts else ""
        try:
            tmp = WECHAT_CONFIG_YAML.with_suffix(".yaml.tmp")
            tmp.write_text(yaml.safe_dump(cfg, allow_unicode=True, sort_keys=False), encoding="utf-8")
            os.replace(tmp, WECHAT_CONFIG_YAML)
        except Exception:
            pass
    for cache in (WECHAT_SKILL_SCRIPTS / f".token_cache_{WECHAT_WEB_ACCOUNT}.json",
                  WECHAT_SKILL_SCRIPTS / ".token_cache.json"):
        try:
            cache.unlink()
        except OSError:
            pass


def _wechat_verify_token() -> tuple[bool, str]:
    """鐢ㄥ綋鍓?accounts.web 鍑瘉璋冨畼鏂?token 鎺ュ彛楠岃瘉銆傝繑鍥?(ok, message)銆?
    鍦ㄥ瓙杩涚▼閲岃窇锛岄伩鍏嶆妸 skill 鐨?import 鍓綔鐢ㄥ甫杩?web 杩涚▼銆?""
    code = (
        "import sys; sys.path.insert(0, %r)\n"
        "from config import set_account\n"
        "from wechat_token import get_access_token\n"
        "set_account(%r)\n"
        "try:\n"
        "    t = get_access_token(force_refresh=True)\n"
        "    print('OK' if t else 'EMPTY')\n"
        "except Exception as e:\n"
        "    print('ERR:' + str(e))\n"
    ) % (str(WECHAT_SKILL_SCRIPTS), WECHAT_WEB_ACCOUNT)
    try:
        proc = subprocess.run([sys.executable, "-c", code], cwd=str(WECHAT_SKILL_SCRIPTS),
                              env=_wechat_env(), capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        return False, "楠岃瘉瓒呮椂锛堢綉缁滄垨 IP 鐧藉悕鍗曢棶棰橈級"
    out = (proc.stdout or "").strip().splitlines()
    last = out[-1] if out else ""
    if last == "OK":
        return True, ""
    if last.startswith("ERR:"):
        return False, last[4:].strip()[:200]
    err = (proc.stderr or "").strip().splitlines()[-1:] or ["楠岃瘉澶辫触"]
    return False, err[0][:200]


def _k(env, label, required=True, secret=True, aliases=None):
    return {"env": env, "label": label, "required": required, "secret": secret, "aliases": aliases or []}


def _model_spec(group: str, label: str | None = None) -> dict:
    spec = model_group(group)
    return {
        "label": label or spec["label"],
        "settings": spec.get("settings", []),
        "providers": spec["providers"],
    }


def _short_drama_spec() -> dict:
    """Image is required; video and cloud voice settings remain optional enhancements."""
    image = model_group("image")
    optional = []
    for group_name in ("video", "voice"):
        group = model_group(group_name)
        optional.extend({**key, "required": False} for key in group.get("settings", []))
        for provider in group["providers"]:
            optional.extend({**key, "required": False} for key in provider["keys"])
    seen = set()
    optional = [key for key in optional if not (key["env"] in seen or seen.add(key["env"]))]
    return {
        "label": "AI 鐭墽锛堢敓鍥惧繀闇€ + 鐢熻棰?浜戦厤闊冲彲閫夛級",
        "settings": [],
        "providers": [{
            "id": "drama",
            "name": "鍏抽敭甯х敓鍥撅紙蹇呴渶锛? 瑙嗛鐢熸垚涓庨棴婧愰厤闊筹紙鍙€夛級",
            "keys": [*image["providers"][0]["keys"], *optional],
        }],
    }

SKILL_API_REQUIREMENTS: dict[str, dict] = {
    "ai-image-gen": _model_spec("image"),
    "ecom-details-image": _model_spec("image", "鐢靛晢閰嶅浘锛圓I 鐢熷浘锛?),
    "ai-video-gen": _model_spec("video"),
    "ai-music": _model_spec("music"),
    "voice-clone": _model_spec("voice", "澹伴煶鍏嬮殕 / 浜戠 TTS"),
    # AI 鐭墽锛氱紪鎺?ai-image-gen(鍏抽敭甯?蹇呴渶) + ai-video-gen(鐢熻棰?鍙€?缂哄垯閫€鍖栧浘鐗囩煭鍓?銆?
    # 浠ョ敓鍥句负銆屽凡閰嶇疆銆嶅熀绾匡紙缂虹敓鍥炬棤娉曞嚭鍏抽敭甯э級锛涚敓瑙嗛 key 鍚屾鍙€夊～锛屼篃鍙湪 ai-video-gen 鍗＄墖閰嶃€?
    "short-drama": _short_drama_spec(),
