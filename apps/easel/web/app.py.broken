def _ensure(d: Path) -> Path:
    try:
        d.mkdir(parents=True, exist_ok=True)
    except OSError:
        pass
    return d


def user_root() -> Path:
    return _ensure(USERS_DIR / (CURRENT_UID.get() or "_public"))


def profiles_dir() -> Path:
    return _ensure(user_root() / "profiles")


def outputs_dir() -> Path:
    return _ensure(user_root() / "outputs")


def login_dir() -> Path:
    return _ensure(outputs_dir() / "_login")


def publish_dir() -> Path:
