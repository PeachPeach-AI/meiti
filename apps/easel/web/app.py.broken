@app.get("/api/output/{path:path}")
async def api_output(path: str):
    """鏂囨湰浜х墿鍐呭銆備簩杩涘埗/濯掍綋杩斿洖 isBinary=true锛屽墠绔敼鐢?/api/media銆?""
    full = _safe_output_path(path)
    kind = _file_kind(full.name)
    if kind not in ("text",):
        return {"path": path, "content": "", "kind": kind, "isBinary": True}
    try:
        return {"path": path, "content": full.read_text(encoding="utf-8"), "kind": "text", "isBinary": False}
    except UnicodeDecodeError:
        return {"path": path, "content": "", "kind": "binary", "isBinary": True}


@app.get("/api/media/{path:path}")
async def api_media(path: str):
    """鍘熸牱杈撳嚭濯掍綋鏂囦欢锛堝浘鐗?瑙嗛/闊抽/HTML/PDF锛夛紝渚?<img>/<video>/iframe/涓嬭浇銆?""
    full = _safe_output_path(path)
    # HTML 棰勮浼氬湪鏈湴琚氨鍦伴噸鏂扮敓鎴愶紙濡?gzh-design 閲嶆帓/鍐呰仈鍥剧墖锛夛紝蹇呴』绂佺紦瀛橈紝
    # 鍚﹀垯娴忚鍣?浠ｇ悊鎸夊惎鍙戝紡缂撳瓨鏃х増 鈫?鍐呭搴?iframe 鎵撳紑鐨勬槸杩囨湡棰勮锛堝鍒剁矘璐村甫鏃у浘 URL锛夈€?
    headers = ({"Cache-Control": "no-cache, no-store, must-revalidate", "Pragma": "no-cache"}
               if full.suffix.lower() in {".html", ".htm"} else {})
    return FileResponse(full, headers=headers)


# 绯荤粺鏁版嵁鐩綍/鏂囦欢鈥斺€斾笉鍏佽浠庡唴瀹瑰簱鍒犻櫎锛堝垹浜嗕細涓㈢櫥褰曟€?鏃ュ巻/鍙戝竷璁板綍锛?
PROTECTED_OUTPUTS = {"_login", "_analytics", "_schedule.json", "_ideas.json",
                     "_publish", "_publish.log"}
UPLOAD_EXTS = IMAGE_EXTS | VIDEO_EXTS | {
    ".pdf", ".txt", ".md", ".markdown", ".csv", ".json", ".srt", ".vtt",
    ".docx", ".doc", ".xlsx", ".xls", ".pptx", ".ppt", ".mp3", ".wav", ".m4a"}
MAX_UPLOAD_MB = 50


def _unique_upload_path(dest: Path, filename: str) -> Path:
    """鍚屼竴涓婁紶鎵规鍐呬繚鐣欐墍鏈夊悓鍚嶆枃浠讹紝涓嶈鍚庝竴涓潤榛樿鐩栧墠涓€涓€?""
    target = dest / filename
    if not target.exists():
        return target
    source = Path(filename)
    index = 2
    while True:
        target = dest / f"{source.stem} ({index}){source.suffix}"
        if not target.exists():
            return target
        index += 1


def _safe_output_target(rel: str, *, must_exist: bool = True) -> Path:
    """瑙ｆ瀽鍒?outputs/ 鍐呯殑鏂囦欢鎴栫洰褰曪紙闃茬┛瓒婏級銆備笌 _safe_output_path 涓嶅悓锛氬厑璁哥洰褰曘€?
    鍙姹備笉蹇呭凡瀛樺湪锛堜笂浼犳柊鏂囦欢鏃讹級銆傛案杩滄嫆缁?outputs/ 鏍规湰韬€?""
    full = (outputs_dir() / rel).resolve()
    root = outputs_dir().resolve()
    if full == root or root not in full.parents:
        raise HTTPException(403, '闈炴硶璺緞')
    if must_exist and not full.exists():
        raise HTTPException(404, '涓嶅瓨鍦?)
    return full


def _is_protected(full: Path) -> bool:
    """璺緞鐨勯《灞傛鏄惁灞炰簬鍙椾繚鎶ょ殑绯荤粺椤广€?""
    try:
        rel = full.relative_to(outputs_dir().resolve())
    except ValueError:
        return True
    return bool(rel.parts) and rel.parts[0] in PROTECTED_OUTPUTS


@app.delete("/api/output/{path:path}")
async def api_output_delete(path: str):
    """鍒犻櫎鍐呭搴撻噷鐨勫崟涓枃浠舵垨鏁翠釜椤圭洰鐩綍銆傜郴缁熸暟鎹紙_login/_analytics/鏃ュ巻/鍙戝竷璁板綍锛夊彈淇濇姢銆?""
    full = _safe_output_target(path)
    if _is_protected(full):
        raise HTTPException(403, '绯荤粺鏁版嵁鍙椾繚鎶わ紝涓嶅彲浠庡唴瀹瑰簱鍒犻櫎')
    if _effective_perm(full) == 'ro':
        raise HTTPException(403, '鏂囦欢澶逛负鍙锛屼笉鑳藉垹闄わ紱璇峰厛璁句负鍙啓')
    is_dir = full.is_dir()
    try:
        if is_dir:
            shutil.rmtree(full)
        else:
            full.unlink()
    except OSError as e:
        raise HTTPException(500, f'鍒犻櫎澶辫触锛歿e}')
    return {"ok": True, "deleted": path, "kind": "dir" if is_dir else "file"}


@app.post("/api/upload")
async def api_upload(
    files: list[UploadFile] = File(...),
    sessionId: str = Form(...),
):
    """Store chat attachments in a session-scoped inbox and return opaque refs."""
    scope = _attachment_scope(sessionId)
    batch = time.strftime('%Y%m%d-') + uuid.uuid4().hex[:6]
    dest = outputs_dir() / "_inbox" / scope / batch
    dest.mkdir(parents=True, exist_ok=True)
    saved = []
    for f in files:
        name = Path(f.filename or "file").name
        ext = Path(name).suffix.lower()
        if ext not in UPLOAD_EXTS:
            raise HTTPException(400, f'涓嶆敮鎸佺殑鏂囦欢绫诲瀷锛歿ext or name}')
        data = await f.read()
        if len(data) > MAX_UPLOAD_MB * 1024 * 1024:
            raise HTTPException(413, f'{name} 瓒呰繃 {MAX_UPLOAD_MB}MB 涓婇檺')
        target = _unique_upload_path(dest, name)
        target.write_bytes(data)
        rel = f"_inbox/{scope}/{batch}/{target.name}"
        saved.append({"id": _attachment_id(scope, rel), "name": target.name, "path": rel})
    if not saved:
        raise HTTPException(400, '娌℃湁鏂囦欢')
    return {"ok": True, "files": saved}


@app.get("/api/upload/limits")
async def api_upload_limits():
    """褰撳墠涓婁紶涓婇檺锛圡B锛夆€斺€斿墠绔湪鏂囦欢瓒呴檺鏃舵嵁姝ゅ垏鎹㈠埌鏈湴澶嶅埗閫氶亾锟?"""
    return {"ok": True, "max_mb": MAX_UPLOAD_MB}


@app.post("/api/outputs/import")
async def api_outputs_import(
    files: list[UploadFile] = File(...),
    dir: str = Form(""),
):
    """鎶婃湰鍦版枃浠跺鍏ュ唴瀹瑰簱銆俤ir 涓虹┖鈫掑湪鍐呭搴撴牴鐩綍鏂板缓銆屽鍏?鏃堕棿銆嶉」鐩€?""
    if not files:
        raise HTTPException(400, '娌℃湁鏂囦欢')
    rel = (dir or '').strip().strip('/\\')
    if rel:
        dest = _safe_output_target(rel, must_exist=False)
        if _is_protected(dest):
            raise HTTPException(403, '绯荤粺鏁版嵁鍙椾繚鎶わ紝涓嶈兘瀵煎叆鍒拌鐩綍')
        if dest.exists() and not dest.is_dir():
            raise HTTPException(400, '鐩爣涓嶆槸鏂囦欢澶?)
        if dest.exists() and _effective_perm(dest) == 'ro':
            raise HTTPException(403, '鏂囦欢澶逛负鍙锛屼笉鑳藉鍏?)
        if not dest.exists() and _effective_perm(dest.parent) == 'ro':
            raise HTTPException(403, '涓婄骇鏂囦欢澶逛负鍙锛屼笉鑳藉鍏?)
        dest.mkdir(parents=True, exist_ok=True)
    else:
        base = f"瀵煎叆-{time.strftime('%Y%m%d-%H%M%S')}"
        dest = outputs_dir() / base
        n = 2
        while dest.exists():
            dest = outputs_dir() / f"{base}-{n}"
            n += 1
        dest.mkdir(parents=True)
        rel = dest.name
    saved = []
    for f in files:
        name = Path(f.filename or 'file').name
        if not name or name in ('.', '..'):
            continue
        ext = Path(name).suffix.lower()
        if ext not in UPLOAD_EXTS:
            raise HTTPException(400, f'涓嶆敮鎸佺殑鏂囦欢绫诲瀷锛歿ext or name}')
        target = _unique_upload_path(dest, name)
        with open(target, 'wb') as out:
            while True:
                chunk = await f.read(1024 * 1024)
                if not chunk:
                    break
                out.write(chunk)
        saved.append({"name": target.name, "path": f"{rel}/{target.name}"})
    if not saved:
        raise HTTPException(400, '娌℃湁鏂囦欢')
    return {"ok": True, "dir": rel, "files": saved}


@app.post("/api/outputs/meta")
async def api_outputs_meta(payload: dict = Body(...)):
    """缂栬緫鏂囦欢澶规爣棰?/ 鏉冮檺銆傛潈闄?rw=鍙啓銆乺o=鍙锛堝悜涓嬬户鎵匡級銆?""
    rel = str(payload.get("path") or "").strip().strip('/\\')
    full = _safe_output_target(rel)
    if not full.is_dir():
        raise HTTPException(400, '鐩爣涓嶆槸鏂囦欢澶?)
    if _is_protected(full):
        raise HTTPException(403, '绯荤粺鏁版嵁鍙椾繚鎶?)
    title = payload.get("title", None)
    perm = payload.get("perm", None)
    if perm is not None:
        if perm not in ("rw", "ro"):
            raise HTTPException(400, '鏉冮檺鍙兘鏄?rw 鎴?ro')
        # 鍙鏂囦欢澶硅嚜韬彲浠ヨВ閿侊紱浣嗕笂绾у彧璇绘椂涓嶅厑璁告敼锛岄伩鍏嶇粫杩囩户鎵?
        if _effective_perm(full.parent) == 'ro':
            raise HTTPException(403, '涓婄骇鏂囦欢澶逛负鍙锛岃鍏堣В閿佷笂绾?)
    if title is not None:
        if _effective_perm(full) == 'ro':
            raise HTTPException(403, '鍙鏂囦欢澶逛笉鑳芥敼鏍囬锛岃鍏堣涓哄彲鍐?)
        title = str(title).strip()
        if len(title) > 120:
            raise HTTPException(400, '鏍囬鏈€澶?120 涓瓧绗?)
    mf = full / ".easel.json"
    data: dict = {}
    if mf.is_file():
        try:
            old = json.loads(mf.read_text(encoding="utf-8"))
            if isinstance(old, dict):
                data = old
        except Exception:
            data = {}
    if title is not None:
        if title:
            data["title"] = title
        else:
            data.pop("title", None)
    if perm is not None:
        data["perm"] = perm
    tmp = full / ".easel.json.tmp"
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
    tmp.replace(mf)
    return {"ok": True, "title": data.get("title", ""), "perm": data.get("perm", "rw")}


README_TEXT_EXTS = {
    ".md", ".markdown", ".txt", ".json", ".csv", ".yaml", ".yml",
    ".py", ".ts", ".tsx", ".js", ".jsx", ".html", ".css", ".srt", ".vtt",
}


README_IMAGE_EXTS = {".jpg", ".jpeg", ".png", ".webp", ".bmp"}
README_OCR_CACHE = ".readme-ocr.json"


def _natural_key(path: Path) -> list:
    return [int(x) if x.isdigit() else x.lower() for x in re.split(r"(\d+)", path.as_posix())]


def _ocr_texts(full: Path, files: list[Path]) -> dict[str, str]:
    cache_path = full / README_OCR_CACHE
    cache: dict = {}
    if cache_path.is_file():
        try:
            old = json.loads(cache_path.read_text(encoding="utf-8"))
            if isinstance(old, dict):
                cache = old
        except Exception:
            cache = {}
    out: dict[str, str] = {}
    try:
        from PIL import Image
        import numpy as np
        from rapidocr_onnxruntime import RapidOCR
    except Exception:
        return out
    engine = None
    changed = False
    for c in files:
        if c.suffix.lower() not in README_IMAGE_EXTS:
            continue
        try:
            st = c.stat()
        except OSError:
            continue
        relp = c.relative_to(full).as_posix()
        hit = cache.get(relp)
        if (isinstance(hit, dict) and hit.get("mtime") == int(st.st_mtime)
                and hit.get("size") == st.st_size and isinstance(hit.get("text"), str)):
            out[relp] = hit["text"]
            continue
        text = ""
        try:
            if engine is None:
                engine = RapidOCR()
            with Image.open(c) as im:
                im = im.convert("RGB")
                w, h = im.size
                if max(w, h) > 1600:
                    scale = 1600 / max(w, h)
                    im = im.resize((max(1, int(w * scale)), max(1, int(h * scale))), Image.LANCZOS)
                arr = np.array(im)
            res, _ = engine(arr)
            text = "\n".join(str(x[1]) for x in (res or []) if len(x) > 1)
        except Exception:
            text = ""
        out[relp] = text
        cache[relp] = {"mtime": int(st.st_mtime), "size": st.st_size, "text": text}
        changed = True
    if changed:
        try:
            tmp = full / ".readme-ocr.tmp"
            tmp.write_text(json.dumps(cache, ensure_ascii=False), encoding="utf-8")
            tmp.replace(cache_path)
        except OSError:
            pass
    return out


README_VISION_CACHE = ".readme-vision.json"


def _vision_summaries(full: Path, files: list[Path]) -> dict[str, dict]:
    """閫愬紶鎶婂浘鐗囦氦缁?deepseek-flash 瑙嗚妯″瀷锛岃繑鍥炴瘡涓枃浠剁殑 type/summary銆?""
    images = [c for c in files if c.suffix.lower() in README_IMAGE_EXTS]
    if not images:
        return {}
    cache_path = full / README_VISION_CACHE
    cache: dict = {}
    if cache_path.is_file():
        try:
            old = json.loads(cache_path.read_text(encoding="utf-8"))
            if isinstance(old, dict):
                cache = old
        except Exception:
            cache = {}
    try:
        oc = json.loads((Path.home() / ".openclaw-easel" / "openclaw.json").read_text(encoding="utf-8"))
        prov = oc["models"]["providers"]["deepseek"]
        base = str(prov.get("baseUrl") or "").rstrip("/")
        key = str(prov.get("apiKey") or "")
        model = str((prov.get("models") or [{}])[0].get("id") or "deepseek-flash")
    except Exception:
        return {}
    if not base or not key:
        return {}
    import base64
    import io
    import urllib.request
    from concurrent.futures import ThreadPoolExecutor
    from PIL import Image

    prompt = ("鐪嬭繖寮犲够鐏墖锛屽彧杈撳嚭涓€琛?JSON锛?
              "{\"type\":\"灏侀潰/鐩綍/绔犺妭椤?鍥捐〃/鐣岄潰/鍙傛暟琛?鍏朵粬\",\"summary\":\"鐢?-3鍙ヨ瘽璇存槑杩欎竴椤电殑鍏蜂綋鍐呭锛屼繚鐣欏叧閿爣棰樺拰鏁板瓧锛涗笉瑕佸啓鍥剧墖/绱犳潗/鐣ワ紱涓嶇‘瀹氫笉瑕佺紪閫燶"}銆?
              "涓嶈杈撳嚭 JSON 浠ュ鐨勫唴瀹广€?)

    def one(c: Path):
        try:
            st = c.stat()
        except OSError:
            return None
        relp = c.relative_to(full).as_posix()
        hit = cache.get(relp)
        if (isinstance(hit, dict) and hit.get("mtime") == int(st.st_mtime)
                and hit.get("size") == st.st_size and hit.get("summary")):
            return relp, str(hit.get("type") or "鍏朵粬"), str(hit.get("summary") or ""), False
        try:
            with Image.open(c) as im:
                im = im.convert("RGB")
                w, h = im.size
                if max(w, h) > 1280:
                    sc = 1280 / max(w, h)
                    im = im.resize((max(1, int(w * sc)), max(1, int(h * sc))), Image.LANCZOS)
                buf = io.BytesIO()
                im.save(buf, format="JPEG", quality=85)
            b64 = base64.b64encode(buf.getvalue()).decode()
            body = {"model": model, "max_tokens": 6000, "temperature": 0.1,
                    "messages": [{"role": "user", "content": [
                        {"type": "text", "text": prompt},
                        {"type": "image_url", "image_url": {"url": "data:image/jpeg;base64," + b64}},
                    ]}]}
            req = urllib.request.Request(base + "/chat/completions",
                                         data=json.dumps(body).encode("utf-8"), method="POST")
            req.add_header("Content-Type", "application/json")
            req.add_header("Authorization", "Bearer " + key)
            with urllib.request.urlopen(req, timeout=180) as r:
                data = json.loads(r.read().decode("utf-8"))
            content = str((data.get("choices") or [{}])[0].get("message", {}).get("content") or "").strip()
            content = re.sub(r"^```(?:json)?\s*", "", content, flags=re.IGNORECASE)
            content = re.sub(r"\s*```$", "", content)
            a, b = content.find("{"), content.rfind("}")
            obj = json.loads(content[a:b + 1]) if a >= 0 and b > a else {}
            typ = str(obj.get("type") or "鍏朵粬").strip()
            summary = str(obj.get("summary") or "").strip()
            return relp, typ, summary, True
        except Exception:
            return relp, "鍏朵粬", "", True

    results = []
    with ThreadPoolExecutor(max_workers=3) as pool:
        for item in pool.map(one, images):
            if item:
                results.append(item)
    for relp, typ, summary, changed in results:
        if changed:
            try:
                st = (full / relp).stat()
            except OSError:
                continue
            cache[relp] = {"mtime": int(st.st_mtime), "size": st.st_size, "type": typ, "summary": summary}
    try:
        if results:
            tmp = full / ".readme-vision.tmp"
            tmp.write_text(json.dumps(cache, ensure_ascii=False), encoding="utf-8")
            tmp.replace(cache_path)
    except OSError:
        pass
    return {relp: {"type": typ, "summary": summary} for relp, typ, summary, _ in results if summary}


def _readme_context(full: Path, rel: str) -> str:
    title, _ = _read_folder_settings(full)
    all_files: list[Path] = []
    for c in full.rglob("*"):
        if c.is_file() and not c.name.startswith("."):
            all_files.append(c)
        if len(all_files) >= 500:
            break
    all_files.sort(key=lambda c: _natural_key(c.relative_to(full)))
    vision = _vision_summaries(full, all_files)
    lines = [f"鏂囦欢澶癸細{title or full.name}", f"鐩稿璺緞锛歿rel}",
             f"鏂囦欢鎬绘暟锛歿len(all_files)}锛堣繖鏄畬鏁存竻鍗曪紝涓嶆槸鎴彇锛屼笉瑕佸啓鎴愰儴鍒嗭級",
             "鏂囦欢娓呭崟锛堟寜鏂囦欢鍚嶄腑鐨勬暟瀛楄嚜鐒舵帓搴忥級锛?]
    for c in all_files:
        try:
            size = c.stat().st_size
        except OSError:
            size = 0
        lines.append(f"- {c.relative_to(full).as_posix()} ({size} bytes)")
    lines.append("\n閫愭枃浠跺唴瀹癸紙鍥剧墖涓鸿瑙夎瘑鍒紝鍙兘鏈夐敊瀛楋紱娌℃湁璇嗗埆鍒版枃瀛楀氨鍐欐湭璇嗗埆锛夛細")
    for c in all_files:
        relp = c.relative_to(full).as_posix()
        suffix = c.suffix.lower()
        if suffix in README_IMAGE_EXTS:
            v = vision.get(relp, {})
            text = str(v.get("summary") or "")
            excerpt = " / ".join(x.strip() for x in text.splitlines() if x.strip())[:400]
            vtype = str(v.get("type") or "")
            lines.append(f"- {relp}: {('[' + vtype + '] ') if vtype else ''}{excerpt or '锛堣瑙夎瘑鍒け璐ワ級'}")
        elif suffix in README_TEXT_EXTS and c.name != "README.md":
            try:
                text = c.read_text(encoding="utf-8", errors="replace")[:500]
            except OSError:
                text = ""
            excerpt = " / ".join(x.strip() for x in text.splitlines() if x.strip())[:400]
            lines.append(f"- {relp}: {excerpt or '锛堢┖鏂囦欢锛?}")
    readme = full / "README.md"
    if readme.is_file():
        try:
            old = readme.read_text(encoding="utf-8", errors="replace")[:5000]
            if old.strip():
                lines.append("\n鐜版湁 README.md锛堝彲鑳藉寘鍚敊璇紝渚嬪鎶婂畬鏁存竻鍗曞啓鎴?0涓?閮ㄥ垎锛涗互鏂囦欢娓呭崟鍜岃瑙夎瘑鍒负鍑嗭紝涓嶈淇濈暀閿欒鏁伴噺鎴栭儴鍒嗚〃杩帮級锛?)
                lines.append(old)
        except OSError:
            pass
    return "\n".join(lines)


def _readme_prompt(full: Path, rel: str) -> str:
    context = _readme_context(full, rel)
    title, _ = _read_folder_settings(full)
    return f"""浣犳槸鑷獟浣撳唴瀹瑰簱鐨勮鏄庢枃妗ｅ姪鎵嬨€傝涓轰笅闈㈢殑鏂囦欢澶圭敓鎴愪竴浠藉畬鏁淬€佸彲鎵ц鐨?README.md锛屼緵鍥㈤槦鎴愬憳鍜?AI 鍔╂墜浣跨敤銆?

纭€ц姹傦細
1. 鍙緭鍑?Markdown 姝ｆ枃锛屼笉瑕佽В閲娿€佸墠瑷€銆佷唬鐮佸洿鏍忋€佸伐鍏疯皟鐢ㄣ€?
2. 浠ャ€? {title or full.name}銆嶄负鏍囬锛岃嚦灏戝寘鍚細鐢ㄩ€斻€佹枃浠舵€昏銆侀€愭枃浠惰鏄庛€佷娇鐢ㄦ柟寮忋€佺粰 AI 鐨勮鏄庛€?
3. 鏂囦欢娓呭崟鏄畬鏁寸殑锛屼笉瑕佸啓鈥滄渶澶氭樉绀?0涓€濃€滈儴鍒嗏€濃€滄埅鏂€濃€滆鐩?-112涓殑涓€閮ㄥ垎鈥濈瓑閿欒琛ㄨ堪锛涙暟閲忎互鏂囦欢鎬绘暟涓哄噯銆?
4. 閫愭枃浠惰鏄庡繀椤昏鐩栨竻鍗曚腑鐨勬瘡涓€涓枃浠讹細姣忎釜鏂囦欢鍗曠嫭涓€琛屾垨琛ㄦ牸涓€琛岋紝鍐欐竻璇ラ〉/璇ユ枃浠剁殑鍏蜂綋鍐呭銆備笉寰楃敤鈥滃浘鐗囩礌鏉愨€濃€滃唴瀹光€濃€滅暐鈥濃€滄湭璇存槑鈥濈瓑娉涙硾琛ㄨ堪浠ｆ浛銆?
5. 鍥剧墖鍐呭浠ヨ瑙夎瘑鍒憳瑕佷负渚濇嵁锛涙湁鎽樿灏辨鎷椤碉紝涓嶈缂栭€犳憳瑕佷腑娌℃湁鐨勪俊鎭紱鎽樿涓虹┖灏卞啓鈥滄湰椤佃瑙夎瘑鍒け璐モ€濓紝骞惰鏄庢槸鍥剧墖椤点€?
6. 鏂囦欢鍚嶆寜鏁板瓧椤哄簭鐞嗚В锛堝够鐏墖2 鍦?骞荤伅鐗?0 涔嬪墠锛夛紱寮曠敤鍏蜂綋椤甸潰鏃朵娇鐢ㄥ師濮嬫枃浠跺悕銆?
7. 鐜版湁 README 浠呬緵鍙傝€冿紱濡傛灉涓庢枃浠舵竻鍗?瑙嗚璇嗗埆鍐茬獊锛屼互鏂囦欢娓呭崟/瑙嗚璇嗗埆涓哄噯銆?

鏂囦欢澶规潗鏂欙細
{context}"""


def _generate_readme_sync(full: Path, rel: str) -> str:
    prompt = _readme_prompt(full, rel)
    workspace = Path.home() / ".openclaw-easel" / "workspace"
    try:
        workspace.mkdir(parents=True, exist_ok=True)
    except OSError:
        workspace = Path.home()
    pf = workspace / f"readme-prompt-{uuid.uuid4().hex}.md"
    pf.write_text(prompt, encoding="utf-8")
    msg = (f"Read the UTF-8 Markdown file at {pf} and follow its instructions exactly. "
           "It contains the task and folder context. Output ONLY the README.md Markdown body. "
           "Do not call other tools, do not write files, do not explain.")
    try:
        return run_agent_sync(msg, 300)
    finally:
        try:
            pf.unlink()
        except OSError:
            pass


def _clean_readme_output(raw: str) -> str:
    s = (raw or "").strip()
    s = re.sub(r"^```(?:markdown|md)?\s*", "", s, flags=re.IGNORECASE)
    s = re.sub(r"\s*```$", "", s)
    idx = s.find("\n# ")
    if idx > 0:
        s = s[idx + 1:]
    return s.strip()


@app.post("/api/outputs/readme/generate")
async def api_outputs_readme_generate(payload: dict = Body(...)):
    rel = str(payload.get("path") or "").strip().strip('/\\')
    full = _safe_output_target(rel)
    if not full.is_dir():
        raise HTTPException(400, '鐩爣涓嶆槸鏂囦欢澶?)
    if _is_protected(full):
        raise HTTPException(403, '绯荤粺鏁版嵁鍙椾繚鎶?)
    if _effective_perm(full) == 'ro':
        raise HTTPException(403, '鍙鏂囦欢澶逛笉鑳界敓鎴愯鏄庯紝璇峰厛璁句负鍙啓')
    loop = asyncio.get_running_loop()
    try:
        raw = await loop.run_in_executor(None, _generate_readme_sync, full, rel)
    except Exception as e:
        raise HTTPException(502, f'AI 鐢熸垚澶辫触锛歿e}')
    text = _clean_readme_output(raw)
    if not text or text.startswith('?') or '瓒呮椂' in text[:30]:
        raise HTTPException(502, text or 'AI 娌℃湁杩斿洖鍐呭')
    return {"ok": True, "content": text}


@app.get("/api/outputs/readme")
async def api_outputs_readme(path: str = ""):
    """璇诲彇鏂囦欢澶瑰唴鐨?README.md锛堢粰 AI 闃呰鐨勬枃浠跺す璇存槑锛夈€?""
    rel = (path or "").strip().strip('/\\')
    full = _safe_output_target(rel)
    if not full.is_dir():
        raise HTTPException(400, '鐩爣涓嶆槸鏂囦欢澶?)
    f = full / "README.md"
    if not f.is_file():
        return {"ok": True, "exists": False, "content": ""}
    try:
        return {"ok": True, "exists": True, "content": f.read_text(encoding="utf-8")}
    except Exception as e:
        raise HTTPException(500, f'璇诲彇璇存槑澶辫触锛歿e}')


@app.post("/api/outputs/readme")
async def api_outputs_readme_save(payload: dict = Body(...)):
    """淇濆瓨鏂囦欢澶瑰唴鐨?README.md銆?""
    rel = str(payload.get("path") or "").strip().strip('/\\')
    full = _safe_output_target(rel)
    if not full.is_dir():
        raise HTTPException(400, '鐩爣涓嶆槸鏂囦欢澶?)
    if _is_protected(full):
        raise HTTPException(403, '绯荤粺鏁版嵁鍙椾繚鎶?)
    if _effective_perm(full) == 'ro':
        raise HTTPException(403, '鍙鏂囦欢澶逛笉鑳藉啓璇存槑锛岃鍏堣涓哄彲鍐?)
    content = payload.get("content")
    if not isinstance(content, str):
        raise HTTPException(400, '璇存槑鍐呭蹇呴』鏄枃鏈?)
    if len(content) > 200_000:
        raise HTTPException(413, '璇存槑鏈€澶?200KB')
    f = full / "README.md"
    tmp = full / ".README.md.tmp"
    tmp.write_text(content, encoding="utf-8")
    tmp.replace(f)
    return {"ok": True, "path": f"{rel}/README.md"}


@app.post("/api/upload/local")
async def api_upload_local(
    files: list[UploadFile] = File(...),
    sessionId: str = Form(...),
):
    """瓒呰繃涓婁紶涓婇檺鐨勬枃浠跺鍒堕€氶亾锛?MB 鍒嗗潡娴佸紡钀界洏锛堜笉鏁磋杩涘唴瀛橈級銆佹棤澶у皬涓婇檺锛?
    浜у嚭涓?/api/upload 鍚屾瀯鐨勯檮浠跺紩鐢紙id/name/path锛夛紝闄勪欢鏍￠獙涓庢竻鍗曢摼璺浂鏀瑰姩銆?""
    scope = _attachment_scope(sessionId)
    batch = time.strftime('%Y%m%d-') + uuid.uuid4().hex[:6]
    dest = outputs_dir() / "_inbox" / scope / batch
    dest.mkdir(parents=True, exist_ok=True)
    saved = []
    for f in files:
        name = Path(f.filename or "file").name
        ext = Path(name).suffix.lower()
        if ext not in UPLOAD_EXTS:
            raise HTTPException(400, f'涓嶆敮鎸佺殑鏂囦欢绫诲瀷锛歿ext or name}')
        target = _unique_upload_path(dest, name)
        with open(target, 'wb') as out:
            while True:
                chunk = await f.read(1024 * 1024)
                if not chunk:
                    break
                out.write(chunk)
        rel = f"_inbox/{scope}/{batch}/{target.name}"
        saved.append({"id": _attachment_id(scope, rel), "name": target.name, "path": rel})
    if not saved:
        raise HTTPException(400, '娌℃湁鏂囦欢')
    return {"ok": True, "files": saved}


def _write_login_marker(platform: str, state: str, message: str = '') -> None:
    """鍥炲啓鐧诲綍鏍囪 outputs/_login/<骞冲彴>.json锛堜笌 login_state.write_status 鍚屾牸寮忥紝鍘熷瓙鍐欙級銆?
    whoami 鐪熸牎楠岀‘璁ゅ凡鐧诲綍鍚庤皟鐢?鈫?_account_logged_in 鐨勫揩閫熻矾寰勬鍚庤嚜鎰堝苟鎸佷箙銆?""
    login_dir().mkdir(parents=True, exist_ok=True)
    data = {"state": state, "message": message, "qr": "", "ts": int(time.time())}
    st = login_dir() / f'{platform}.json'
    tmp = st.with_suffix('.json.tmp')
    try:
        tmp.write_text(json.dumps(data, ensure_ascii=False), encoding='utf-8')
        os.replace(tmp, st)
    except OSError:
        try:
            tmp.unlink()
        except OSError:
            pass


def _account_logged_in(platform: str, cfg: dict) -> bool:
    """灏藉姏鍒ゆ柇鏌愬钩鍙版槸鍚﹀凡鐧诲綍銆?
    娴忚鍣ㄥ钩鍙扮殑鐧诲綍鎬佸彧鏈夊惎鍔ㄦ祻瑙堝櫒鎵嶇湡鑳界煡閬擄紙profile 閲屾€绘湁 Cookies 鏂囦欢锛屽瓨鍦ㄢ墵宸茬櫥褰曪紝
    浼氳鎶ワ級锛屾晠杩欓噷鍙俊銆屾湰娴佺▼鏈€杩戜竴娆＄櫥褰曟垚鍔熴€嶁€斺€斿嵆 status.json == success銆?
    biliup 鐨?cookies.json 鍙湁鐧诲綍鎴愬姛鎵嶇敓鎴愶紝鍙洿鎺ュ垽銆?""
    backend = cfg['backend']
    if backend == 'unsupported':
        return False
    if backend == 'biliup':
        return (PROJECT_ROOT / 'cookies.json').is_file()
    if backend == 'wechat-oa':
        # 鍙戝竷+鏁版嵁閮借蛋銆屽悗鍙颁細璇濄€嶁啋 浠?mp 鍚庡彴鐧诲綍鎴愬姛涓哄噯锛汚ppID 鍑瘉浣滀负鍏滃簳锛堟棫閰嶇疆锛?
        try:
            if _mp_login_status().get('state') == 'success':
                return True
        except Exception:
            pass
        return _wechat_has_credentials()
    if backend == 'cms':
        return _cms_has(platform)
    st = login_dir() / f'{platform}.json'
    if st.is_file():
        try:
            return json.loads(st.read_text(encoding="utf-8")).get('state') == 'success'
        except Exception:
            return False
    return False


def _login_status(platform: str) -> dict:
    """璇荤櫥褰曠姸鎬佹枃浠?+ 浜岀淮鐮佹槸鍚﹀氨缁€?""
    st = login_dir() / f'{platform}.json'
    data = {'state': 'unknown', 'message': ''}
    if st.is_file():
        try:
            d = json.loads(st.read_text(encoding="utf-8"))
            data = {'state': d.get('state', 'unknown'), 'message': d.get('message', '')}
        except Exception:
            pass
    # A runner that exits before writing its status must become an actionable error,
    # never the ambiguous ``unknown`` state shown as an endless spinner in the UI.
    proc = LOGIN_PROCESSES.get(platform)
    if data['state'] in ('unknown', 'starting') and proc is not None:
        code = proc.poll()
        if code is not None:
            data = {'state': 'error', 'message': f'鐧诲綍绋嬪簭寮傚父閫€鍑猴紙閫€鍑虹爜 {code}锛夛紝璇锋煡鐪?outputs/_login/{platform}.log'}
    qr = login_dir() / f'{platform}.png'
    if qr.is_file():
        data['qr'] = f'_login/{platform}.png'
        try:
            data['qrTs'] = int(qr.stat().st_mtime)   # 浜岀淮鐮?mtime 浣滅紦瀛橀敭锛氱爜姣忓埛鏂颁竴娆″氨鍙橈紝鍓嶇 img 闅忎箣鍒锋柊
        except OSError:
            data['qrTs'] = 0
    else:
        data['qr'] = ''
        data['qrTs'] = 0
    return data


@app.get("/api/accounts")
async def api_accounts():
    return [
        {'platform': pf, 'name': cfg['name'], 'backend': cfg['backend'],
         'supported': cfg['backend'] != 'unsupported',
         'loggedIn': _account_logged_in(pf, cfg),
         'note': cfg.get('note', '')}
        for pf, cfg in LOGIN_RUNNERS.items()
    ]


@app.post("/api/login/{platform}")
async def api_login_start(platform: str):
    """鍚姩鏌愬钩鍙扮櫥褰曪細娴忚鍣ㄥ钩鍙板悗鍙拌窇 QR runner锛岃疆璇㈠埌浜岀淮鐮佸氨缁嵆杩斿洖銆?""
    cfg = LOGIN_RUNNERS.get(platform)
    if not cfg:
        raise HTTPException(404, '鏈煡骞冲彴')
    backend = cfg['backend']
    if backend == 'unsupported':
        raise HTTPException(400, f"{cfg['name']} 鏆備笉鍙敤锛歿cfg.get('note', '')}")
    if backend == 'wechat-oa':
        # 鍏紬鍙蜂笉璧版壂鐮侊細鍓嶇搴旀敼鐢ㄥ嚟璇佽〃鍗曟彁浜ゅ埌 /api/accounts/{platform}/credentials銆?
        return {'mode': 'credentials', 'configured': _wechat_has_credentials(),
                'message': '寰俊鍏紬鍙疯濉啓 AppID / AppSecret'}
    if backend == 'cms':
        return {'mode': 'credentials', 'configured': _cms_has(platform),
                'message': '璇峰～鍐欑珯鐐瑰湴鍧€ / 鐢ㄦ埛鍚?/ 瀵嗙爜'}
    login_dir().mkdir(parents=True, exist_ok=True)
    qr = login_dir() / f'{platform}.png'
    status = login_dir() / f'{platform}.json'
    for f in (qr, status):
        try:
            f.unlink()
        except OSError:
            pass
    if backend == 'xhs':
        cmd = [sys.executable, str(SHARED_SCRIPTS / 'xhs_publish.py'), 'login', '--no-proxy',
               '--qr-out', str(qr), '--status-file', str(status), '--timeout', str(LOGIN_TIMEOUT)]
    elif backend == 'biliup':
        # B绔欙細TV 绔壂鐮佺櫥褰?API 鐢熸垚浜岀淮鐮?+ 鍐?biliup cookie锛坆iliup login 闇€鐪熺粓绔紝鍓嶇鐢ㄤ笉浜嗭級
        cmd = [sys.executable, str(SHARED_SCRIPTS / 'bili_login.py'), 'login',
               '--qr-out', str(qr), '--status-file', str(status),
               '--cookie', str(PROJECT_ROOT / 'cookies.json'), '--timeout', str(LOGIN_TIMEOUT)]
    elif backend == 'douyin':
        code_file = login_dir() / f'{platform}.code'
        try:
            code_file.unlink()
        except OSError:
            pass
        cmd = [sys.executable, str(SHARED_SCRIPTS / 'douyin_publish.py'), 'login',
               '--qr-out', str(qr), '--status-file', str(status),
               '--sms-code-file', str(code_file), '--timeout', str(LOGIN_TIMEOUT)]
    else:
        cmd = [sys.executable, str(SHARED_SCRIPTS / 'web_publisher.py'), 'login-qr',
               '--platform', cfg['wp'], '--qr-out', str(qr), '--status-file', str(status),
               '--timeout', str(LOGIN_TIMEOUT)]
    # 鏂扮櫥褰曞紑濮?鈫?娓呮帀鏃х殑 whoami 缂撳瓨锛堢櫥褰曞墠鍙兘缂撳瓨浜嗐€屾湭鐧诲綍銆嶏級锛岄伩鍏嶇櫥褰曟垚鍔熷悗浠嶈鍒版棫缁撴灉
    with _WHOAMI_LOCK:
        _WHOAMI_CACHE.pop(platform, None)
    log_path = login_dir() / f'{platform}.log'
    log_file = log_path.open('a', encoding='utf-8')
    proc = subprocess.Popen(cmd, cwd=str(PROJECT_ROOT), env=_proxy_env(),
                            stdout=log_file, stderr=subprocess.STDOUT)
    log_file.close()
    LOGIN_PROCESSES[platform] = proc
    for _ in range(50):
        await asyncio.sleep(0.5)
        s = _login_status(platform)
        if s['qr'] or s['state'] in ('qr_ready', 'success', 'error', 'expired'):
            return {'mode': 'qr', **s}
    s = _login_status(platform)
    return {'mode': 'qr', **s}


@app.get("/api/login/{platform}/status")
async def api_login_status(platform: str):
    if platform not in LOGIN_RUNNERS:
        raise HTTPException(404, '鏈煡骞冲彴')
    s = _login_status(platform)
    if s.get('state') == 'success':
        # 鐧诲綍鍒氭垚鍔?鈫?娓呮帀鐧诲綍鍓嶇紦瀛樼殑銆屾湭鐧诲綍銆峸hoami 缁撴灉锛屼护涓嬫 whoami 閲嶆柊鐪熸牎楠岋紱
        # 鍚﹀垯鍗＄墖浼氬洜 WHOAMI_TTL(600s) 鍐呯殑鏃?false 鎸佺画鏄剧ず銆屾湭鐧诲綍銆嶏紙鏈瑙嗛鍙烽棶棰樼殑鏍瑰洜锛夈€?
        # 鍙竻缂撳瓨銆佷笉鏀逛换浣曠櫥褰?妫€娴嬮€昏緫銆?
        with _WHOAMI_LOCK:
            _WHOAMI_CACHE.pop(platform, None)
    return {'mode': 'qr', **s}


class SmsCodeRequest(BaseModel):
    code: str


@app.post("/api/login/{platform}/sms")
async def api_login_sms(platform: str, req: SmsCodeRequest):
    """鍥炲～鐭俊楠岃瘉鐮侊細鍐欏叆 runner 杞鐨勪竴娆℃€ч獙璇佺爜鏂囦欢锛堣 login_state.read_sms_code锛夈€?

    鐧诲綍 runner 妫€娴嬪埌椋庢帶鐭俊澧欐椂鎶婄姸鎬佺疆 sms_required锛屽墠绔脊杈撳叆妗嗭紝鐢ㄦ埛鎶婃墜鏈?
    鏀跺埌鐨勯獙璇佺爜鎻愪氦鍒拌繖閲岋紝runner 璇昏蛋鍚庡～鐮佹彁浜わ紝缁х画瀹屾垚鐧诲綍銆?
    """
    if platform not in LOGIN_RUNNERS:
        raise HTTPException(404, '鏈煡骞冲彴')
    code = ''.join(ch for ch in (req.code or '') if ch.isdigit())
    if not (4 <= len(code) <= 8):
        raise HTTPException(400, '楠岃瘉鐮佸簲涓?4-8 浣嶆暟瀛?)
    login_dir().mkdir(parents=True, exist_ok=True)
    (login_dir() / f'{platform}.code').write_text(code, encoding='utf-8')
    return {'ok': True}


class WechatCredentials(BaseModel):
    appId: str = ''
    appSecret: str = ''
    name: str = ''
    author: str = ''


@app.get("/api/accounts/{platform}/credentials")
async def api_get_credentials(platform: str):
    """璇诲彇鍑瘉寮忓钩鍙帮紙鐩墠浠呭叕浼楀彿锛夌殑宸查厤缃姸鎬侊紙AppID 鑴辨晱锛孉ppSecret 涓嶅洖浼狅級銆?""
    cfg = LOGIN_RUNNERS.get(platform)
    if not cfg or cfg.get('backend') != 'wechat-oa':
        raise HTTPException(404, '璇ュ钩鍙颁笉浣跨敤鍑瘉鐧诲綍')
    acc = _wechat_web_account()
    app_id = acc.get('app_id', '') or ''
    return {
        'configured': bool(app_id and acc.get('app_secret')),
        'appIdMasked': (app_id[:6] + '***' + app_id[-4:]) if len(app_id) > 10 else ('***' if app_id else ''),
        'name': acc.get('name', '') or '',
        'author': acc.get('author', '') or '',
    }


@app.post("/api/accounts/{platform}/credentials")
async def api_save_credentials(platform: str, req: WechatCredentials):
    """淇濆瓨鍑瘉寮忓钩鍙帮紙鍏紬鍙凤級鐨?AppID/AppSecret锛屽啓鍏?skill 閰嶇疆骞惰皟瀹樻柟鎺ュ彛楠岃瘉銆?""
    cfg = LOGIN_RUNNERS.get(platform)
    if not cfg or cfg.get('backend') != 'wechat-oa':
        raise HTTPException(404, '璇ュ钩鍙颁笉浣跨敤鍑瘉鐧诲綍')
    app_id = (req.appId or '').strip()
    app_secret = (req.appSecret or '').strip()
    if not app_id or not app_secret:
        raise HTTPException(400, 'AppID 鍜?AppSecret 閮戒笉鑳戒负绌?)
    _wechat_save_credentials(app_id, app_secret, name=req.name.strip(), author=req.author.strip())
    ok, msg = _wechat_verify_token()
    with _WHOAMI_LOCK:
        _WHOAMI_CACHE.pop(platform, None)
    if ok:
        _write_login_marker(platform, 'success', req.name.strip() or '寰俊鍏紬鍙?)
        return {'ok': True, 'message': '鍏紬鍙峰嚟璇佸凡淇濆瓨骞堕獙璇侀€氳繃'}
    # 鏍￠獙澶辫触锛氬嚟璇佸凡瀛橈紙涓嬫鏀规鍚庡彲鐩存帴閲嶈瘯锛夛紝浣嗘槑纭憡鐭ュけ璐ュ師鍥狅紙甯歌 40164 IP 鐧藉悕鍗?/ 40125 瀵嗛挜閿欒锛?
    return {'ok': False, 'message': f'鍑瘉宸蹭繚瀛樹絾楠岃瘉鏈€氳繃锛歿msg}銆傝嫢鏄?40164 璇锋妸鏈嶅姟鍣ㄥ嚭鍙?IP 鍔犲叆鍏紬鍙?IP 鐧藉悕鍗曘€?}


class CmsCredentials(BaseModel):
    siteUrl: str = ''
    username: str = ''
    secret: str = ''
    name: str = ''


@app.get("/api/accounts/{platform}/cms-credentials")
async def api_get_cms_credentials(platform: str):
    cfg = LOGIN_RUNNERS.get(platform)
    if not cfg or cfg.get('backend') != 'cms':
        raise HTTPException(404, '璇ュ钩鍙颁笉鏄嚜寤虹珯')
    a = _cms_get(platform)
    return {'configured': _cms_has(platform), 'siteUrl': a.get('siteUrl', ''),
            'username': a.get('username', ''), 'name': a.get('name', '')}


@app.post("/api/accounts/{platform}/cms-credentials")
async def api_save_cms_credentials(platform: str, req: CmsCredentials):
    cfg = LOGIN_RUNNERS.get(platform)
    if not cfg or cfg.get('backend') != 'cms':
        raise HTTPException(404, '璇ュ钩鍙颁笉鏄嚜寤虹珯')
    site = _cms_norm_url(req.siteUrl)
    user = (req.username or '').strip()
    secret = (req.secret or '').strip()
    if not site or not user or not secret:
        raise HTTPException(400, '绔欑偣鍦板潃銆佺敤鎴峰悕銆佸瘑鐮侀兘涓嶈兘涓虹┖')
    acc = {'siteUrl': site, 'username': user, 'secret': secret, 'name': (req.name or '').strip()}
    _cms_save(platform, acc)
    ok, msg = await asyncio.to_thread(_cms_verify, platform, acc)
    with _WHOAMI_LOCK:
        _WHOAMI_CACHE.pop(platform, None)
    if ok:
        _write_login_marker(platform, 'success', acc['name'] or user)
        return {'ok': True, 'message': msg}
    return {'ok': False, 'message': f'鍑瘉宸蹭繚瀛樹絾楠岃瘉鏈€氳繃锛歿msg}'}


def _mp_login_status() -> dict:
    """璇诲叕浼楀彿鍚庡彴(mp)鐧诲綍鐘舵€?+ 浜岀淮鐮侊紙鏂囦欢鐢?weixin_mp_stats.py login 鍐欙級銆?""
    st = login_dir() / "wechat-oa-mp.json"
    data = {"state": "unknown", "message": ""}
    if st.is_file():
        try:
            d = json.loads(st.read_text(encoding="utf-8"))
            data = {"state": d.get("state", "unknown"), "message": d.get("message", "")}
        except Exception:
            pass
    proc = LOGIN_PROCESSES.get("wechat-oa-mp")
    if data["state"] in ("unknown", "starting") and proc is not None and proc.poll() is not None:
        data = {"state": "error", "message": f"鐧诲綍绋嬪簭閫€鍑猴紙鐮?{proc.poll()}锛夛紝瑙?outputs/_login/wechat-oa-mp.log"}
    qr = login_dir() / "wechat-oa-mp.png"
    if qr.is_file():
        data["qr"] = "_login/wechat-oa-mp.png"
        try:
            data["qrTs"] = int(qr.stat().st_mtime)
        except OSError:
            data["qrTs"] = 0
    else:
        data["qr"] = ""
        data["qrTs"] = 0
    return data


def _stop_mp_login_on_shutdown() -> None:
    """姝ｅ父閲嶅惎 Web 鏃跺洖鏀舵壂鐮佽繘绋嬶紝閬垮厤瀹冪户缁啓鍏ヤ笅涓€娆＄櫥褰曠殑鐘舵€併€?""
    proc = LOGIN_PROCESSES.pop("wechat-oa-mp", None)
    if proc is not None and proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=5)
        _write_login_marker("wechat-oa-mp", "expired", "鏈嶅姟宸查噸鍚紝璇烽噸鏂版壂鐮佺櫥褰?)


@app.post("/api/accounts/{platform}/mp-login")
async def api_mp_login_start(platform: str):
    """鍚姩銆屽叕浼楀彿鍚庡彴銆嶆壂鐮佺櫥褰曪紙鏁版嵁涓績鍙栨暟鐢紝绠＄悊鍛樼骇浼氳瘽锛岀嫭绔嬩簬 AppID 鍑瘉锛夈€?
    榛樿鐩磋繛璧?Playwright 鍑轰簩缁寸爜锛涘彈闄愮綉缁滃彲璁?EASEL_PROXY / https_proxy 璧版鍚戜唬鐞嗐€?""
    cfg = LOGIN_RUNNERS.get(platform)
    if not cfg or cfg.get("backend") != "wechat-oa":
        raise HTTPException(404, "璇ュ钩鍙颁笉浣跨敤鍏紬鍙峰悗鍙扮櫥褰?)
    # 閲嶅鐐瑰嚮澶嶇敤姝ｅ湪杩涜鐨勭櫥褰曪紝涓嶈兘鍒犻櫎鍏朵簩缁寸爜鎴栧惎鍔ㄧ浜屼釜 Chromium銆?
    proc = LOGIN_PROCESSES.get("wechat-oa-mp")
    if proc is not None and proc.poll() is None:
        return {"mode": "qr", **_mp_login_status()}
    login_dir().mkdir(parents=True, exist_ok=True)
    for f in (login_dir() / "wechat-oa-mp.png", login_dir() / "wechat-oa-mp.json"):
        try:
            f.unlink()
        except OSError:
            pass
    wx_proxy = os.environ.get("EASEL_PROXY") or os.environ.get("https_proxy") or ""
    cmd = [sys.executable, str(SHARED_SCRIPTS / "weixin_mp_stats.py"), "login", "--headed",
           "--proxy", wx_proxy, "--qr-out", str(login_dir() / "wechat-oa-mp.png"),
           "--status-file", str(login_dir() / "wechat-oa-mp.json"), "--timeout", "240"]
    log_file = (login_dir() / "wechat-oa-mp.log").open("a", encoding="utf-8")
    proc = subprocess.Popen(cmd, cwd=str(PROJECT_ROOT), env=_proxy_env(),
                            stdout=log_file, stderr=subprocess.STDOUT)
    log_file.close()
    LOGIN_PROCESSES["wechat-oa-mp"] = proc
    for _ in range(60):
        await asyncio.sleep(0.5)
        s = _mp_login_status()
        if s["qr"] or s["state"] in ("qr_ready", "success", "error", "expired"):
            return {"mode": "qr", **s}
    return {"mode": "qr", **_mp_login_status()}


@app.get("/api/accounts/{platform}/mp-login/status")
async def api_mp_login_status(platform: str):
    cfg = LOGIN_RUNNERS.get(platform)
    if not cfg or cfg.get("backend") != "wechat-oa":
        raise HTTPException(404, "璇ュ钩鍙颁笉浣跨敤鍏紬鍙峰悗鍙扮櫥褰?)
    return {"mode": "qr", **_mp_login_status()}


@app.get("/api/accounts/{platform}/whoami")
async def api_account_whoami(platform: str):
    """鐪熸牎楠岀櫥褰曟€?+ 璇绘樀绉?澶村儚锛堣捣 headless 娴忚鍣紝鏁扮锛夈€傚墠绔紑椤靛悗鍙拌皟鐢ㄤ互鑷剤鍋囬槼鎬с€?
    甯?TTL 杩涚▼鍐呯紦瀛橈紙閬垮厤璐﹀彿椤?宸ヤ綔鍙伴噸澶嶈捣娴忚鍣級锛涚‘璁ゅ凡鐧诲綍鍒欏洖鍐欐爣璁帮紝浠ゅ揩閫熻矾寰勮嚜鎰堛€?""
    cfg = LOGIN_RUNNERS.get(platform)
    if not cfg:
        raise HTTPException(404, '鏈煡骞冲彴')
    backend = cfg['backend']
    if backend == 'unsupported':
        return {'loggedIn': False, 'name': '', 'avatar': ''}
    if backend == 'wechat-oa':
        # 涓嶈捣娴忚鍣細浠?mp 鍚庡彴浼氳瘽/AppID 閰嶇疆鍒ゆ柇锛堣 _account_logged_in锛夛紝鍚嶅瓧鍙栭厤缃处鍙峰悕
        acc = _wechat_web_account()
        return {'loggedIn': _account_logged_in(platform, cfg),
                'name': acc.get('name', '') or '寰俊鍏紬鍙?, 'avatar': ''}
    if backend == 'cms':
        a = _cms_get(platform)
        return {'loggedIn': _cms_has(platform),
                'name': a.get('name') or a.get('username') or cfg['name'], 'avatar': ''}
    # 鍛戒腑鏈繃鏈熺紦瀛樼洿鎺ヨ繑鍥?
    with _WHOAMI_LOCK:
        hit = _WHOAMI_CACHE.get(platform)
    if hit and (time.time() - hit[0]) < WHOAMI_TTL:
        return hit[1]
    if backend == 'biliup':
        cmd = [sys.executable, str(SHARED_SCRIPTS / 'bili_login.py'), 'whoami',
               '--cookie', str(PROJECT_ROOT / 'cookies.json')]
    elif backend == 'xhs':
        cmd = [sys.executable, str(SHARED_SCRIPTS / 'xhs_publish.py'), 'whoami', '--no-proxy']
    elif backend == 'douyin':
        cmd = [sys.executable, str(SHARED_SCRIPTS / 'douyin_publish.py'), 'whoami']
    else:
        cmd = [sys.executable, str(SHARED_SCRIPTS / 'web_publisher.py'), 'whoami',
               '--platform', cfg['wp']]
    try:
        proc = await asyncio.to_thread(subprocess.run, cmd, cwd=str(PROJECT_ROOT), env=_proxy_env(),
                                       capture_output=True, text=True, timeout=150)
    except subprocess.TimeoutExpired:
        raise HTTPException(504, '鏍￠獙瓒呮椂锛堟祻瑙堝櫒璧蜂笉鏉ユ垨缃戠粶鎱級')
    data = {'loggedIn': False, 'name': '', 'avatar': ''}
    confident = False   # 鏄惁鎷垮埌銆屽彲淇°€嶆牎楠岀粨璁猴紙瀛愯繘绋嬫甯歌窇鍑?JSON 涓旀棤 error 瀛楁锛?
    for line in reversed((proc.stdout or '').strip().splitlines()):
        line = line.strip()
        if line.startswith('{'):
            try:
                d = json.loads(line)
                data = {'loggedIn': bool(d.get('loggedIn')), 'name': d.get('name') or '', 'avatar': d.get('avatar') or ''}
                # 鏈?error 瀛楁 = 鏍￠獙鏈韩澶辫触锛堟祻瑙堝櫒璧蜂笉鏉?缃戠粶鎶栧姩/宕╂簝锛夛紝涓嶆槸鍙俊鐨勩€屾湭鐧诲綍銆嶇粨璁?
                confident = not d.get('error')
                break
            except Exception:
                continue
    if not confident:
        # 鏍￠獙澶辫触/鏃犳湁鏁堣緭鍑?鈫?**涓嶇紦瀛樸€佷笉鍒犳爣璁?*锛岃繑鍥炪€屼笂娆″凡鐭ャ€嶇櫥褰曟€侊紙璇绘爣璁帮級銆?
        # 閬垮厤涓€娆℃牎楠屾姈鍔ㄥ氨鎶婂凡鐧诲綍鍗＄墖缈绘垚銆屾湭鐧诲綍銆嶅苟缂撳瓨 10 鍒嗛挓锛涗笅娆℃牎楠?缂撳瓨鏈啓)浼氳嚜鍔ㄩ噸璇曟仮澶嶃€?
        return {'loggedIn': _account_logged_in(platform, cfg), 'name': '', 'avatar': ''}
    with _WHOAMI_LOCK:
        _WHOAMI_CACHE[platform] = (time.time(), data)
    # 鍥炲啓鏍囪锛氱‘璁ゅ凡鐧诲綍 鈫?蹇€熻矾寰勶紙/api/accounts銆?api/analytics/platforms锛夋鍚庝篃姝ｇ‘锛?
    # biliup 璧?cookies.json 鍒ゅ畾锛屼笉鐢ㄦ爣璁版枃浠躲€?
    if backend != 'biliup':
        if data['loggedIn']:
            _write_login_marker(platform, 'success', data.get('name') or '')
        else:
            try:
                (login_dir() / f'{platform}.json').unlink()
            except OSError:
                pass
    return data


@app.post("/api/logout/{platform}")
async def api_logout(platform: str):
    """閫€鍑虹櫥褰曪細鍒犳寔涔呭寲娴忚鍣?profile + 鐧诲綍鐘舵€?浜岀淮鐮?澶村儚鏂囦欢锛坆iliup 鍒?cookies.json锛夈€?""
    cfg = LOGIN_RUNNERS.get(platform)
    if not cfg:
        raise HTTPException(404, '鏈煡骞冲彴')
    deleted = []
    if cfg['backend'] == 'wechat-oa':
        # 1) 娓?AppID 鍑瘉锛堟棫閰嶇疆鍏滃簳锛?
        _wechat_clear_credentials()
        deleted.append('wechat-publisher.yaml:accounts.web')
        # 2) 鍋滄帀鍙兘浠嶅湪璺戠殑鍚庡彴鐧诲綍杩涚▼锛堥伩鍏嶅畠鍙堝啓鍥?success 鏍囪锛?
        proc = LOGIN_PROCESSES.pop('wechat-oa-mp', None)
        if proc is not None and proc.poll() is None:
            try:
                proc.terminate()
            except Exception:
                pass
        # 3) 鍒?AppID 鏍囪 + mp 鍚庡彴浼氳瘽鏍囪/浜岀淮鐮?鏃ュ織锛堢櫥褰曟€佸垽瀹氱湅鐨勫氨鏄?wechat-oa-mp.json锛?
        for name in (f'{platform}.json', f'{platform}.png',
                     'wechat-oa-mp.json', 'wechat-oa-mp.png', 'wechat-oa-mp.log'):
            f = login_dir() / name
            try:
                if f.is_file():
                    f.unlink()
                    deleted.append(f.name)
            except OSError:
                pass
        # 4) 鍒?mp 鍚庡彴娴忚鍣ㄦ寔涔呭寲浼氳瘽锛堢湡姝ｉ€€鍑虹櫥褰曪級
        mpdir = (BROWSER_PROFILES / 'WeixinMpProfile').resolve()
        if BROWSER_PROFILES.resolve() in mpdir.parents and mpdir.is_dir():
            shutil.rmtree(mpdir, ignore_errors=True)
            deleted.append('WeixinMpProfile')
        with _WHOAMI_LOCK:
            _WHOAMI_CACHE.pop(platform, None)
        return {'ok': True, 'deleted': deleted}
    prof_name = cfg.get('profile')
    if prof_name:
        pdir = (BROWSER_PROFILES / prof_name).resolve()
        if BROWSER_PROFILES.resolve() in pdir.parents and pdir.is_dir():
            shutil.rmtree(pdir, ignore_errors=True)
            deleted.append(prof_name)
    if cfg['backend'] == 'biliup':
        ck = PROJECT_ROOT / 'cookies.json'
        if ck.is_file():
            ck.unlink()
            deleted.append('cookies.json')
    for suffix in ('.json', '.png', '-me.png', '.code'):
        f = login_dir() / f'{platform}{suffix}'
        try:
            if f.is_file():
                f.unlink()
                deleted.append(f.name)
        except OSError:
            pass
    with _WHOAMI_LOCK:
        _WHOAMI_CACHE.pop(platform, None)
    return {'ok': True, 'deleted': deleted}


# 褰掑洜灞傦細鍙姄鍒涗綔鏁版嵁鐨勫钩鍙帮紙澶氭暟璧?Playwright 鐧诲綍鎬侊紱bilibili 鐢?biliup cookies 涓嶈捣娴忚鍣ㄣ€?
# wechat-oa 璧?mp 鍚庡彴浼氳瘽 Playwright 鎷︽埅鏁版嵁 XHR锛?
ANALYTICS_PLATFORMS = {"xiaohongshu", "douyin", "kuaishou", "zhihu", "weixin-channels", "bilibili", "wechat-oa"}


@app.get("/api/analytics/platforms")
async def api_analytics_platforms():
    """鍒楀嚭鏀寔鎶撴暟鎹殑骞冲彴 + 鍚勮嚜鐧诲綍鎬侊紙鍓嶇鎹娓叉煋骞冲彴閫夋嫨鍣級銆?""
    return [
        {"platform": pf, "name": LOGIN_RUNNERS.get(pf, {}).get("name", pf),
         "loggedIn": _account_logged_in(pf, LOGIN_RUNNERS.get(pf, {}))}
        for pf in LOGIN_RUNNERS if pf in ANALYTICS_PLATFORMS
    ]


@app.get("/api/analytics/{platform}")
async def api_analytics(platform: str):
    """鎶撳彇鏌愬钩鍙板凡鐧诲綍璐﹀彿鐨勫垱浣滄暟鎹紙绮変笣/鑾疯禐/浣滃搧 + 涓庝笂娆″揩鐓х殑澧為暱锛夈€傝捣 headless 娴忚鍣紝鏁扮銆?""
    if platform not in ANALYTICS_PLATFORMS:
        raise HTTPException(404, "璇ュ钩鍙版殏涓嶆敮鎸佹暟鎹姄鍙?)
    # B绔欑敤 cookie 璋?API锛堟棤娴忚鍣?profile锛夈€佸叕浼楀彿璧?mp 鍚庡彴浼氳瘽锛圥laywright 鎷︽埅鏁版嵁 XHR锛岃涓嬶級锛屽崟鐙垎鏀紱鍏朵綑璧?account_stats锛圥laywright锛?
    if platform == "bilibili":
        cmd = [sys.executable, str(SHARED_SCRIPTS / "bili_login.py"), "stats",
               "--cookie", str(PROJECT_ROOT / "cookies.json")]
    elif platform == "wechat-oa":
        # 鍏紬鍙锋暟鎹蛋銆屽悗鍙扮綉椤电銆?mp.weixin.qq.com 绠＄悊鍛樹細璇?+ Playwright 鎷︽埅鏁版嵁 XHR)锛?
        # 寮€鍙戣€?datacube 鎺ュ彛闇€璁よ瘉+缇ゅ彂+鎺ュ彛鏉冮檺锛屽鏁板彿鍙栦笉鍒帮紱鍚庡彴绔湁鐧诲綍鎬佸嵆鍙湅鍒板彂琛ㄨ褰?鏁版嵁銆?
        # 闇€鍏堟壂鐮佺櫥褰?mp 鍚庡彴锛坵eixin_mp_stats.py login锛夛紱榛樿鐩磋繛锛屽彈闄愮綉缁滄墠闇€ EASEL_PROXY/https_proxy銆?
        wx_proxy = os.environ.get("EASEL_PROXY") or os.environ.get("https_proxy") or ""
        cmd = [sys.executable, str(SHARED_SCRIPTS / "weixin_mp_stats.py"), "stats",
               "--proxy", wx_proxy, "--count", "20"]
    else:
        # 浠ｇ悊绛栫暐鐢?account_stats.py 鎸夊钩鍙拌嚜瀹氾紙xhs 鐩磋繛銆佸叾瀹冭蛋 env锛夛紝鍚庣鐓у父浼?_proxy_env
        cmd = [sys.executable, str(SHARED_SCRIPTS / "account_stats.py"), "fetch", "--platform", platform]
    ana_env = _proxy_env()
    try:
        proc = await asyncio.to_thread(subprocess.run, cmd, cwd=str(PROJECT_ROOT), env=ana_env,
                                       capture_output=True, text=True, timeout=180)
    except subprocess.TimeoutExpired:
        raise HTTPException(504, "鎶撳彇瓒呮椂锛堟祻瑙堝櫒璧蜂笉鏉ユ垨缃戠粶鎱級")
    for line in reversed((proc.stdout or "").strip().splitlines()):
        line = line.strip()
        if line.startswith("{"):
            try:
                return json.loads(line)
            except Exception:
                continue
    detail = (proc.stderr or "").strip().splitlines()[-1:] or ["鏈彇鍒版暟鎹?]
    raise HTTPException(502, f"鏈彇鍒版暟鎹紙鍙兘鏈櫥褰曟垨骞冲彴鏀圭増锛夛細{detail[0][:120]}")


MEDIA_REQUIRED = {"xiaohongshu", "douyin", "kuaishou", "weixin-channels", "bilibili"}
VIDEO_ONLY_PUBLISH = {"douyin", "weixin-channels", "bilibili"}   # 鍙兘鍙戣棰戠殑骞冲彴


class PublishRequest(BaseModel):
    title: str = ''
    body: str = ''
    media: list[str] = []
    tags: str = ''


def _write_publish_status(status_file: Path, state: str, message: str = '') -> None:
    """鍐欏紓姝ュ彂甯冪姸鎬侊紙涓?login_state 鍚屾牸寮忥級锛屽師瀛愬啓銆?""
    try:
        status_file.parent.mkdir(parents=True, exist_ok=True)
        tmp = status_file.with_suffix('.tmp')
        tmp.write_text(json.dumps({'state': state, 'message': message, 'ts': int(time.time())},
                                  ensure_ascii=False), encoding='utf-8')
        os.replace(tmp, status_file)
    except Exception:
        pass


def _read_publish_status(platform: str) -> dict:
    st = publish_dir() / f'{platform}.json'
    if st.is_file():
        try:
            d = json.loads(st.read_text(encoding='utf-8'))
            return {'state': d.get('state', 'unknown'), 'message': d.get('message', '')}
        except Exception:
            pass
    return {'state': 'unknown', 'message': ''}


def _run_publish_bg(platform: str, cmd: list, title: str, body: str, cfg: dict,
                    status_file: Path, code_file: Path) -> None:
    """鍚庡彴绾跨▼璺戝彂甯冭剼鏈紙鑴氭湰鑷韩鎶?starting/sms_required/verifying/success/error 鍐欒繘 status_file锛夈€?
    缁撴潫鍚庡厹搴曡ˉ鍐欑粓鎬?+ 璁?_publish.log + 鎴愬姛鍒欏洖娴佹帓鏈熴€?""
    ok = False
    out = err = ''
    try:
        proc = subprocess.run(cmd, cwd=str(PROJECT_ROOT), env=_publish_env(),
                              capture_output=True, text=True, timeout=900)
        ok = proc.returncode == 0
        out, err = proc.stdout or '', proc.stderr or ''
    except subprocess.TimeoutExpired:
        err = '鍙戝竷瓒呮椂锛?900s锛?
    except Exception as e:  # noqa: BLE001
        err = f'鍙戝竷杩涚▼寮傚父锛歿e}'
    try:
        with (outputs_dir() / '_publish.log').open('a', encoding='utf-8') as lf:
            lf.write(f"\n===== {time.strftime('%Y-%m-%d %H:%M:%S')} {platform}(async) ok={ok} =====\n")
            lf.write('CMD: ' + ' '.join(cmd) + '\nSTDOUT:\n' + out[-2000:] + '\nSTDERR:\n' + err[-2000:] + '\n')
    except Exception:
        pass
    # 鑴氭湰姝ｅ父浼氬啓缁堟€侊紱寮傚父/瓒呮椂娌″啓鍒版椂鍏滃簳琛ヤ竴涓?
    if _read_publish_status(platform)['state'] not in ('success', 'error'):
        _write_publish_status(status_file, 'success' if ok else 'error',
                              '鍙戝竷鎴愬姛' if ok else ('\n'.join((err or out).strip().splitlines()[-4:]) or '鍙戝竷澶辫触'))
    try:
        code_file.unlink()
    except OSError:
        pass
    if ok:
        try:
            items = _read_schedule()
            items.append({'id': uuid.uuid4().hex[:12], 'title': title,
                          'date': time.strftime('%Y-%m-%d'), 'platform': cfg['name'],
                          'time': time.strftime('%H:%M'), 'status': 'published', 'note': body[:200],
                          'kind': 'content', 'source': 'publish-page'})
            _write_schedule(items)
        except Exception:
            pass


def _start_async_publish(platform: str, cmd: list, title: str, body: str, cfg: dict,
                         status_file: Path, code_file: Path) -> dict:
    """鍚姩寮傛鍙戝竷锛氭竻鏃х爜/鐘舵€?鈫?璧峰悗鍙扮嚎绋?鈫?绔嬪嵆杩斿洖銆傚墠绔疆璇?/api/publish/{p}/status锛?
    閬?sms_required 寮硅緭鍏ユ銆佹彁浜ゅ埌 /api/publish/{p}/sms銆?""
    try:
        code_file.unlink()
    except OSError:
        pass
    _write_publish_status(status_file, 'starting', '鍙戝竷涓€︼紙鑻ヨЕ鍙戦鎺т細瑕佹眰鐭俊楠岃瘉锛?)
    threading.Thread(target=_run_publish_bg,
                     args=(platform, cmd, title, body, cfg, status_file, code_file),
                     daemon=True).start()
    # 鍏抽敭锛?*涓嶈繑鍥?ok:true**鈥斺€旇繖鍙槸銆屽凡鍚姩銆嶇殑搴旂瓟锛岀湡姝ｇ粨鏋滆闈犺疆璇?/status銆?
    # 鑻ヨ繖閲岀粰 ok:true锛屾棫鍓嶇浼氭妸瀹冨綋銆屽凡鍙戝竷銆嶇珛鍒绘樉绀烘垚鍔燂紙鍋囨垚鍔?bug锛岀湡鏈鸿俯杩囷級銆?
    return {'async': True, 'pending': True, 'message': '鍙戝竷宸插惎鍔紝璇风◢鍊欌€?}


@app.get("/api/publish/{platform}/status")
async def api_publish_status(platform: str):
    """杞寮傛鍙戝竷鐘舵€侊細starting/sms_required/verifying/success/error銆?""
    if platform not in LOGIN_RUNNERS:
        raise HTTPException(404, '鏈煡骞冲彴')
    return {'mode': 'publish', **_read_publish_status(platform)}


@app.post("/api/publish/{platform}/sms")
async def api_publish_sms(platform: str, req: SmsCodeRequest):
    """鍙戝竷瑙﹀彂鐭俊澧欐椂鍥炲～楠岃瘉鐮侊紙鍐欏彂甯?runner 杞鐨勪竴娆℃€ч獙璇佺爜鏂囦欢锛夈€?""
    if platform not in LOGIN_RUNNERS:
        raise HTTPException(404, '鏈煡骞冲彴')
    code = ''.join(ch for ch in (req.code or '') if ch.isdigit())
    if not (4 <= len(code) <= 8):
        raise HTTPException(400, '楠岃瘉鐮佸簲涓?4-8 浣嶆暟瀛?)
    publish_dir().mkdir(parents=True, exist_ok=True)
    (publish_dir() / f'{platform}.code').write_text(code, encoding='utf-8')
    return {'ok': True}


@app.post("/api/publish/{platform}")
async def api_publish(platform: str, req: PublishRequest):
    """涓€閿彂甯冿細鍒嗗彂鍒板搴?publisher 鑴氭湰鐪熷彂锛?-exec锛夈€備簩娆＄‘璁ゅ湪鍓嶇銆?""
    cfg = LOGIN_RUNNERS.get(platform)
    if not cfg:
        raise HTTPException(404, '鏈煡骞冲彴')
    backend = cfg['backend']
    if backend == 'unsupported':
        raise HTTPException(400, f"{cfg['name']} 鏆備笉鏀寔涓€閿彂甯?)
    if not req.title.strip() and not req.body.strip():
        raise HTTPException(400, '鏍囬/姝ｆ枃涓嶈兘涓虹┖')
    imgs, vids = [], []
    for rel in req.media or []:
        full = _safe_output_path(rel)
        ext = full.suffix.lower()
        if ext in VIDEO_EXTS:
            vids.append(str(full))
        elif ext in IMAGE_EXTS:
            imgs.append(str(full))
    if platform in MEDIA_REQUIRED and not imgs and not vids:
        raise HTTPException(400, f"{cfg['name']} 闇€闄勫甫鍥剧墖鎴栬棰?)
    if imgs and vids:
        raise HTTPException(400, '鍚屼竴鏉″唴瀹逛笉鑳藉悓鏃跺彂鍥剧墖鍜岃棰戯紝璇蜂簩閫変竴')
    if platform in VIDEO_ONLY_PUBLISH and not vids:
        raise HTTPException(400, f"{cfg['name']} 鍙兘鍙戣棰戯紝璇烽檮甯︿竴涓棰戞枃浠?)
    title = req.title.strip() or req.body.strip()[:20]
    tags = req.tags or ''
    if platform in CMS_PLATFORMS:
        r = await asyncio.to_thread(_cms_publish, platform, title, req.body or '', tags)
        if not r.get('ok'):
            raise HTTPException(400, r.get('message', '鍙戝竷澶辫触'))
        return {'ok': True, 'message': r.get('message', '宸插彂甯?), 'url': r.get('url', '')}
    py = sys.executable
    if platform == 'xiaohongshu':
        base = [py, str(SHARED_SCRIPTS / 'xhs_publish.py')]
        cmd = base + ['publish-video', '--no-proxy', '--video', vids[0]] if vids else base + ['publish', '--no-proxy', '--images', ','.join(imgs)]
        cmd += ['--title', title, '--content', req.body, '--tags', tags, '--exec']
    elif platform == 'bilibili':
        # B绔欐姇绋匡細鐩存帴璋?biliup CLI锛堥渶 cookies.json锛孭ATH 涓婃湁 biliup锛夈€傚繀椤昏棰戯紱
        # tid=36銆岀煡璇嗐€嶏紱B绔欐姇绋垮繀椤烩墺1 鏍囩锛屾棤鍒欏厹搴曘€屾棩甯搞€嶃€?
        bili_tag = tags.replace('#', '').replace('锛?, ',').strip().strip(',') or '鏃ュ父'
        cmd = ['biliup', '-u', str(PROJECT_ROOT / 'cookies.json'), 'upload', vids[0],
               '--title', title[:80], '--tid', '36', '--copyright', '1', '--tag', bili_tag]
        if req.body.strip():
            cmd += ['--desc', req.body[:2000]]
    elif platform == 'douyin':
        base = [py, str(SHARED_SCRIPTS / 'douyin_publish.py')]
        cmd = base + ['publish-video', '--no-proxy', '--video', vids[0]] if vids else base + ['publish', '--no-proxy', '--images', ','.join(imgs)]
        cmd += ['--title', title, '--content', req.body, '--tags', tags, '--exec']
        # 鎶栭煶鍙戝竷鍙兘瑙﹀彂椋庢帶鐭俊澧欌€斺€斿紓姝ヨ窇 + 鐘舵€?楠岃瘉鐮佹枃浠讹紝鍓嶇杞鍒?sms_required 鏃跺脊杈撳叆妗?
        publish_dir().mkdir(parents=True, exist_ok=True)
        status_file = publish_dir() / 'douyin.json'
        code_file = publish_dir() / 'douyin.code'
        cmd += ['--status-file', str(status_file), '--sms-code-file', str(code_file)]
        return _start_async_publish(platform, cmd, title, req.body, cfg, status_file, code_file)
    elif platform == 'wechat-oa':
        # 寰俊鍏紬鍙凤細璧般€屽悗鍙颁細璇濄€嶅彂甯冿紙鍏?AppID/AppSecret銆佸厤 IP 鐧藉悕鍗曪級銆?
        # 姝ｆ枃 MD 鈫?鍏紬鍙?HTML锛坰kill 鎺掔増鍣級鈫?浼氳瘽寤鸿崏绋匡紙weixin_mp_stats.py publish锛屽唴宓屽浘浼?mp CDN锛夈€?
        if _mp_login_status().get('state') != 'success':
            raise HTTPException(400, '鍏紬鍙峰悗鍙版湭鐧诲綍锛氳鍏堝湪璐﹀彿椤电偣銆岀櫥褰曞叕浼楀彿鍚庡彴銆嶆壂鐮?)
        if not imgs:
            raise HTTPException(400, '鍏紬鍙锋枃绔犻渶瑕佷竴寮犲皝闈㈠浘锛岃闄勫甫鑷冲皯涓€寮犲浘鐗?)
        if vids:
            raise HTTPException(400, '鍏紬鍙峰彂鍥炬枃鏂囩珷锛岃闄勫甫灏侀潰/姝ｆ枃鍥剧墖鑰岄潪瑙嗛')
        cover = imgs[0]
        publish_dir().mkdir(parents=True, exist_ok=True)
        stamp = uuid.uuid4().hex[:12]
        md_path = publish_dir() / f'wechat-oa-{stamp}.md'
        html_path = publish_dir() / f'wechat-oa-{stamp}.html'
        body_md = req.body or ''
        extra_imgs = imgs[1:]
        if extra_imgs:
            body_md += "\n\n" + "\n\n".join(f'![]({p})' for p in extra_imgs)
        md_path.write_text(f"# {title}\n\n{body_md}\n", encoding='utf-8')
        conv = subprocess.run([py, str(WECHAT_SKILL_SCRIPTS / 'html_converter.py'),
                               str(md_path), '-o', str(html_path)],
                              cwd=str(PROJECT_ROOT), env=_proxy_env(),
                              capture_output=True, text=True, timeout=60)
        if conv.returncode != 0 or not html_path.is_file():
            raise HTTPException(500, f"鎺掔増澶辫触锛歿(conv.stderr or conv.stdout or '')[-200:]}")
        wx_proxy = os.environ.get('EASEL_PROXY') or os.environ.get('https_proxy') or ''
        cmd = [py, str(SHARED_SCRIPTS / 'weixin_mp_stats.py'), 'publish', '--proxy', wx_proxy,
               '--html', str(html_path), '--cover', cover, '--title', title,
               '--digest', (req.body or '').strip()[:100], '--author', '']
    else:
        cmd = [py, str(SHARED_SCRIPTS / 'web_publisher.py'), 'publish',
               '--platform', cfg['wp'], '--title', title, '--desc', req.body,
               '--tags', tags, '--exec']
        media = vids[0] if vids else (imgs[0] if imgs else None)
        if media:
            cmd += ['--media', media]
    # 鍏紬鍙疯蛋鍚庡彴浼氳瘽锛圥laywright锛岃剼鏈嚜甯?--proxy锛岄粯璁ょ洿杩烇級锛涘叾浣欏钩鍙拌蛋 _publish_env
    pub_env = _proxy_env() if platform == 'wechat-oa' else _publish_env()
    try:
        proc = await asyncio.to_thread(subprocess.run, cmd, cwd=str(PROJECT_ROOT), env=pub_env,
                                       capture_output=True, text=True, timeout=600)
    except subprocess.TimeoutExpired:
        raise HTTPException(504, '鍙戝竷瓒呮椂锛堝獟浣撳鐞嗘參鎴栨祦绋嬪崱浣忥級')
    ok = proc.returncode == 0
    tail = (proc.stderr or proc.stdout or '').strip().splitlines()
    detail = '\n'.join(tail[-8:])
    try:
        with (outputs_dir() / '_publish.log').open('a', encoding='utf-8') as lf:
            lf.write(f"\n===== {time.strftime('%Y-%m-%d %H:%M:%S')} {platform} rc={proc.returncode} ok={ok} =====\n")
            lf.write('CMD: ' + ' '.join(cmd) + '\n')
            lf.write('STDOUT:\n' + (proc.stdout or '')[-2000:] + '\n')
            lf.write('STDERR:\n' + (proc.stderr or '')[-2000:] + '\n')
    except Exception:
        pass
    if ok:
        try:
            items = _read_schedule()
            items.append({'id': uuid.uuid4().hex[:12], 'title': title,
                          'date': time.strftime('%Y-%m-%d'), 'platform': cfg['name'],
                          'time': time.strftime('%H:%M'), 'status': 'published',
                          'note': req.body[:200], 'kind': 'content', 'source': 'publish-page'})
            _write_schedule(items)
        except Exception:
            pass
    return {'ok': ok, 'message': '鍙戝竷鎴愬姛' if ok else '鍙戝竷澶辫触锛堣 detail锛?, 'detail': detail}


class ProfileBuildRequest(BaseModel):
    name: str
    form: dict


@app.post("/api/profile/build")
async def api_profile_build(req: ProfileBuildRequest):
    """棣栨寮曞锛氳〃鍗?鈫?鍐欏熀绾跨敾鍍忥紙纭畾鎬э紝绉掑彲鐢級鈫?**鍚庡彴**璺?agent 鍒嗘瀽绀惧獟閾炬帴澧炲己銆?

    鏀瑰紓姝ワ細绔嬪嵆杩斿洖锛堝熀绾垮凡鍐欍€佺敾鍍忓嵆鍙敤锛夛紝閬垮厤 agent 澧炲己(~2min)闃诲璇锋眰琚?code-server
    浠ｇ悊瓒呮椂鎺愭柇锛堝墠绔浘鍥犳鎶?API 400锛夈€傚墠绔疆璇?/api/profile/build/status/{name} 鐪嬪寮鸿繘搴︺€?
    """
    name = (req.name or '').strip()  # 鑷姩鍘绘帀棣栧熬绌烘牸
    if not name:
        raise HTTPException(400, '鐢诲儚鍚嶄笉鑳戒负绌猴紙鍘绘帀棣栧熬绌烘牸鍚庝负绌猴紝璇疯緭鍏ユ湁鏁堝悕绉帮級')
    if '/' in name or '\\' in name:
        raise HTTPException(400, '鐢诲儚鍚嶄笉鑳藉寘鍚?/ 鎴?\\ 瀛楃锛岃鏀规帀鍚庨噸璇?)
    if name.startswith(('.', '_')):
        raise HTTPException(400, '鐢诲儚鍚嶄笉鑳戒互 . 鎴?_ 寮€澶达紝璇锋崲涓紑澶?)
    pd = profiles_dir() / name
    if pd.exists():
        raise HTTPException(409, f'鐢诲儚銆寋name}銆嶅凡瀛樺湪锛岃鎹竴涓悕瀛?)
    _write_baseline_profile(name, req.form or {})
    instruction = _form_to_instruction(name, req.form or {})
    msg = (f"璇锋墽琛?/skill-profile-builder 瀹屽杽宸插瓨鍦ㄧ殑鐢诲儚銆寋name}銆嶃€傜敤鎴峰凡閫氳繃琛ㄥ崟鎻愪緵浠ヤ笅淇℃伅锛屾垜宸叉寜姝ゅ啓濂?profiles/{name}"
           f"/ 鐨勫熀绾垮叚缁存枃浠躲€傝锛氣憼灏藉姏鎶撳彇鐢ㄦ埛缁欑殑绀惧獟閾炬帴鍒嗘瀽宸插彂鍐呭/椋庢牸/鍙椾紬锛堟姄涓嶅埌灏遍檷绾э紝鏍囨敞[寰呰ˉ鍏匽锛屽嬁鑷嗛€狅級鈶℃嵁鍒嗘瀽缁撴灉娑﹁壊/琛ュ叏鍚勭淮搴︽枃浠?鈶㈢粰鍑轰竴鍙ヨ瘽瀹屾垚搴︽憳瑕併€傝〃鍗曚俊鎭涓嬶細\n\n{instruction}")

    _write_profile_status(name, 'running', 'AI 姝ｅ湪鍒嗘瀽骞跺寮虹敾鍍忊€?)

    def _enhance() -> None:
        try:
            log = run_agent_sync(msg, TIMEOUT_PRODUCE)
            _write_profile_status(name, 'done', log)
        except Exception as e:  # noqa: BLE001
            _write_profile_status(name, 'failed', f'AI 澧炲己澶辫触锛堝熀绾跨敾鍍忓凡鍙敤锛夛細{e}')

    threading.Thread(target=_enhance, daemon=True).start()
    # 鍩虹嚎宸插啓銆佺敾鍍忕珛鍗冲彲鐢紱澧炲己鍦ㄥ悗鍙帮紝鍓嶇杞鐘舵€?
    return {'created': pd.is_dir(), 'name': name, 'async': True, 'status': 'running'}


def _profile_status_file(name: str) -> Path:
    return profile_build_dir() / f'{name}.json'


def _write_profile_status(name: str, state: str, log: str = '') -> None:
    """鍘熷瓙鍐欑敾鍍忓寮虹姸鎬併€?""
    try:
        profile_build_dir().mkdir(parents=True, exist_ok=True)
        f = _profile_status_file(name)
        tmp = f.with_suffix('.tmp')
        tmp.write_text(json.dumps({'state': state, 'log': log, 'ts': int(time.time())},
                                  ensure_ascii=False), encoding='utf-8')
        os.replace(tmp, f)
    except Exception:
        pass


@app.get("/api/profile/build/status/{name}")
async def api_profile_build_status(name: str):
    """鏌ョ敾鍍忓寮鸿繘搴︼細running / done / failed / unknown銆?""
    f = _profile_status_file(name)
    if f.is_file():
        try:
            d = json.loads(f.read_text(encoding='utf-8'))
            return {'state': d.get('state', 'unknown'), 'log': d.get('log', '')}
        except Exception:
            pass
    return {'state': 'unknown', 'log': ''}


def _form_to_instruction(name: str, form: dict) -> str:
    def g(k: str, default: str = '锛堟湭濉級') -> str:
        v = form.get(k)
        if isinstance(v, list):
            return '銆?.join(str(x) for x in v) if v else default
        return str(v).strip() if v not in (None, '') else default
    links = form.get('links') or {}
    links_txt = '\n'.join(f'  - {p}: {u}' for p, u in links.items() if u) or '  锛堟湭鎻愪緵锛?
    return (f"鐢诲儚鍚嶏細{name}\n杩愯惀骞冲彴锛歿g('platforms')}\n璧峰彿鐘舵€侊細{g('accountStage')}"
            f"\n绀惧獟涓婚〉閾炬帴锛歕n{links_txt}\n鎯冲仛鐨勬柟鍚戯細{g('direction')}"
            f"\n涓轰粈涔堝仛/鎴戠殑浼樺娍锛歿g('reason')}\n杩愯惀鐩爣锛歿g('goal')}"
            f"\n鎯充骇鍑虹殑褰㈠紡锛歿g('formats')}\n鍠滄鐪嬬殑鍐呭/瀵规爣璐﹀彿锛歿g('likes')}"
            f"\n鏈熸湜璋冩€э細{g('tone')}\n涓嶅仛鐨勫唴瀹?绾㈢嚎锛歿g('avoid')}\n")


def _write_baseline_profile(name: str, form: dict) -> None:
    """浠庤〃鍗曠‘瀹氭€х敓鎴愬叚缁村熀绾挎枃浠躲€傞摼鎺ユ淳鐢熷瓧娈垫爣 [寰?AI 鍒嗘瀽]銆?""
    pd = profiles_dir() / name
    pd.mkdir(parents=True, exist_ok=True)

    def g(k: str, default: str = '') -> str:
        v = form.get(k)
        if isinstance(v, list):
            return '銆?.join(str(x) for x in v)
        return str(v).strip() if v not in (None, '') else default
    direction = g('direction') or '[寰呰ˉ鍏匽'
    reason = g('reason') or '[寰呰ˉ鍏匽'
    goal = g('goal')
    formats = g('formats')
    tone = g('tone') or '[寰呭垎鏋怾'
    likes = g('likes')
    avoid = g('avoid')
    platforms = form.get('platforms') or []
    links = form.get('links') or {}
    (pd / 'identity.md').write_text(
        f"# 韬唤瀹氫綅\n\n## 鎴戞槸璋乗n\n{direction}\n\n## 宸紓鍖朶n\n{reason}\n\n## 鍐呭鏂瑰悜\n\n{direction}"
        f"{'锛堝舰寮忥細' + formats + '锛? if formats else ''}\n"
        f"{'杩愯惀鐩爣锛? + goal if goal else ''}\n",
        encoding='utf-8')
