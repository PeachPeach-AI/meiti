def _hash_password(password: str, salt: str) -> str:
    return hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), bytes.fromhex(salt), 200_000).hex()


def _load_accounts() -> list[dict]:
    if not ACCOUNTS_FILE.is_file():
        return []
    try:
        d = json.loads(ACCOUNTS_FILE.read_text(encoding="utf-8"))
        return d if isinstance(d, list) else []
    except Exception:  # noqa: BLE001
        return []


def _save_accounts(users: list[dict]) -> None:
    _ensure(ACCOUNTS_FILE.parent)
    tmp = ACCOUNTS_FILE.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(users, ensure_ascii=False, indent=2), encoding="utf-8")
    tmp.replace(ACCOUNTS_FILE)


def _public_user(u: dict) -> dict:
    return {"id": u.get("id", ""), "username": u.get("username", ""),
            "displayName": u.get("displayName") or u.get("username", ""),
            "createdAt": u.get("createdAt", 0)}


def _usk(sk: str) -> str:
    """OpenClaw 浼氳瘽 key 鎸夌敤鎴峰懡鍚嶇┖闂达紝閬垮厤涓嶅悓璐﹀彿涓茶亰澶╁巻鍙层€?""
    uid = CURRENT_UID.get()
    return f"u{uid}:{sk}" if uid else sk


def _migrate_legacy(uid: str) -> None:
    """棣栦釜璐﹀彿鍒涘缓鏃讹紝鎶婃棫鐨勫崟鐢ㄦ埛鏁版嵁澶嶅埗杩涜璐﹀彿鐩綍锛堝彧鍋氫竴娆★級銆?""
    root = _ensure(USERS_DIR / uid)
    marker = root / ".legacy-migrated"
    if marker.exists():
        return
    try:
        src_p = PROJECT_ROOT / "profiles"
        if src_p.is_dir():
            shutil.copytree(src_p, root / "profiles", dirs_exist_ok=True)
        src_o = PROJECT_ROOT / "outputs"
        if src_o.is_dir():
            shutil.copytree(src_o, root / "outputs", dirs_exist_ok=True)
        src_c = PROJECT_ROOT / "cms_accounts.json"
        if src_c.is_file():
            shutil.copy2(src_c, root / "cms_accounts.json")
        marker.write_text("1", encoding="utf-8")
    except Exception as e:  # noqa: BLE001
        print(f"[easel] legacy migration failed: {e}", file=sys.stderr, flush=True)


