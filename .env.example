# ===== 门户 / 端口 =====
# NAS 上请保持 0.0.0.0，局域网设备才能访问
HOST=0.0.0.0
PORT=8080

EASEL_PORT=7866
IMAGE_PORT=7867
VIDEO_PORT=7868
GATEWAY_PORT=18789

# dev | prod（prod 需要先 npm run setup 构建 Next 应用）
SS_MODE=dev

# ===== 模型服务（火山方舟 / OpenAI 兼容）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_MODEL=deepseek-v4-1-flash-260910

# Easel 的图片 / 语音能力（可选）
DASHSCOPE_API_KEY=
IMG_API_KEY=
IMG_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMG_MODEL=

# ===== MediaCrawler =====
# 默认使用仓库内 vendor/MediaCrawler
SS_MC_DIR=
SS_ENGINE=playwright
# NAS / 无桌面环境必须设为 1；Windows 本地想扫码登录可以设为 0
SS_HEADLESS=1
SS_CDP_PORT=9222

# ===== Next 应用后端地址 =====
SCRIPT_FLOW_BACKEND_URL=http://localhost:8000
